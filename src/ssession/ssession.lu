//! member: true
//!
//! burrow.ssession — burrowd's session, as the authenticated user: the
//! connection protocol on one `session` channel (`src/schannel`), and the
//! one program it runs (a command, or the login shell), until the channel
//! closes.
//!
//! **The command** runs as `sshd(8)` describes (LOGIN PROCESS): the user's
//! login shell with `-c` and the command, leading a process group of its own
//! (px112; not yet a session of its own), in the user's home directory, with
//! the environment the caller built (HOME, USER, LOGNAME, SHELL, PATH,
//! MAIL, SSH_CONNECTION, SSH_ORIGINAL_COMMAND under a forced command) and
//! the `env` names the channel accepted. It is a `fork` of this process
//! followed by `exec`, so it holds nothing of burrowd's. Its stdin, stdout
//! and stderr are three pipes; the stdin end is non-blocking, so a command
//! that does not read never stalls the connection, and burrowd's window
//! gives back only what the command has read. When `/etc/nologin` exists
//! the command is not run: its text goes to stderr and the status is 254,
//! as the pinned `sshd`'s session ends (measured; LOGIN PROCESS, step 3;
//! root, who could pass, never logs in).
//!
//! **The shell** (px112; RFC 4254 §6.5 `shell`, sshd(8) LOGIN PROCESS step
//! 9): with no command the user's shell runs as a login shell, `argv[0]`
//! its base name after `-` (`-sh`), no `-c`, its stdin the channel's, with
//! no pty: burrowd has none yet. A forced command (`command=`) runs in its
//! place, as for `exec` (sshd(8): it "applies to shell, command or
//! subsystem execution"), with no SSH_ORIGINAL_COMMAND, there being no
//! command to carry. When the client's `pty-req` was refused, burrowd's
//! first bytes on the session's stderr are one line saying the shell has
//! no terminal (`no_pty_text`); a command after a refused pty gets none,
//! as through `sshd` with `PermitTTY no`.
//!
//! **A pty** (bw06; RFC 4254 §6.2, §6.7): where the channel allows one
//! (`Plan.pty`: `PermitTTY` and the key's options), a `pty-req` is served
//! here: the pty opened (`src/ptyhost`) and sized, SUCCESS; or, the host
//! giving none, FAILURE named `pty_failed`. The program then runs on it: the
//! child leads a session of its own, opens the slave by name (its
//! controlling terminal, its group the foreground), sets the client's modes
//! on it, and has it as stdin, stdout and stderr, with TERM (when the
//! client sent one) and SSH_TTY in its environment. The master is the
//! channel's one stream both ways (no extended data); `window-change` sets
//! its size; the client's EOF is ignored (a pty cannot be half-closed; the
//! client ends input with its EOF character). **The end** is the program's:
//! reaped, the master drained until it ends or stays quiet 20 ms (a child
//! that ignores SIGHUP may still hold the slave), then EOF, the status and
//! CLOSE, and the master closed, which hangs the slave up. Every program,
//! with a pty or without, leads a session of its own once the toolchain
//! has the call (`ptyhost.lead_session`; until then a process group, px112).
//!
//! **Waiting.** wolf-std at the pin has no one wait over a socket and
//! files (wolf-std#134): an idle turn waits up to 5 ms on the socket, then
//! up to 5 ms on the command's pipes and its end (SIGCHLD). A turn that
//! moved bytes waits on neither.
//!
//! **The end** (RFC 4254 §5.3, §6.10): the command's stdout and stderr both
//! at their end, EOF; the command reaped, `exit-status` (or `exit-signal`),
//! then CLOSE; the client's CLOSE answered once. A client that closes
//! first leaves the command to finish on its own.

use std.env
use std.fs
use std.net
use std.process
use std.signal
use pipe
use ptyhost
use refuse
use schannel
use transport

/// What the session runs, and as whom.
pub struct Plan {
    shell: str,
    argv0: str,
    home: str,
    command: str,
    forced: bool,
    env: List[str],
    verbose: int,
    /// bw06: the channel may grant a pty (`PermitTTY` and the key's options).
    pty: bool,
    /// Only the one-process row program: the command's process takes the
    /// account's ids (`set_ids`) before its exec, the session staying root.
    drop: bool,
    uid: int,
    gid: int,
    groups: List[int],
}

/// How the session ended, for the log: `status N`, `signal NAME` or
/// `status -`, the refusals by name, and the refusal that ended the
/// connection (`failure`, "" when the channel closed both ways; the
/// client's DISCONNECT or the socket's end after both CLOSEs is no
/// failure).
pub struct Result {
    status: str,
    refused: List[str],
    failure: str,
}

/// The command's process and pipes.
struct Running {
    child: process.Child,
    running: bool,
    stdin: fs.File,
    stdout: fs.File,
    stderr: fs.File,
    in_open: bool,
    out_eof: bool,
    err_eof: bool,
    status: int,
    /// bw06: a pty was granted; `master` is open until `pty_open` goes
    /// false, and the program's stdin and stdout are it.
    pty: bool,
    pty_open: bool,
    master: fs.File,
    slave: List[byte],
}

fn say(p: Plan, msg: str) {
    if p.verbose > 0 && msg.len > 0 {
        eprint("debug1: {msg}")
    }
}

fn none_running() -> Running {
    Running {
        child: process.Child { slot: -1 },
        running: false,
        stdin: fs.File { fd: -1 },
        stdout: fs.File { fd: -1 },
        stderr: fs.File { fd: -1 },
        in_open: false,
        out_eof: true,
        err_eof: true,
        status: -1,
        pty: false,
        pty_open: false,
        master: fs.File { fd: -1 },
        slave: List[byte](),
    }
}

// The program's environment.
fn program_env(plan: Plan, ch: schannel.Chan) -> List[str] {
    var envs = copy plan.env
    for e in schannel.environment(ch) {
        (mut envs).push(e)
    }
    let asked = str_from_utf8(ch.command) else ""
    if plan.forced && !ch.shell {
        (mut envs).push("SSH_ORIGINAL_COMMAND={asked}")
    }
    envs
}

// The program's argv: the login shell (`-sh`) with no forced command, else
// `sh -c` and the forced or the client's command. A forced command runs
// for a shell request too, never the shell.
fn program_argv(plan: Plan, ch: schannel.Chan) -> List[str] {
    let asked = str_from_utf8(ch.command) else ""
    let login = ch.shell && !plan.forced
    let command = if plan.forced then plan.command else asked
    var argv = List[str]()
    if login {
        (mut argv).push("-{plan.argv0}")
    } else {
        (mut argv).push(plan.argv0)
        (mut argv).push("-c")
        (mut argv).push(command)
    }
    argv
}

// bw06: the program on the pty `tty` holds: a session of its own, the
// slave its controlling terminal and its stdin, stdout and stderr.
fn start_on_pty(plan: Plan, ch: schannel.Chan, tty: Running) -> Running ! refuse.Refusal {
    var envs = program_env(plan, ch)
    let term = schannel.term_name(ch)
    if term != "" {
        (mut envs).push("TERM={term}")
    }
    let slave = str_from_utf8(tty.slave) else { return io }
    (mut envs).push("SSH_TTY={slave}")
    let argv = program_argv(plan, ch)
    let f = process.fork() else { return io }
    if process.is_child(f) {
        var m = copy tty.master
        fs.close(take m) else {}
        ptyhost.lead_session() else {}
        signal.reset(signal.broken_pipe()) else {}
        // The open makes the slave this session's controlling terminal (the
        // runtime's opens pass no O_NOCTTY), and its group the foreground.
        var s = fs.open_mode(slave, 3) else {
            process.exit(1)
            fs.File { fd: -1 }
        }
        ptyhost.set_modes(s, ch.modes) else {}
        if plan.drop {
            process.set_ids(plan.uid, plan.gid, plan.groups) else {
                process.exit(1)
            }
        }
        env.set_cwd(plan.home) else {
            fs.write(
                mut s,
                "Could not chdir to home directory {plan.home}: No such file or directory\n",
            ) else {}
            env.set_cwd("/") else {}
        }
        var c = process.from_argv(argv)
        process.set_stdin(mut c, copy s)
        process.set_stdout(mut c, copy s)
        process.set_stderr(mut c, copy s)
        os_exec(plan.shell, c.argv, envs, c.fds) else {}
        fs.write(mut s, "{plan.shell}: cannot be executed\n") else {}
        process.exit(1)
    }
    var m = copy tty.master
    fs.set_nonblock(mut m, true) else {}
    Running {
        child: copy f.child,
        running: true,
        stdin: copy m,
        stdout: copy m,
        stderr: fs.File { fd: -1 },
        in_open: true,
        out_eof: false,
        err_eof: true,
        status: -1,
        pty: true,
        pty_open: true,
        master: copy m,
        slave: copy tty.slave,
    }
}

// The command's process, forked and exec'd with its three pipes, or on the
// session's pty.
fn start_command(plan: Plan, ch: schannel.Chan, tty: Running) -> Running ! refuse.Refusal {
    if tty.pty {
        return start_on_pty(plan, ch, tty)
    }
    let pin = process.pipe() else { return io }
    let pout = process.pipe() else { return io }
    let perr = process.pipe() else { return io }
    let envs = program_env(plan, ch)
    let argv = program_argv(plan, ch)
    let f = process.fork() else { return io }
    if process.is_child(f) {
        var errf = copy perr.write
        // px112: the program leads a process group of its own, so a
        // job-control stop it draws (a terminal it touches from the
        // background) stops it alone, never burrowd. bw06: a session of its
        // own, with no controlling terminal, once the toolchain has the call.
        ptyhost.lead_session() else {}
        signal.reset(signal.broken_pipe()) else {}
        if plan.drop {
            process.set_ids(plan.uid, plan.gid, plan.groups) else {
                process.exit(1)
            }
        }
        env.set_cwd(plan.home) else {
            fs.write(
                mut errf,
                "Could not chdir to home directory {plan.home}: No such file or directory\n",
            ) else {}
            env.set_cwd("/") else {}
        }
        var c = process.from_argv(argv)
        process.set_stdin(mut c, copy pin.read)
        process.set_stdout(mut c, copy pout.write)
        process.set_stderr(mut c, copy perr.write)
        os_exec(plan.shell, c.argv, envs, c.fds) else {}
        fs.write(mut errf, "{plan.shell}: cannot be executed\n") else {}
        process.exit(1)
    }
    var r = copy pin.read
    fs.close(take r) else {}
    var w1 = copy pout.write
    fs.close(take w1) else {}
    var w2 = copy perr.write
    fs.close(take w2) else {}
    var w = copy pin.write
    fs.set_nonblock(mut w, true) else {}
    Running {
        child: copy f.child,
        running: true,
        stdin: w,
        stdout: copy pout.read,
        stderr: copy perr.read,
        in_open: true,
        out_eof: false,
        err_eof: false,
        status: -1,
        pty: false,
        pty_open: false,
        master: fs.File { fd: -1 },
        slave: List[byte](),
    }
}

fn sock_ready(c: transport.Conn, ms: int) -> bool ! refuse.Refusal {
    if transport.buffered(c) {
        return true
    }
    var fds = List[int]()
    (mut fds).push(transport.sock_fd(c))
    let ready = net.wait(fds, ms) else { return io }
    ready.len > 0
}

// The command's output files still open, in order: stdout, stderr.
fn outputs(pr: Running) -> List[fs.File] {
    var out = List[fs.File]()
    if !pr.out_eof {
        (mut out).push(copy pr.stdout)
    }
    if !pr.err_eof {
        (mut out).push(copy pr.stderr)
    }
    out
}

fn reap(mut pr: Running) -> () ! refuse.Refusal {
    if !pr.running {
        return
    }
    // An end by a signal is -N, or -(256 + N) with a core (`poll_core`).
    let cc = process.poll_core() else { return io }
    if cc.change.changed {
        // A stop is not an end (px112): `poll` reports a stopped program as
        // `256 + N`, and it stays the session's until it ends.
        if process.is_stopped(cc.change.status) {
            return
        }
        let v = cc.change.status.value
        pr.status = if v < 0 && cc.core then v - 256 else v
        pr.running = false
    }
}

fn status_text(v: int) -> str {
    if v >= 0 {
        return "status {v}"
    }
    let n = if v <= -256 then -v - 256 else -v
    let name = schannel.signal_name(n)
    if name == "" then "signal {n}" else "signal {name}"
}

/// What the turns of a session carry between them.
struct Flow {
    started: bool,
    close_in: bool,
}

// A message for the session (px112: `transport.step` gave one): the
// channel's answer, a command or the shell started, input kept for it.
fn on_message(
    mut c: transport.Conn,
    mut ch: schannel.Chan,
    mut pr: Running,
    mut pending: List[byte],
    mut flow: Flow,
    plan: Plan,
    nologin: str,
    p: List[byte],
) -> () ! refuse.Refusal {
    let s = schannel.on(mut ch, p)?
    say(plan, s.info)
    for r in s.replies {
        transport.write(mut c, r)?
    }
    if s.pty {
        var ok = false
        let got = ptyhost.open() else |e| {
            say(plan, "pty_failed: {e}")
            ptyhost.Pty { master: fs.File { fd: -1 }, slave: "" }
        }
        if got.slave != "" {
            ptyhost.set_size(got.master, ch.rows, ch.cols, ch.xpixels, ch.ypixels) else {}
            pr.pty = true
            pr.pty_open = true
            pr.master = copy got.master
            (mut pr.slave).reset()
            for b in got.slave.bytes() {
                (mut pr.slave).push(b)
            }
            schannel.grant_pty(mut ch)
            ok = true
        } else {
            schannel.refuse_pty(mut ch, "pty_failed")
        }
        if s.want_reply {
            transport.write(
                mut c,
                if ok then schannel.success_msg(ch) else schannel.failure_msg(ch),
            )?
        }
    }
    if s.resize && pr.pty_open {
        ptyhost.set_size(pr.master, ch.rows, ch.cols, ch.xpixels, ch.ypixels) else {}
    }
    if s.start && nologin != "" {
        if s.want_reply {
            transport.write(mut c, schannel.success_msg(ch))?
        }
        transport.write(mut c, schannel.start_msg(mut ch))?
        let text = wire_bytes(nologin)
        if text.len <= schannel.room(ch) {
            transport.write(mut c, schannel.data_msg(mut ch, 1, text))?
        }
        flow.started = true
        pr.status = 254
    } else if s.start {
        var ok = true
        let got = start_command(plan, ch, pr) else |e| {
            ok = false
            say(plan, "exec_failed: {e}")
            none_running()
        }
        if s.want_reply {
            let answer = if ok then schannel.success_msg(ch) else schannel.failure_msg(ch)
            transport.write(mut c, answer)?
        }
        if ok {
            pr.child = copy got.child
            pr.running = true
            pr.stdin = copy got.stdin
            pr.stdout = copy got.stdout
            pr.stderr = copy got.stderr
            pr.in_open = true
            pr.out_eof = got.out_eof
            pr.err_eof = got.err_eof
            flow.started = true
            transport.write(mut c, schannel.start_msg(mut ch))?
            if ch.shell && ch.pty_asked && !ch.pty {
                let text = wire_bytes(no_pty_text())
                if text.len <= schannel.room(ch) {
                    transport.write(mut c, schannel.data_msg(mut ch, 1, text))?
                }
            }
        }
    }
    for b in s.input {
        (mut pending).push(b)
    }
    if s.close_input {
        flow.close_in = true
    }
}

// One turn: a message from the client if one is there, the command's
// input as far as its pipe takes it, its output within the client's
// window, its end; `moved` says whether any byte moved.
fn turn_once(
    mut c: transport.Conn,
    mut ch: schannel.Chan,
    mut pr: Running,
    mut pending: List[byte],
    mut flow: Flow,
    plan: Plan,
    nologin: str,
) -> bool ! refuse.Refusal {
    var moved = false
    if sock_ready(c, 0)? {
        // At most one packet a turn (px112): a transport message (a PING,
        // an IGNORE, a re-exchange) is handled by `step`, which gives back
        // nothing, and the turn goes on to the command's side.
        let p = transport.step(mut c)?
        if p.len > 0 {
            on_message(mut c, mut ch, mut pr, mut pending, mut flow, plan, nologin, p)?
        }
        moved = true
    }
    // The command's input: as much as its pipe takes now.
    if pr.in_open && pending.len > 0 {
        let n = fs.write_some(mut pr.stdin, pending) else |e| match e {
            busy => 0,
            _ => {
                // The command closed its input: what it would have read is dropped.
                pr.in_open = false
                pending.len
            },
        }
        if n > 0 {
            pipe.drop_front(mut pending, n)
            schannel.consumed(mut ch, n)
            let adj = schannel.adjust_msg(mut ch)
            if adj.len > 0 {
                transport.write(mut c, adj)?
            }
            moved = true
        }
    } else if !pr.in_open && pending.len > 0 {
        schannel.consumed(mut ch, pending.len)
        (mut pending).reset()
    }
    // A pty cannot be half-closed: the client's EOF leaves it open (bw06).
    if pr.in_open && flow.close_in && pending.len == 0 && !pr.pty {
        var w = copy pr.stdin
        fs.close(take w) else {}
        pr.in_open = false
    }
    // The command's output, within the client's window.
    let room = schannel.room(ch)
    var out_moved = false
    if flow.started && room > 0 {
        let outs = outputs(pr)
        if outs.len > 0 {
            let w = signal.wait_fds(outs, signal.child(), 0) else { return io }
            if w.ready >= 0 {
                let is_out = !pr.out_eof && w.ready == 0
                var f = if is_out then copy pr.stdout else copy pr.stderr
                var eof = false
                let got = fs.read_chunk(mut f, room) else {
                    eof = true
                    List[byte]()
                }
                if eof || got.len == 0 {
                    if is_out {
                        pr.out_eof = true
                    } else {
                        pr.err_eof = true
                    }
                    fs.close(take f) else {}
                    if pr.pty && is_out {
                        // The master: its end (every slave closed) ends input too.
                        pr.in_open = false
                        pr.pty_open = false
                    }
                } else {
                    transport.write(mut c, schannel.data_msg(mut ch, if is_out then 0 else 1, got))?
                }
                moved = true
                out_moved = true
            }
        }
    }
    reap(mut pr)?
    // bw06: on a pty the program's end is the session's: what the master
    // still holds is read, and once it stays quiet 20 ms (a child that
    // ignores SIGHUP may still hold the slave) the master is closed.
    if pr.pty && pr.pty_open && !pr.running && !pr.out_eof && !out_moved && room > 0 {
        let w = signal.wait_fds(outputs(pr), signal.child(), 20) else { return io }
        if w.ready < 0 && w.meaning == 0 {
            var f = copy pr.stdout
            fs.close(take f) else {}
            pr.out_eof = true
            pr.in_open = false
            pr.pty_open = false
        }
        moved = true
    }
    // The end: EOF once the output has ended, then the status and CLOSE.
    if flow.started && pr.out_eof && pr.err_eof && !pr.running && !ch.got_close && !ch.sent_close {
        if !ch.sent_eof {
            transport.write(mut c, schannel.eof_msg(mut ch))?
        }
        let v = pr.status
        if v >= 0 {
            transport.write(mut c, schannel.exit_status_msg(ch, v))?
        } else {
            let n = if v <= -256 then -v - 256 else -v
            let name = schannel.signal_name(n)
            transport.write(
                mut c,
                schannel.exit_signal_msg(ch, if name == "" then "{n}" else name, v <= -256),
            )?
        }
        transport.write(mut c, schannel.close_msg(mut ch))?
        moved = true
    }
    if !moved {
        if !sock_ready(c, 5)? && flow.started && (pr.running || outputs(pr).len > 0) {
            let _ = signal.wait_fds(outputs(pr), signal.child(), 5) else { return io }
        }
    }
    moved
}

fn put_name(mut out: List[byte], name: str) {
    if out.len == 0 {
        for b in name.bytes() {
            (mut out).push(b)
        }
    }
}

/// Serves the channel until it closes, and says how it ended; a refusal
/// is named in the result, never raised, so the command's status survives
/// it.
pub fn run(mut c: transport.Conn, mut ch: schannel.Chan, plan: Plan) -> Result {
    var failed = List[byte]()
    signal.listen(signal.child()) else {
        put_name(mut failed, "io")
    }
    signal.ignore(signal.broken_pipe()) else {}
    if plan.pty {
        schannel.allow_pty(mut ch)
    }
    var pr = none_running()
    var pending = List[byte]()
    var flow = Flow { started: false, close_in: false }
    var nologin = ""
    if fs.exists("/etc/nologin") {
        nologin = fs.read_text("/etc/nologin") else "/etc/nologin exists\n"
    }
    while !schannel.done(ch) && failed.len == 0 {
        region turn {
            let _ = turn_once(
                mut c,
                mut ch,
                mut pr,
                mut pending,
                mut flow,
                plan,
                nologin,
            ) else |e| {
                put_name(mut failed, "{e}")
                false
            }
        }
    }
    // Packets already whole after both CLOSEs are still read, so data after
    // the client's CLOSE is refused by name rather than dropped unseen.
    while failed.len == 0 {
        var end = List[byte]()
        region drain {
            let p = transport.try_next(mut c) else |e| {
                put_name(mut end, "{e}")
                List[byte]()
            }
            if p.len > 0 {
                let _ = schannel.on(mut ch, p) else |e| {
                    put_name(mut failed, "{e}")
                    schannel.Step {
                        replies: List[List[byte]](),
                        input: List[byte](),
                        start: false,
                        want_reply: false,
                        close_input: false,
                        pty: false,
                        resize: false,
                        info: "",
                    }
                }
            } else {
                put_name(mut end, "end")
            }
        }
        if end.len > 0 {
            let why = str_from_utf8(end) else "end"
            if why != "end" && why != "disconnected" && why != "closed" {
                put_name(mut failed, why)
            }
            break
        }
    }
    if pr.pty_open {
        var m = copy pr.master
        fs.close(take m) else {}
        pr.pty_open = false
    }
    let st = if flow.started then status_text(pr.status) else "status -"
    var refused = schannel.refusals(ch)
    if nologin != "" && flow.started {
        (mut refused).push("nologin")
    }
    Result { status: st, refused: refused, failure: str_from_utf8(failed) else "io" }
}

/// The line a shell's session starts with on stderr when the client's
/// `pty-req` was refused (px112): burrowd has no ptys yet.
pub fn no_pty_text() -> str {
    "burrowd: no pty here: this shell runs without a terminal (no line editing, no job control)\n"
}

fn wire_bytes(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}
