//! member: true
//!
//! burrow.session — one command, or the login shell, on a session channel
//! (`src/channel`), with stdin, stdout and stderr as raw bytes, until the
//! channel closes.
//!
//! **A pseudo-terminal** (B8, RFC 4254 §6.2) when the plan asks for one:
//! the `pty-req` carries `TERM`, the window's size and the modes the local
//! terminal has (`src/ttymodes`), read from stdin; with stdin not a
//! terminal (`-tt`), a size of 0 by 0 and no modes. Its answer is awaited
//! before the command or shell is asked for. A server that refuses it is
//! told of on stderr in the pinned `ssh`'s line (`PTY allocation request
//! failed on channel 0`). Where the pty was asked for by `-t`, `-tt` or
//! `RequestTTY` `yes` or `force` (`explicit`), burrow gives up there with
//! 255 and the command is never asked for, as `ssh` does; for a login
//! session that asked by default (`auto`) the session goes on without one.
//!
//! **The local terminal** (B8): from the pty request on, a stdin that is a
//! terminal is set raw for the session (put back if the server refuses
//! the pty) (`term.raw_bytes`: a key
//! at a time, no echo, no flow control, CR and LF passed through both ways
//! untranslated) with its signal keys off, so the remote pty does the
//! echoing, the line editing and the interrupt, quit and suspend keys.
//! The mode it had is registered with the runtime first
//! (`term.restore_at_exit`) and put back by `restore` when the session
//! ends, however it ends: TERM, HUP and QUIT, whose default would end the
//! process with no code run, are listened for while the terminal is raw
//! and end the session (exit 255) after the terminal is put back. Each change of the local window's size (the
//! host's `signal.resize()` to the foreground group) is sent as a
//! `window-change` while the pty is held.
//!
//! **The escape character** (`ssh(1)` ESCAPE CHARACTERS; `~` unless `-e` or
//! `EscapeChar` say otherwise, none for `none`) is read when a pty was asked
//! for ("When a pseudo-terminal has been requested", `ssh(1)`), granted or
//! not, and only at the start of a line (the session's first byte, or
//! the one after a CR or LF typed). After it: `.` ends the connection
//! (`Connection to HOST closed.`, exit 255); `?` lists the escapes burrow
//! takes, in the pinned `ssh`'s words; the escape character again sends it
//! once. Every other escape `ssh` has (`B`, `R`, `V`, `v`, `^Z`, `#`, `&`,
//! `C`) is refused by name (`escape_unsupported`) and sends nothing; any
//! other byte is sent after the escape character, both as typed.
//!
//! **Waiting.** wolf-std at the pin has no single wait over a socket and a
//! file: `net.wait` takes the network table's handles and
//! `signal.wait_fds` takes files. So an idle turn waits up to 5 ms on the
//! socket and then up to 5 ms on stdin; a turn that moved bytes waits on
//! neither. Input waits at most that long; the socket is read the moment
//! a wait sees it ready. `signal.wait_fds` needs a meaning to listen for:
//! `resize` (SIGWINCH), whose default is to be ignored, so listening
//! changes nothing.
//!
//! **Memory.** Each turn runs in a region of its own and keeps nothing:
//! the connection and the channel are updated in place
//! (`[mem.region.outer-write]`), so a transfer of any size holds no more
//! than a packet's worth of memory.
//!
//! **After CLOSE** both ways, packets already whole in the input buffer
//! are still read, so data a server sends after its CLOSE is refused by
//! name (`channel_closed`) rather than dropped unseen; then DISCONNECT 11
//! `disconnected by user`, as the pinned `sshd` logs for its own client.

use std.fs
use std.io
use std.net
use std.signal
use std.term
use channel
use refuse
use transport
use ttymodes

/// What the session runs: `command` by `exec`, or, when `shell`, the
/// user's default shell by a `shell` request (RFC 4254 §6.5); on a
/// pseudo-terminal when `pty`, of the type `term`.
pub struct Plan {
    command: List[byte],
    shell: bool,
    env: List[str],
    verbose: int,
    pty: bool,
    explicit: bool,
    term: str,
    escape: int,
    host: str,
}

/// The local terminal as a `pty-req` describes it: its size and its modes
/// (§8's stream).
pub struct Local {
    cols: int,
    rows: int,
    modes: List[byte],
}

/// The local terminal while a session runs: whether it is raw now, the
/// mode it had before, and whether the session's closing line is written
/// (`~.` writes its own).
pub struct Tty {
    raw: bool,
    saved: term.Mode,
    closed: bool,
}

/// A terminal not yet touched.
pub fn untouched() -> Tty {
    Tty { raw: false, saved: term.unpack(0), closed: false }
}

// The mode the local terminal is held in while a session runs on a pty:
// raw_bytes, with the signal keys off too, so ^C, ^\ and ^Z are bytes
// for the remote pty, whose line discipline makes them signals there.
fn session_mode(m: term.Mode) -> term.Mode {
    let r = term.raw_bytes(m)
    term.Mode {
        canonical: r.canonical,
        echo: r.echo,
        signals: false,
        flow: r.flow,
        extended: r.extended,
        raw_cr: r.raw_cr,
        raw_output: r.raw_output,
        strip8: r.strip8,
        min: r.min,
        time: r.time,
    }
}

// The signals that end a session while the terminal is raw.
fn enders() -> int {
    signal.terminate() | signal.reload() | signal.quit()
}

// stdin raw, its mode before registered to be put back at any exit the
// runtime owns; a terminal that refuses either is left as it is.
fn go_raw(mut t: Tty) {
    let tty = fs.stdin()
    let saved = term.mode(tty) else { return }
    term.restore_at_exit(tty, saved, List[byte]()) else {}
    signal.listen(enders()) else { return }
    term.set_mode(tty, session_mode(saved)) else { return }
    t.saved = saved
    t.raw = true
}

/// The local terminal put back as it was found, once: after the session's
/// end, before anything is written about it, or when the server refuses
/// the pty. TERM, HUP and QUIT have their defaults again.
pub fn restore(mut t: Tty) {
    if t.raw {
        t.raw = false
        term.set_mode(fs.stdin(), t.saved) else {}
        signal.reset(enders()) else {}
    }
}

/// stdin's size and modes, each mode read on its own; a terminal that
/// answers none of them (stdin not a terminal) is 0 by 0 with no modes.
pub fn local_terminal() -> Local {
    let tty = fs.stdin()
    var l = Local { cols: 0, rows: 0, modes: ttymodes.encode(List[int]()) }
    let is_tty = io.is_terminal(tty) else false
    if !is_tty {
        return l
    }
    let size = term.size(tty) else term.Size { rows: 0, columns: 0 }
    l.cols = size.columns
    l.rows = size.rows
    var values = List[int]()
    for op in ttymodes.client_ops() {
        (mut values).push(term.attr(tty, op) else ttymodes.absent())
    }
    l.modes = ttymodes.encode(ttymodes.client_pairs(values))
    l
}

// A debug line; with a pty asked for it ends in CR LF, as the local
// terminal may be raw.
fn say(p: Plan, msg: str) {
    if p.verbose > 0 && msg.len > 0 {
        eprint(if p.pty then "debug1: {msg}\r" else "debug1: {msg}")
    }
}

// Writes what a step asks for and sends its reply.
fn apply(
    mut c: transport.Conn,
    mut ch: channel.Chan,
    plan: Plan,
    s: channel.Step,
) -> () ! refuse.Refusal {
    say(plan, s.info)
    if s.out.len > 0 {
        var o = fs.stdout()
        fs.write_chunk(mut o, s.out) else {
            transport.note(mut c, "standard output cannot be written")
            return io
        }
    }
    if s.err.len > 0 {
        var e = fs.stderr()
        fs.write_chunk(mut e, s.err) else {}
    }
    if s.reply.len > 0 {
        transport.write(mut c, s.reply)?
    }
    let adj = channel.adjust_msg(mut ch)
    if adj.len > 0 {
        transport.write(mut c, adj)?
    }
}

// At most one packet (px112): a transport message (an IGNORE, a PING, a
// re-exchange the server started) is handled by `step`, which gives back
// nothing, so a turn goes on to standard input after it.
fn pump(mut c: transport.Conn, mut ch: channel.Chan, plan: Plan) -> () ! refuse.Refusal {
    let p = transport.step(mut c)?
    if p.len == 0 {
        return
    }
    let s = channel.on(mut ch, p)?
    apply(mut c, mut ch, plan, s)?
}

fn sock_ready(c: transport.Conn, ms: int) -> bool ! refuse.Refusal {
    if transport.buffered(c) {
        return true
    }
    var fds = List[int]()
    (mut fds).push(transport.sock_fd(c))
    let ready = net.wait(fds, ms) else { return io }
    ready.len > 0
}

// Whether stdin has something to read within `ms`; a window change heard
// during the wait is kept in `flow` for the next turn.
fn stdin_ready(ms: int, mut flow: Flow) -> bool ! refuse.Refusal {
    var files = List[fs.File]()
    (mut files).push(fs.stdin())
    let set = if flow.raw then signal.resize() | enders() else signal.resize()
    let w = signal.wait_fds(files, set, ms) else { return io }
    if w.meaning == signal.resize() {
        flow.winch = true
    } else if w.meaning != 0 {
        flow.ended = w.meaning
    }
    w.ready == 0
}

/// What a session's turns carry between them: whether stdin is still open,
/// whether it is a terminal, a window change not yet sent; whether escapes
/// are read, whether the next byte starts a line, whether the escape
/// character was the last byte, and whether `~.` ended the session.
pub struct Flow {
    stdin_open: bool,
    tty_in: bool,
    raw: bool,
    ended: int,
    winch: bool,
    escapes: bool,
    at_bol: bool,
    esc_pending: bool,
    quit: bool,
}

// The escape character as the help writes it: itself, or ^ and a letter.
fn esc_name(e: int) -> str {
    var b = List[byte]()
    if e < 32 {
        (mut b).push(94 as byte)
        (mut b).push((e + 64) as byte)
    } else {
        (mut b).push(e as byte)
    }
    str_from_utf8(b) else "?"
}

fn to_stderr(text: str) {
    var e = fs.stderr()
    fs.write_chunk(mut e, text.bytes()) else {}
}

// `~?`: the escapes burrow takes, each line one of the pinned ssh's (the
// local terminal is raw: CR LF ends each line).
fn esc_help(e: int) {
    let n = esc_name(e)
    to_stderr(
        "{n}?\r\nSupported escape sequences:\r\n" +
            " {n}.   - terminate connection (and any multiplexed sessions)\r\n" +
            " {n}?   - this message\r\n" +
            " {n}{n}   - send the escape character by typing it twice\r\n" +
            "(Note that escapes are only recognized immediately after newline.)\r\n",
    )
}

// Whether `c` after the escape character is one of ssh's escapes that
// burrow does not take.
fn esc_refused(c: int) -> bool {
    c == 66 || c == 82 || c == 86 || c == 118 || c == 26 || c == 35 || c == 38 || c == 67
}

// What `got` sends once its escapes are taken out and done; `~.` stops it
// there, with what came before still sent.
fn unescape(e: int, mut flow: Flow, got: List[byte]) -> List[byte] {
    var out = List[byte]()
    for b in got {
        let v = b as int
        if flow.esc_pending {
            flow.esc_pending = false
            if v == 46 {
                flow.quit = true
                return out
            }
            if v == 63 {
                esc_help(e)
            } else if v == e {
                (mut out).push(b)
                flow.at_bol = false
            } else if esc_refused(v) {
                to_stderr(
                    "burrow: escape_unsupported: {esc_name(e)}{esc_name(v)}: an escape burrow does not take ({esc_name(e)}? lists the ones it does)\r\n",
                )
            } else {
                (mut out).push(e as byte)
                (mut out).push(b)
                flow.at_bol = v == 13 || v == 10
            }
        } else if flow.at_bol && v == e {
            flow.esc_pending = true
        } else {
            (mut out).push(b)
            flow.at_bol = v == 13 || v == 10
        }
    }
    out
}

// One turn: a message from the server if one is there, else input if the
// server's window has room, else a short wait on both.
fn turn_once(
    mut c: transport.Conn,
    mut ch: channel.Chan,
    plan: Plan,
    mut flow: Flow,
) -> () ! refuse.Refusal {
    if flow.raw {
        let m = signal.poll(enders()) else 0
        if m != 0 {
            flow.ended = m
            return
        }
    }
    if ch.pty_ok && flow.tty_in {
        let heard = signal.poll(signal.resize()) else 0
        if flow.winch || heard != 0 {
            flow.winch = false
            let size = term.size(fs.stdin()) else term.Size { rows: 0, columns: 0 }
            transport.write(mut c, channel.window_msg(ch, size.columns, size.rows, 0, 0))?
            say(plan, "window-change: {size.columns} by {size.rows}")
            return
        }
    }
    if sock_ready(c, 0)? {
        pump(mut c, mut ch, plan)?
        return
    }
    let want_in = flow.stdin_open && !ch.sent_eof && !ch.eow && !ch.got_close
    // A pending escape character may come out with the next byte: one
    // byte of room kept for it.
    let room = if flow.esc_pending then channel.room(ch) - 1 else channel.room(ch)
    if want_in && room > 0 && stdin_ready(0, mut flow)? {
        var inp = fs.stdin()
        var eof = false
        let got = fs.read_chunk(mut inp, room) else {
            eof = true
            List[byte]()
        }
        if eof || got.len == 0 {
            flow.stdin_open = false
            transport.write(mut c, channel.eof_msg(mut ch))?
        } else if flow.escapes {
            let out = unescape(plan.escape, mut flow, got)
            if out.len > 0 {
                transport.write(mut c, channel.data_msg(mut ch, out))?
            }
        } else {
            transport.write(mut c, channel.data_msg(mut ch, got))?
        }
        return
    }
    if !sock_ready(c, 5)? && want_in && room > 0 {
        let _ = stdin_ready(5, mut flow)?
    }
}

/// Opens the session on `ch` (a `channel.new()` the caller keeps, so its
/// detail can explain a refusal), sends the environment and the command,
/// and moves bytes until the channel closes. Returns the exit code `ssh`
/// would give. The local terminal is raw in `t` while a pty is held; the
/// caller puts it back (`restore`).
pub fn run(
    mut c: transport.Conn,
    mut ch: channel.Chan,
    plan: Plan,
    mut t: Tty,
) -> int ! refuse.Refusal {
    signal.listen(signal.resize()) else { return io }
    transport.write(mut c, channel.open_msg(ch))?
    while !ch.opened {
        pump(mut c, mut ch, plan)?
    }
    for kv in plan.env {
        let eq = kv.find("=") else 0
        transport.write(mut c, channel.env_msg(ch, kv[0..eq], kv[eq + 1..kv.len]))?
        say(plan, "Sending env {kv[0..eq]}")
    }
    let tty_in = io.is_terminal(fs.stdin()) else false
    if plan.pty {
        // The modes are read first; then, as `ssh`, the terminal is raw
        // from the request on, granted or not.
        let l = local_terminal()
        if tty_in {
            go_raw(mut t)
        }
        transport.write(mut c, channel.pty_msg(mut ch, plan.term, l.cols, l.rows, 0, 0, l.modes))?
        say(plan, "Requesting a pseudo-terminal: {plan.term}, {l.cols} by {l.rows}")
        while !ch.pty_ok && !ch.pty_refused && !ch.got_close {
            pump(mut c, mut ch, plan)?
        }
        if ch.pty_refused {
            // ssh's line, written raw; then, as ssh, the terminal is put
            // back: a session that goes on without a pty has the local
            // terminal's own echo and line editing (tty-refused).
            eprint("PTY allocation request failed on channel 0\r")
            restore(mut t)
            if plan.explicit {
                // -t, -tt, RequestTTY yes or force: ssh gives up there,
                // the command never asked for (dev4's tty-restore, bw06).
                t.closed = true
                transport.disconnect(mut c, 11, "disconnected by user")
                return 255
            }
        }
    }
    if plan.shell {
        transport.write(mut c, channel.shell_msg(mut ch))?
        say(
            plan,
            if plan.pty {
                "Requesting the shell"
            } else {
                "Requesting the shell, with no pseudo-terminal"
            },
        )
    } else {
        transport.write(mut c, channel.exec_msg(mut ch, plan.command))?
        say(plan, "Sending command: {str_from_utf8(plan.command) else "<not UTF-8>"}")
    }
    while !ch.exec_ok && !ch.got_close {
        pump(mut c, mut ch, plan)?
    }
    var flow = Flow {
        stdin_open: true,
        tty_in: tty_in,
        raw: t.raw,
        ended: 0,
        winch: false,
        escapes: plan.pty && plan.escape >= 0,
        at_bol: true,
        esc_pending: false,
        quit: false,
    }
    while !channel.done(ch) && !flow.quit && flow.ended == 0 {
        region turn {
            turn_once(mut c, mut ch, plan, mut flow)?
        }
    }
    if flow.quit {
        // `~.`: the line written while the terminal is still raw, then
        // the terminal put back; nothing more is read.
        eprint("Connection to {plan.host} closed.\r")
        t.closed = true
        restore(mut t)
        transport.disconnect(mut c, 11, "disconnected by user")
        return 255
    }
    if flow.ended != 0 {
        restore(mut t)
        t.closed = true
        eprint("burrow: ended by signal {signal.number(flow.ended) else 0}")
        transport.disconnect(mut c, 11, "disconnected by user")
        return 255
    }
    // Packets already whole in the buffer after both CLOSEs are still read.
    loop {
        let p = transport.try_next(mut c)?
        if p.len == 0 {
            break
        }
        let _ = channel.on(mut ch, p)?
    }
    if ch.signal.len > 0 {
        say(plan, "the remote command was killed by signal {str_from_utf8(ch.signal) else "?"}")
    }
    say(plan, "Exit status {if ch.status >= 0 then ch.status else -1}")
    transport.disconnect(mut c, 11, "disconnected by user")
    channel.exit_code(ch)
}
