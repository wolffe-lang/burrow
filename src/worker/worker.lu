//! member: true
//!
//! burrow.worker — burrowd's worker: the unprivileged process that parses
//! every byte a client sends before authentication (R-bw04-2). After
//! `transport.serve` it runs the service request (RFC 4253 §10:
//! `ssh-userauth` only) and authentication (RFC 4252, `src/sauth`),
//! asking the monitor, over two pipes, what only the monitor may decide:
//! whether a key is authorized for the user (`query`) and whether a
//! signature verifies over the session identifier the monitor signed
//! (`verify`), and, with passwords on (px112), whether a password opens
//! the account (`password`: the worker parses it and hands it over; the
//! monitor alone reads /etc/shadow). It holds no host key, reads no
//! user's file, and cannot become anyone.

use std.fs
use mon
use pipe
use refuse
use sauth
use transport
use wire

/// Who authenticated, with which key, and the key's forced command (in
/// one process; the monitor keeps its own).
pub struct Authed {
    user: str,
    blob: List[byte],
    command: str,
    forced: bool,
}

/// Whom the worker asks. burrowd's worker asks the monitor over `to` and
/// `from`; the one-process row program (R-bw04-2's (B), never installed)
/// decides in place (`local`), from the passwd and group text, the
/// `AuthorizedKeysFile` setting and StrictModes, with the same `mon` checks
/// the monitor runs.
pub struct Asker {
    local: bool,
    to: fs.File,
    from: fs.File,
    root: bool,
    passwd: str,
    group: str,
    files: str,
    strict_modes: bool,
    command: str,
    forced: bool,
}

/// An asker that asks the monitor.
pub fn monitor_asker(to: fs.File, from: fs.File) -> Asker {
    Asker {
        local: false,
        to: to,
        from: from,
        root: false,
        passwd: "",
        group: "",
        files: "",
        strict_modes: true,
        command: "",
        forced: false,
    }
}

fn ask(
    mut a: Asker,
    kind: int,
    fields: List[List[byte]],
    session_id: List[byte],
) -> bool ! refuse.Refusal {
    if a.local && kind == pipe.k_password() {
        // The one-process row program (R-bw04-2's (B), measurement only)
        // checks no password.
        return false
    }
    if a.local {
        let user = str_from_utf8(fields[0]) else ""
        let acct = mon.account_for(a.root, a.passwd, a.group, user)
        if acct.uid < 0 {
            return false
        }
        let v = mon.check_key(acct, a.files, a.strict_modes, fields[1])
        if !v.ok {
            return false
        }
        if kind == pipe.k_query() {
            return true
        }
        if !mon.verify(session_id, user, fields[1], fields[2]) {
            return false
        }
        a.command = copy v.command
        a.forced = v.has_command
        return true
    }
    pipe.send(mut a.to, kind, fields) else { return io }
    let got = pipe.receive(mut a.from) else { return io }
    if got.kind != pipe.k_answer() || got.fields.len != 1 || got.fields[0].len != 1 {
        return io
    }
    got.fields[0][0] as int == 1
}

/// The service request, then authentication, until a user is
/// authenticated or the connection is refused by name
/// (`service_refused`, `auth_changed`, `auth_tries_exceeded`,
/// `message_unexpected` for a connection message before it, and the
/// transport's). USERAUTH_SUCCESS is sent before this returns.
pub fn authenticate(
    mut c: transport.Conn,
    mut st: sauth.State,
    mut a: Asker,
) -> Authed ! refuse.Refusal {
    let first = transport.next(mut c)?
    if transport.kind(first) != refuse.msg_service_request() {
        transport.note(mut c, "message {transport.kind(first)} where the service request belongs")
        return message_unexpected
    }
    var r = wire.reader(first[1..first.len])
    let service = wire.read_utf8(mut r) else { return malformed }
    if service != "ssh-userauth" || !wire.at_end(r) {
        transport.note(mut c, "the client asked for the service {service}")
        return service_refused
    }
    transport.send(mut c, sauth.service_accept_msg(service))?
    loop {
        let p = transport.next(mut c)?
        let t = transport.kind(p)
        if t != refuse.msg_userauth_request() {
            transport.note(mut c, "message {t} before authentication")
            return message_unexpected
        }
        let q = sauth.parse(p)?
        if st.started && (q.user != st.user || q.service != st.service) {
            transport.note(mut c, "the user or service changed between requests")
        }
        let d = sauth.decide(mut st, q)?
        if d == "query" {
            var f = List[List[byte]]()
            (mut f).push(wire.bytes_of(q.user))
            (mut f).push(copy q.blob)
            if ask(mut a, pipe.k_query(), f, c.session_id)? {
                transport.send(mut c, sauth.pk_ok_msg(q.alg, q.blob))?
                continue
            }
        } else if d == "password" || d == "change" || d == "long" {
            var f = List[List[byte]]()
            (mut f).push(wire.bytes_of(q.user))
            (mut f).push(wire.bytes_of(if d == "password" then "check" else d))
            (mut f).push(if d == "password" then copy q.secret else List[byte]())
            if ask(mut a, pipe.k_password(), f, c.session_id)? {
                transport.send(mut c, sauth.success_msg())?
                return Authed { user: q.user, blob: List[byte](), command: "", forced: false }
            }
        } else if d == "verify" {
            var f = List[List[byte]]()
            (mut f).push(wire.bytes_of(q.user))
            (mut f).push(copy q.blob)
            (mut f).push(copy q.sig)
            if ask(mut a, pipe.k_verify(), f, c.session_id)? {
                transport.send(mut c, sauth.success_msg())?
                return Authed {
                    user: q.user,
                    blob: copy q.blob,
                    command: copy a.command,
                    forced: a.forced,
                }
            }
        }
        transport.note(mut c, "{st.failures + 1} failed attempts, MaxAuthTries {st.max_tries}")
        sauth.failed(mut st, q)?
        transport.send(mut c, sauth.failure_for(st))?
    }
}
