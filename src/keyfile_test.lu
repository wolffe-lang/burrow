//! member: false

// OpenSSH's private key format (PROTOCOL.key) for unencrypted Ed25519
// keys: the encoding of RFC 8032 TEST 1's published seed, held to the
// digest tools/vectorgen.py computes independently; the public line; a
// round trip; and every refusal by name. No key encoding is written to
// the repository: the vector is a digest.
use keyfile
use kexvec
use std.x.crypto.sha2
use wire

fn x(h: str) -> List[byte] {
    wire.unhex(h) else List[byte]()
}

fn seed1() -> List[byte] {
    x("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
}

fn pub1() -> List[byte] {
    x("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
}

// A raw key file with every field chosen by the caller.
fn build(
    cipher: str,
    kdf: str,
    n: int,
    pubtype: str,
    c1: int,
    c2: int,
    sectype: str,
    a: List[byte],
    sk: List[byte],
    pad_from: int,
) -> List[byte] {
    var blob = List[byte]()
    wire.put_text(mut blob, pubtype)
    wire.put_string(mut blob, pub1())
    var sect = List[byte]()
    wire.put_u32(mut sect, c1)
    wire.put_u32(mut sect, c2)
    wire.put_text(mut sect, sectype)
    wire.put_string(mut sect, a)
    wire.put_string(mut sect, sk)
    wire.put_text(mut sect, "c")
    var p = pad_from
    while sect.len % 8 != 0 {
        (mut sect).push(p as byte)
        p += 1
    }
    var raw = wire.bytes_of("openssh-key-v1")
    (mut raw).push(0 as byte)
    wire.put_text(mut raw, cipher)
    wire.put_text(mut raw, kdf)
    wire.put_text(mut raw, "")
    wire.put_u32(mut raw, n)
    var i = 0
    while i < n {
        wire.put_string(mut raw, blob)
        i += 1
    }
    wire.put_string(mut raw, sect)
    raw
}

fn verdict(text: str) -> str {
    let _ = keyfile.decode(text) else |e| {
        return "{e}"
    }
    "ok"
}

fn main() {
    // RFC 8032's published pair, taken as given (keyseed_test derives it):
    // the checked machine's step budget holds about six scalar
    // multiplications per file.
    let k = keyfile.Key { seed: seed1(), public: pub1(), comment: "burrow vector" }
    assert(wire.hex(keyfile.blob(k.public)) == kexvec.user_blob())
    let text = keyfile.encode(k, x("01020304"))
    assert(wire.hex(sha2.sum256(wire.bytes_of(text))) == kexvec.keyfile_sha256())
    let line = keyfile.public_line(k.public, k.comment)
    assert(wire.hex(wire.bytes_of(line)) == kexvec.keyfile_public_line())
    // The armour: BEGIN, lines of 70 base64 characters (the last shorter), END.
    let lines = text.lines()
    assert(lines[0] == "-----BEGIN OPENSSH PRIVATE KEY-----")
    assert(lines[lines.len - 1] == "-----END OPENSSH PRIVATE KEY-----")
    var i = 1
    while i < lines.len - 2 {
        assert(lines[i].len == 70)
        i += 1
    }
    // The round trip, and a CR LF copy of the file.
    let back = keyfile.decode(text) else |e| {
        print("FAIL keyfile round trip: {e}")
        keyfile.from_seed(List[byte](), "")
    }
    assert(wire.hex(back.seed) == wire.hex(seed1()))
    assert(wire.hex(back.public) == wire.hex(pub1()))
    assert(back.comment == "burrow vector")
    assert(verdict(text.replace("\n", "\r\n")) == "ok")
    assert(keyfile.public_line(k.public, "").ends_with("\n"))
    assert(!keyfile.public_line(k.public, "").ends_with(" \n"))
    assert(keyfile.fingerprint_line(k).starts_with("256 SHA256:"))
    assert(keyfile.fingerprint_line(k).ends_with(" burrow vector (ED25519)"))
    // Every refusal, by name.
    var sk = seed1()
    wire.put_raw(mut sk, pub1())
    let good = build("none", "none", 1, "ssh-ed25519", 7, 7, "ssh-ed25519", pub1(), sk, 1)
    let enc = build("aes256-ctr", "bcrypt", 1, "ssh-ed25519", 7, 7, "ssh-ed25519", pub1(), sk, 1)
    assert(verdict(keyfile.armor(enc)) == "key_encrypted")
    let kdf = build("none", "bcrypt", 1, "ssh-ed25519", 7, 7, "ssh-ed25519", pub1(), sk, 1)
    assert(verdict(keyfile.armor(kdf)) == "key_encrypted")
    let two = build("none", "none", 2, "ssh-ed25519", 7, 7, "ssh-ed25519", pub1(), sk, 1)
    assert(verdict(keyfile.armor(two)) == "key_count")
    let none = build("none", "none", 0, "ssh-ed25519", 7, 7, "ssh-ed25519", pub1(), sk, 1)
    assert(verdict(keyfile.armor(none)) == "key_count")
    let check = build("none", "none", 1, "ssh-ed25519", 7, 8, "ssh-ed25519", pub1(), sk, 1)
    assert(verdict(keyfile.armor(check)) == "key_checkint")
    let rsa = build("none", "none", 1, "ssh-rsa", 7, 7, "ssh-rsa", pub1(), sk, 1)
    assert(verdict(keyfile.armor(rsa)) == "key_unsupported")
    var other = copy pub1()
    other[0] = (other[0] as int ^ 1) as byte
    let mism = build("none", "none", 1, "ssh-ed25519", 7, 7, "ssh-ed25519", other, sk, 1)
    assert(verdict(keyfile.armor(mism)) == "key_mismatch")
    let pad = build("none", "none", 1, "ssh-ed25519", 7, 7, "ssh-ed25519", pub1(), sk, 2)
    assert(verdict(keyfile.armor(pad)) == "key_malformed")
    assert(verdict(keyfile.armor(good[0..good.len - 3])) == "key_malformed")
    assert(
        verdict("-----BEGIN RSA PRIVATE KEY-----\nAAAA\n-----END RSA PRIVATE KEY-----\n") ==
            "key_unsupported",
    )
    assert(verdict("not a key\n") == "key_malformed")
    assert(
        verdict("-----BEGIN OPENSSH PRIVATE KEY-----\n!!!!\n-----END OPENSSH PRIVATE KEY-----\n") ==
            "key_malformed",
    )
    print("keyfile: TEST 1's file and public line, a round trip, ten refusals by name")
}
