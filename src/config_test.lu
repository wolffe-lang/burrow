//! member: false

// The command line den passes (vc16's argv shapes, read from den's
// src/transport/ssh.lu), the rest of ssh(1)'s surface burrow takes, and
// ~/.ssh/config's Host and Match host blocks (ssh_config(5)): first value
// wins, IdentityFile and SendEnv accumulate, and every refusal by name with
// the line the pinned ssh prints.
use config

fn den_argv(port: str, dest: str) -> List[str] {
    var a = List[str]()
    for o in [
        "BatchMode=yes",
        "StrictHostKeyChecking=yes",
        "UpdateHostKeys=no",
        "ControlMaster=no",
        "ControlPath=none",
        "ClearAllForwardings=yes",
        "ConnectTimeout=30",
        "SendEnv=GIT_PROTOCOL",
    ] {
        (mut a).push("-o")
        (mut a).push(o)
    }
    if port != "" {
        (mut a).push("-p")
        (mut a).push(port)
    }
    (mut a).push("--")
    (mut a).push(dest)
    (mut a).push("'git-upload-pack'")
    (mut a).push("'/srv/a b'\\''c.git'")
    a
}

fn ready(args: List[str], text: str) -> config.Settings {
    var s = config.parse_args(args)
    if s.refusal == "" {
        config.apply_config(mut s, text, "~/.ssh/config")
    }
    if s.refusal == "" {
        config.finish(mut s, "/home/u", "localuser")
    }
    s
}

fn refused(args: List[str], text: str, name: str, line: str) -> bool {
    let s = ready(args, text)
    if s.refusal != name || !s.line.starts_with(line) {
        print(
            "FAIL config refusal: wanted {name} '{line}', got {s.refusal} '{s.line}' ({s.detail})",
        )
        return false
    }
    true
}

fn main() {
    // den's shape 1: no port, no user.
    let a = ready(den_argv("", "example.test"), "")
    assert(a.refusal == "")
    assert(a.host == "example.test" && a.hostname == "example.test")
    assert(a.port == 22 && a.user == "localuser")
    assert(a.strict == "yes" && a.batch && a.connect_timeout == 30)
    assert(a.send_env.len == 1 && a.send_env[0] == "GIT_PROTOCOL")
    assert(config.remote_command(a) == "'git-upload-pack' '/srv/a b'\\''c.git'")
    assert(a.identities.len == 1 && a.identities[0] == "/home/u/.ssh/id_ed25519")
    assert(a.known_hosts.len == 2 && a.known_hosts[0] == "/home/u/.ssh/known_hosts")
    assert(a.known_hosts[1] == "/home/u/.ssh/known_hosts2")
    // The system files after the user's (ssh_config(5), GlobalKnownHostsFile).
    assert(a.global_known_hosts.len == 2)
    assert(a.global_known_hosts[0] == "/etc/ssh/ssh_known_hosts")
    assert(a.global_known_hosts[1] == "/etc/ssh/ssh_known_hosts2")
    assert(!a.no_tty)
    // Shapes 2 and 3: a port, and user@host.
    let b = ready(den_argv("2222", "git@example.test"), "")
    assert(b.refusal == "" && b.port == 2222 && b.user == "git" && b.host == "example.test")
    // The rest of the surface: -l, -i, -T, -v, -F, ssh:// and its port.
    let c = ready(
        ["-T", "-vv", "-l", "me", "-i", "~/k1", "-i", "/abs/k2", "h.test", "echo", "a b"],
        "",
    )
    assert(c.refusal == "" && c.user == "me" && c.verbose == 2)
    assert(c.identities.len == 2 && c.identities[0] == "/home/u/k1" && c.identities[1] == "/abs/k2")
    assert(config.remote_command(c) == "echo a b")
    assert(c.no_tty)
    assert(ready(["-l", "me", "git@h.test", "x"], "").user == "me")
    assert(ready(["-o", "RekeyLimit=1G", "h", "x"], "").rekey_bytes == 1073741824)
    let d = ready(["ssh://git@h.test:2200", "true"], "")
    assert(d.refusal == "" && d.user == "git" && d.host == "h.test" && d.port == 2200)
    let e = ready(
        ["-F", "none", "-o", "Port=7", "-o", "User u2", "-o", "IdentityFile=none", "h.test", "x"],
        "Host *\n  Port 9\n",
    )
    assert(e.refusal == "" && e.port == 7 && e.user == "u2" && e.identities.len == 0)
    // ~/.ssh/config: Host and Match host, first value wins, accumulation.
    let text = "# comment\n" +
        "Host other.test\n" +
        "    ForwardAgent yes\n" +
        "Host *.test !bad.test\n" +
        "    Port 2201\n" +
        "    User=cfguser\n" +
        "    IdentityFile ~/.ssh/test_key\n" +
        "    SendEnv LANG LC_*\n" +
        "Match host h.test\n" +
        "    UserKnownHostsFile \"~/.ssh/kh test\" /etc/kh2\n" +
        "    IdentityFile /second\n" +
        "Host *\n" +
        "    StrictHostKeyChecking accept-new\n" +
        "    HashKnownHosts yes\n" +
        "    Port 2299\n" +
        "    SendEnv -LC_* GIT_*\n"
    let f = ready(["-p", "2222", "h.test", "true"], text)
    assert(f.refusal == "")
    assert(f.port == 2222 && f.user == "cfguser" && f.strict == "accept-new" && f.hash_known)
    assert(
        f.identities.len == 2 &&
            f.identities[0] == "/home/u/.ssh/test_key" &&
            f.identities[1] == "/second",
    )
    assert(
        f.known_hosts.len == 2 &&
            f.known_hosts[0] == "/home/u/.ssh/kh test" &&
            f.known_hosts[1] == "/etc/kh2",
    )
    assert(f.send_env.len == 2 && f.send_env[0] == "LANG" && f.send_env[1] == "GIT_*")
    // The global files: -o first, then the config; ~/ expanded; a
    // UserKnownHostsFile leaves them be.
    let gk = ready(["-o", "GlobalKnownHostsFile=/srv/kh ~/sys", "h.test", "x"], text)
    assert(
        gk.refusal == "" && gk.known_hosts.len == 2 && gk.known_hosts[0] == "/home/u/.ssh/kh test",
    )
    assert(
        gk.global_known_hosts.len == 2 &&
            gk.global_known_hosts[0] == "/srv/kh" &&
            gk.global_known_hosts[1] == "/home/u/sys",
    )
    let gc = ready(
        ["h.test", "x"],
        "Host h.test\n  GlobalKnownHostsFile /one\nHost *\n  GlobalKnownHostsFile /two\n",
    )
    assert(gc.refusal == "" && gc.global_known_hosts.len == 1 && gc.global_known_hosts[0] == "/one")
    assert(gc.known_hosts.len == 2 && gc.known_hosts[0] == "/home/u/.ssh/known_hosts")
    let g = ready(["bad.test", "true"], text)
    assert(g.refusal == "" && g.port == 2299 && g.user == "localuser")
    // Hostname, HostKeyAlias, SetEnv, RekeyLimit, the strictness words.
    let h = ready(
        [
            "-o",
            "SetEnv=A=1 B=two",
            "-o",
            "RekeyLimit=32K 60",
            "-o",
            "StrictHostKeyChecking=off",
            "alias",
            "x",
        ],
        "Host alias\n  Hostname 127.0.0.1\n  HostKeyAlias github.test\n",
    )
    assert(
        h.refusal == "" &&
            h.host == "alias" &&
            h.hostname == "127.0.0.1" &&
            h.key_alias == "github.test",
    )
    assert(h.set_env.len == 2 && h.set_env[0] == "A=1" && h.set_env[1] == "B=two")
    assert(h.rekey_bytes == 32768 && h.rekey_seconds == 60 && h.strict == "no")
    assert(ready(["-o", "StrictHostKeyChecking=ask", "x", "y"], "").strict == "yes")
    assert(ready(["-o", "StrictHostKeyChecking=no", "x", "y"], "").strict == "no")
    // Refusals, each with the pinned ssh's line where it has one.
    assert(refused(["-Z", "h", "x"], "", "option_unknown", "unknown option -- Z"))
    // No strict-kex waiver on any tier: B1's flag is an unknown option.
    assert(refused(["--no-strict-kex", "h", "x"], "", "option_unknown", "unknown option -- -"))
    assert(refused(["-t", "h", "x"], "", "option_unsupported", ""))
    assert(refused(["-t", "h"], "", "option_unsupported", ""))
    // No pty before B7: RequestTTY is refused by name, whatever its value.
    assert(refused(["-o", "RequestTTY=no", "h"], "", "option_unsupported", ""))
    assert(refused(["h"], "Host *\n  RequestTTY yes\n", "config_unsupported", ""))
    assert(refused(["-p"], "", "usage", "option requires an argument -- p"))
    assert(refused([], "", "usage", "usage: "))
    assert(
        refused(
            ["-o", "Foo=bar", "h", "x"],
            "",
            "option_unknown",
            "command-line: line 0: Bad configuration option: foo",
        ),
    )
    assert(refused(["-o", "ForwardAgent=yes", "h", "x"], "", "option_unsupported", ""))
    assert(
        refused(
            ["-o", "StrictHostKeyChecking=maybe", "h", "x"],
            "",
            "option_unsupported",
            "command-line line 0: unsupported option \"maybe\".",
        ),
    )
    assert(refused(["-o", "ControlMaster=auto", "h", "x"], "", "option_unsupported", ""))
    assert(refused(["-o", "ControlPath=/tmp/c", "h", "x"], "", "option_unsupported", ""))
    assert(refused(["-o", "UpdateHostKeys=yes", "h", "x"], "", "option_unsupported", ""))
    assert(refused(["-o", "Port=99999", "h", "x"], "", "option_unsupported", ""))
    assert(refused(["h.test", "x"], "Host *\n  ForwardAgent yes\n", "config_unsupported", ""))
    assert(
        refused(
            ["h.test", "x"],
            "Host *\n  Bogus 1\n",
            "config_unsupported",
            "~/.ssh/config: line 2: Bad configuration option: bogus",
        ),
    )
    assert(refused(["h.test", "x"], "Match exec true\n  Port 1\n", "config_unsupported", ""))
    assert(refused(["h.test", "x"], "Include other\n", "config_unsupported", ""))
    assert(refused(["h.test", "x"], "Host *\n  IdentityFile ~/.ssh/%h\n", "config_unsupported", ""))
    assert(
        refused(["h.test", "x"], "Host *\n  IdentityFile ${{HOME}}/k\n", "config_unsupported", ""),
    )
    // A keyword burrow lacks in a block that does not apply is not read.
    assert(ready(["h.test", "x"], "Host other\n  ForwardAgent yes\n").refusal == "")
    print(
        "config: den's argv shapes, ssh's flags, Host and Match host, the global known_hosts, 21 refusals",
    )
}
