//! member: true
//!
//! burrow.server — burrowd itself (src/burrowd.lu is its entry): the
//! listener, and for each connection the monitor, the worker and the holder
//! that becomes the user's session (R-bw04-2's (A)). `run` with
//! `one_process` true is R-bw04-2's (B) instead, one root process per
//! connection until the command starts: only the row program
//! `rows/burrowd-oneproc` (src/oneproc.lu, never installed or built
//! `--static`) asks for it, to measure what (A) costs; burrowd never does.

use std.env
use std.fs
use std.net
use std.os
use std.process
use std.signal
use std.term
use std.time
use entropy
use hostkey
use keyfile
use mon
use peer
use pipe
use refuse
use sauth
use schannel
use sconfig
use slog
use spass
use ssession
use transport
use wire
use worker

// The account the worker runs as when burrowd runs as root.
fn preauth_user() -> str {
    "burrowd"
}

// Where log lines go: the -E file, else stderr; nowhere under -q.
struct Log {
    file: str,
    quiet: bool,
}

fn log(l: Log, line: str) {
    if l.quiet {
        return
    }
    if l.file != "" {
        fs.append_text(l.file, line + "\n") else {
            eprint(line)
        }
        return
    }
    eprint(line)
}

fn stamp() -> str {
    slog.utc(time.unix_ms() / 1000)
}

fn fail(name: str, detail: str) -> int {
    eprint("burrowd: {name}: {detail}")
    1
}

// keyfile's refusal of the host key file, as burrowd's start refusal.
fn host_key_refusal(name: str) -> str {
    match name {
        "key_unreadable" => "host_key_unreadable",
        "key_permissions" => "host_key_permissions",
        "key_encrypted" => "host_key_encrypted",
        "key_unsupported" => "host_key_unsupported",
        _ => "host_key_malformed",
    }
}

// The host key, loaded and checked: its mode (keyfile: no group or other
// access), its owner (root, or the running user), its form.
struct HostKey {
    refusal: str,
    detail: str,
    seed: List[byte],
    k_s: List[byte],
    line: str,
}

fn load_host_key(path: str, euid: int) -> HostKey {
    var h = HostKey { refusal: "", detail: "", seed: List[byte](), k_s: List[byte](), line: "" }
    if !fs.exists(path) {
        h.refusal = "host_key_missing"
        h.detail = "{path}: no such file; make one with burrow-keygen -t ed25519 -f {path} -N \"\""
        return h
    }
    let info = fs.stat(path) else {
        h.refusal = "host_key_unreadable"
        h.detail = path
        return h
    }
    if info.uid != 0 && info.uid != euid {
        h.refusal = "host_key_permissions"
        h.detail = "{path} is owned by uid {info.uid}, not root or the running user"
        return h
    }
    var why = ""
    let k = keyfile.load(path) else |e| {
        why = "{e}"
        keyfile.Key { seed: List[byte](), public: List[byte](), comment: "" }
    }
    if why != "" {
        h.refusal = host_key_refusal(why)
        h.detail = if why == "key_permissions" {
            "{path} is accessible by group or others"
        } else {
            "{path} ({why}; no key bytes are printed)"
        }
        return h
    }
    h.seed = copy k.seed
    h.k_s = hostkey.ed25519_blob(k.public)
    h.line = keyfile.fingerprint_line(k)
    h
}

// The host key checked in a child, so the listener's memory never holds
// its private half: the child prints the verdict on a pipe and exits.
fn check_host_key(path: str, euid: int) -> List[str] {
    var out = List[str]()
    let p = process.pipe() else {
        (mut out).push("io")
        (mut out).push("a pipe for the host key check")
        return out
    }
    let f = process.fork() else {
        (mut out).push("io")
        (mut out).push("a fork for the host key check")
        return out
    }
    if process.is_child(f) {
        let h = load_host_key(path, euid)
        var w = copy p.write
        var fields = List[List[byte]]()
        (mut fields).push(wire.bytes_of(h.refusal))
        (mut fields).push(wire.bytes_of(if h.refusal == "" then h.line else h.detail))
        pipe.send(mut w, 1, fields) else {}
        process.exit(0)
    }
    var w = copy p.write
    fs.close(take w) else {}
    var r = copy p.read
    let fr = pipe.receive(mut r) else pipe.Frame { kind: 0, fields: List[List[byte]]() }
    fs.close(take r) else {}
    var ch = process.Child { slot: f.child.slot }
    let _ = process.wait_status(take ch) else 0
    (mut out).push(pipe.text(fr, 0))
    (mut out).push(pipe.text(fr, 1))
    out
}

fn read_or(path: str) -> str {
    fs.read_text(path) else ""
}

// ---- the worker: unprivileged, every byte before authentication.

// sshd's DISCONNECT text where it has one for the same condition
// (R-bw04-5), else burrowd's own.
fn disconnect_text(name: str, detail: str) -> str {
    if name == "auth_tries_exceeded" {
        return "Too many authentication failures"
    }
    "burrowd: {name}: {detail}"
}

fn worker_main(take sock: net.Socket, s: sconfig.Settings, to: fs.File, from: fs.File) {
    var tw = to
    var fr = from
    // The host key's public blob, from the monitor.
    let key = pipe.receive(mut fr) else {
        process.exit(1)
        return
    }
    var opts = transport.options("", 0)
    opts.timeout_ms = if s.grace > 0 then s.grace * 1000 else 3600000
    opts.verbose = if s.debug then 1 else 0
    if s.rekey_bytes > 0 {
        opts.rekey_bytes = s.rekey_bytes
    }
    if s.rekey_seconds > 0 {
        opts.rekey_seconds = s.rekey_seconds
    }
    var c = transport.adopt(
        take sock,
        opts,
        transport.monitor_signer(pipe.bytes_at(key, 0), tw, fr),
    ) else {
        process.exit(1)
        return
    }
    var why = ""
    transport.serve(mut c) else |e| {
        why = "{e}"
    }
    var st = sauth.start_with(s.max_tries, s.password_auth)
    var who = worker.Authed { user: "", blob: List[byte](), command: "", forced: false }
    var asker = worker.monitor_asker(copy tw, copy fr)
    if why == "" {
        who = worker.authenticate(mut c, mut st, mut asker) else |e| {
            why = "{e}"
            worker.Authed { user: "", blob: List[byte](), command: "", forced: false }
        }
    }
    if why != "" {
        let detail = transport.detail(c)
        if why != "closed" && why != "timeout" && why != "io" && why != "disconnected" {
            transport.disconnect(mut c, refuse.reason_of(why), disconnect_text(why, detail))
        }
        var f = List[List[byte]]()
        (mut f).push(wire.bytes_of(if why == "timeout" then "grace_expired" else why))
        (mut f).push(wire.bytes_of(detail))
        var refused = ""
        for r in st.refused {
            if refused.len > 0 {
                refused += ","
            }
            refused += r
        }
        (mut f).push(wire.bytes_of(refused))
        pipe.send(mut tw, pipe.k_outcome(), f) else {}
        transport.close(take c)
        process.exit(0)
        return
    }
    var f = List[List[byte]]()
    (mut f).push(wire.bytes_of(who.user))
    (mut f).push(copy who.blob)
    (mut f).push(transport.handoff(c))
    pipe.send(mut tw, pipe.k_authed(), f) else {}
    process.exit(0)
}

// ---- the holder: becomes the user's session.

fn session_env(a: mon.Account, ends: peer.Ends) -> List[str] {
    var e = List[str]()
    (mut e).push("USER={a.name}")
    (mut e).push("LOGNAME={a.name}")
    (mut e).push("HOME={a.home}")
    (mut e).push("PATH=/usr/bin:/bin:/usr/sbin:/sbin")
    (mut e).push("MAIL=/var/mail/{a.name}")
    (mut e).push("SHELL={a.shell}")
    (mut e).push(
        "SSH_CONNECTION={ends.client.addr} {ends.client.port} {ends.server.addr} {ends.server.port}",
    )
    let tz = env.get("TZ") else ""
    if tz != "" {
        (mut e).push("TZ={tz}")
    }
    e
}

// px112: burrowd leads a process group of its own, away from the group that
// started it (on PAX, the boot hook's, in pid 1's session with the console as
// its terminal), so that no job-control stop meant for another group stops the
// listener. A person who ran `burrowd -D` at a prompt keeps it in the
// terminal's foreground group (^C reaches it); a session leader may not move.
fn leave_group() {
    let fg = term.foreground(fs.stdin()) else -1
    let mine = term.group() else -2
    if fg == mine {
        return
    }
    process.lead_group() else {}
}

fn base_name(path: str) -> str {
    let slash = path.rfind("/") else -1
    path[slash + 1..path.len]
}

fn holder_main(
    take sock: net.Socket,
    s: sconfig.Settings,
    from: fs.File,
    to: fs.File,
    ends: peer.Ends,
    root: bool,
) {
    var fr = from
    var tw = to
    let go = pipe.receive(mut fr) else {
        process.exit(0)
        return
    }
    if go.kind != pipe.k_go() {
        process.exit(0)
        return
    }
    let a = mon.account_from(go.fields, 0) else {
        process.exit(1)
        return
    }
    if root {
        process.set_ids(a.uid, a.gid, a.groups) else {
            process.exit(1)
            return
        }
    }
    let forced = pipe.text(go, 6) == "1"
    let command = pipe.text(go, 7)
    var opts = transport.options("", 0)
    opts.timeout_ms = 3600000
    opts.verbose = if s.debug then 1 else 0
    if s.rekey_bytes > 0 {
        opts.rekey_bytes = s.rekey_bytes
    }
    if s.rekey_seconds > 0 {
        opts.rekey_seconds = s.rekey_seconds
    }
    var c = transport.restore(
        take sock,
        opts,
        transport.monitor_signer(List[byte](), tw, fr),
        pipe.bytes_at(go, 8),
    ) else {
        process.exit(1)
        return
    }
    let plan = ssession.Plan {
        shell: a.shell,
        argv0: base_name(a.shell),
        home: a.home,
        command: command,
        forced: forced,
        env: session_env(a, ends),
        verbose: if s.debug then 1 else 0,
        pty: s.permit_tty && pipe.text(go, 9) == "1",
        drop: false,
        uid: a.uid,
        gid: a.gid,
        groups: copy a.groups,
    }
    var ch = schannel.new()
    let res = ssession.run(mut c, mut ch, plan)
    var outcome = if res.failure == "" then "ok" else res.failure
    if outcome != "ok" && outcome != "closed" && outcome != "io" && outcome != "disconnected" {
        let detail = if schannel.detail(ch) != "" then schannel.detail(ch) else transport.detail(c)
        transport.disconnect(mut c, refuse.reason_of(outcome), disconnect_text(outcome, detail))
    }
    var f = List[List[byte]]()
    (mut f).push(wire.bytes_of(outcome))
    (mut f).push(wire.bytes_of(res.status))
    var refused = ""
    for r in res.refused {
        if refused.len > 0 {
            refused += ","
        }
        refused += r
    }
    (mut f).push(wire.bytes_of(refused))
    pipe.send(mut tw, pipe.k_ended(), f) else {}
    transport.close(take c)
    process.exit(0)
}

// ---- passwords (px112): one check at a time across the server.

// The token pipe: the listener puts one byte in it at start; a monitor takes
// the byte before it forks a checker and puts it back after reaping it, and
// tells the listener each (`P`, `p` on its status pipe), so a monitor that
// ends holding the byte has it put back. `on` is false when passwords are off.
struct Token {
    on: bool,
    read: fs.File,
    write: fs.File,
}

fn no_token() -> Token {
    Token { on: false, read: fs.File { fd: -1 }, write: fs.File { fd: -1 } }
}

fn status_byte(mut st: fs.File, b: int) {
    var one = List[byte]()
    (mut one).push(b as byte)
    fs.write_chunk(mut st, one) else {}
}

// Whether `password` opens `field`: the token taken (waiting at most
// `left_ms`, then false), the hash run in a child of its own, which exits 0
// on a match, the token put back.
fn checked(tk: Token, mut st: fs.File, field: str, password: List[byte], left_ms: int) -> bool {
    if !tk.on {
        return false
    }
    let until = time.monotonic_ns() / 1000000 + left_ms
    var have = false
    while !have {
        let left = until - time.monotonic_ns() / 1000000
        if left <= 0 {
            return false
        }
        var files = List[fs.File]()
        (mut files).push(copy tk.read)
        let w = signal.wait_fds(files, signal.child(), if left > 1000 then 1000 else left) else {
            continue
        }
        if w.ready == 0 {
            var r = copy tk.read
            let got = fs.read_chunk(mut r, 1) else List[byte]()
            have = got.len == 1
        }
    }
    status_byte(mut st, 80)
    var ok = false
    let f = process.fork() else {
        var w = copy tk.write
        status_byte(mut w, 1)
        status_byte(mut st, 112)
        return false
    }
    if process.is_child(f) {
        process.exit(if spass.check(password, field, spass.cap()) then 0 else 1)
        return false
    }
    var ch = process.Child { slot: f.child.slot }
    ok = (process.wait_status(take ch) else 1) == 0
    var w = copy tk.write
    status_byte(mut w, 1)
    status_byte(mut st, 112)
    ok
}

fn today() -> int {
    time.unix_ms() / 86400000
}

// ---- the monitor: one per connection.

fn close_file(f: fs.File) {
    var g = copy f
    fs.close(take g) else {}
}

struct Pre {
    root: bool,
    uid: int,
    gid: int,
}

fn answer(mut to: fs.File, yes: bool) {
    var f = List[List[byte]]()
    var b = List[byte]()
    (mut b).push((if yes then 1 else 0) as byte)
    (mut f).push(b)
    pipe.send(mut to, pipe.k_answer(), f) else {}
}

fn fingerprint(blob: List[byte]) -> str {
    if blob.len == 0 then "-" else hostkey.fingerprint(blob)
}

fn monitor_main(
    take sock: net.Socket,
    s: sconfig.Settings,
    lport: int,
    pre: Pre,
    status: fs.File,
    lg: Log,
    tk: Token,
) {
    var st = status
    let ends = peer.of_connection(lport)
    var line = slog.start(stamp(), env.pid(), ends.client.addr, ends.client.port)
    let w2m = process.pipe() else {
        process.exit(1)
        return
    }
    let m2w = process.pipe() else {
        process.exit(1)
        return
    }
    let h2m = process.pipe() else {
        process.exit(1)
        return
    }
    let m2h = process.pipe() else {
        process.exit(1)
        return
    }
    let euid = env.euid() else 0
    // The holder and the worker, forked before the host key is read.
    let hf = process.fork() else {
        process.exit(1)
        return
    }
    if process.is_child(hf) {
        // The holder keeps its two ends only: the worker's pipes, the
        // monitor's ends and the listener's status pipe are closed, and so is
        // the server's stderr, so the user's session holds none of them.
        close_file(w2m.read)
        close_file(w2m.write)
        close_file(m2w.read)
        close_file(m2w.write)
        close_file(m2h.write)
        close_file(h2m.read)
        close_file(st)
        if tk.on {
            close_file(tk.read)
            close_file(tk.write)
        }
        if !s.debug {
            close_file(fs.stderr())
        }
        holder_main(take sock, s, m2h.read, h2m.write, ends, pre.root)
        return
    }
    let wf = process.fork() else {
        process.exit(1)
        return
    }
    if process.is_child(wf) {
        close_file(w2m.read)
        close_file(m2w.write)
        close_file(m2h.read)
        close_file(m2h.write)
        close_file(h2m.read)
        close_file(h2m.write)
        close_file(st)
        if tk.on {
            close_file(tk.read)
            close_file(tk.write)
        }
        if pre.root {
            process.set_ids(pre.uid, pre.gid, List[int]()) else {
                process.exit(1)
                return
            }
        }
        env.set_cwd("/") else {}
        worker_main(take sock, s, w2m.write, m2w.read)
        return
    }
    net.close(take sock) else {}
    close_file(w2m.write)
    close_file(m2w.read)
    close_file(m2h.read)
    close_file(h2m.write)
    var wpid = process.pid(wf.child) else -1
    // Only now the host key.
    let hk = load_host_key(s.host_key, euid)
    var to_w = m2w.write
    var from_w = w2m.read
    var to_h = m2h.write
    var from_h = h2m.read
    var kf = List[List[byte]]()
    (mut kf).push(copy hk.k_s)
    pipe.send(mut to_w, pipe.k_key(), kf) else {}
    let passwd = read_or("/etc/passwd")
    let group = read_or("/etc/group")
    // px112: /etc/shadow, as root only (never in the worker or the holder,
    // both forked before it is read): the account's state for every method
    // and its password for the `password` one.
    let shadow = if pre.root then read_or("/etc/shadow") else ""
    var session_id = List[byte]()
    var authed_user = ""
    var authed_blob = List[byte]()
    var verdict_cmd = ""
    var verdict_forced = false
    var verdict_pty = true
    var state = List[byte]()
    let started = time.monotonic_ns()
    var phase = "auth"
    signal.listen(signal.child()) else {}
    while phase == "auth" {
        var files = List[fs.File]()
        (mut files).push(from_w)
        var left = -1
        if s.grace > 0 {
            left = s.grace * 1000 - (time.monotonic_ns() - started) / 1000000
            if left <= 0 {
                if wpid > 0 {
                    signal.send(wpid, signal.kill()) else {}
                }
                line.outcome = "grace_expired"
                phase = "over"
                break
            }
        }
        let w = signal.wait_fds(files, signal.child(), if left < 0 then 1000 else left) else {
            phase = "over"
            break
        }
        if w.ready != 0 {
            continue
        }
        let fr = pipe.receive(mut from_w) else {
            phase = "over"
            break
        }
        if fr.kind == pipe.k_sign() {
            let h = pipe.bytes_at(fr, 0)
            if session_id.len == 0 {
                session_id = copy h
            }
            var f = List[List[byte]]()
            (mut f).push(hostkey.sign_blob(hk.seed, h))
            pipe.send(mut to_w, pipe.k_signed(), f) else {}
        } else if fr.kind == pipe.k_query() || fr.kind == pipe.k_verify() {
            let user = pipe.text(fr, 0)
            let blob = pipe.bytes_at(fr, 1)
            line.user = user
            line.key = fingerprint(blob)
            var ok = false
            var a = mon.account_for(pre.root, passwd, group, user)
            if a.uid < 0 {
                line.outcome = if a.name == "root" then "auth_root_refused" else "auth_user_unknown"
            }
            let state = if a.uid >= 0 {
                spass.account_state(spass.entry(shadow, user), today())
            } else {
                ""
            }
            if state != "" {
                line.outcome = state
            }
            if a.uid >= 0 && state == "" {
                let v = mon.check_key(a, s.authorized_files, s.strict_modes, blob)
                if v.ok {
                    ok = fr.kind == pipe.k_query() ||
                        mon.verify(session_id, user, blob, pipe.bytes_at(fr, 2))
                    if !ok {
                        line.outcome = "auth_sig_bad"
                    } else if fr.kind == pipe.k_verify() {
                        authed_user = user
                        authed_blob = copy blob
                        verdict_cmd = v.command
                        verdict_forced = v.has_command
                        verdict_pty = v.pty
                    }
                } else {
                    line.outcome = if v.why.starts_with("StrictModes") {
                        "auth_strict_modes"
                    } else {
                        "auth_key_unlisted"
                    }
                    if v.why != "" && s.debug {
                        log(lg, "{stamp()} burrowd[{env.pid()}]: debug: {v.why}")
                    }
                }
            }
            answer(mut to_w, ok)
        } else if fr.kind == pipe.k_password() {
            // px112: the account's state, then its password's, then the
            // check: against the account's field, or, for any refusal, the
            // dummy at the shipped cost, so every FAILURE costs one hash.
            let user = pipe.text(fr, 0)
            let kind = pipe.text(fr, 1)
            line.user = user
            line.key = "password"
            var why = ""
            if kind == "change" {
                why = "auth_password_change_refused"
            } else if kind == "long" {
                why = "auth_password_too_long"
            } else {
                let a = mon.account_for(pre.root, passwd, group, user)
                let e = spass.entry(shadow, user)
                if a.uid < 0 {
                    why = if a.name == "root" then "auth_root_refused" else "auth_user_unknown"
                } else {
                    why = spass.account_state(e, today())
                    if why == "" {
                        why = spass.password_state(e, today(), spass.cap())
                    }
                }
                let left = if s.grace > 0 {
                    s.grace * 1000 - (time.monotonic_ns() - started) / 1000000
                } else {
                    3600000
                }
                let ok = checked(
                    tk,
                    mut st,
                    if why == "" then e.field else spass.dummy(),
                    pipe.bytes_at(fr, 2),
                    left,
                )
                if why == "" && !ok {
                    why = "auth_password_bad"
                }
            }
            if why == "" {
                authed_user = user
                authed_blob = List[byte]()
                verdict_cmd = ""
                verdict_forced = false
                verdict_pty = true
            } else {
                line.outcome = why
            }
            answer(mut to_w, why == "")
        } else if fr.kind == pipe.k_authed() {
            if authed_user != "" &&
                pipe.text(fr, 0) == authed_user &&
                wire.hex(pipe.bytes_at(fr, 1)) == wire.hex(authed_blob) {
                state = pipe.bytes_at(fr, 2)
                phase = "session"
            } else {
                line.outcome = "message_unexpected"
                phase = "over"
            }
        } else if fr.kind == pipe.k_outcome() {
            let name = pipe.text(fr, 0)
            // A refusal the worker named wins over the monitor's last note,
            // except that a refused key is more telling than the client
            // giving up after it.
            if !(name == "disconnected" || name == "closed") || line.outcome == "closed" {
                line.outcome = name
            }
            let refused = pipe.text(fr, 2)
            if refused != "" {
                for r in refused.split(",") {
                    (mut line.refused).push("auth_method_refused:{r}")
                }
            }
            phase = "over"
        }
    }
    if phase == "session" {
        var b = List[byte]()
        (mut b).push(65 as byte)
        fs.write_chunk(mut st, b) else {}
        let a = mon.account_for(pre.root, passwd, group, authed_user)
        var f = mon.account_fields(a)
        (mut f).push(wire.bytes_of(if verdict_forced then "1" else "0"))
        (mut f).push(wire.bytes_of(verdict_cmd))
        (mut f).push(state)
        // bw06: field 9, whether this login may have a pty (the key's options).
        (mut f).push(wire.bytes_of(if verdict_pty then "1" else "0"))
        pipe.send(mut to_h, pipe.k_go(), f) else {}
        line.outcome = "ok"
        line.user = authed_user
        line.key = if authed_blob.len == 0 then "password" else fingerprint(authed_blob)
        loop {
            let fr = pipe.receive(mut from_h) else { break }
            if fr.kind == pipe.k_sign() {
                var sf = List[List[byte]]()
                (mut sf).push(hostkey.sign_blob(hk.seed, pipe.bytes_at(fr, 0)))
                pipe.send(mut to_h, pipe.k_signed(), sf) else {}
            } else if fr.kind == pipe.k_ended() {
                line.outcome = pipe.text(fr, 0)
                line.status = pipe.text(fr, 1)
                let refused = pipe.text(fr, 2)
                if refused != "" {
                    for r in refused.split(",") {
                        (mut line.refused).push(r)
                    }
                }
            }
        }
    } else {
        var none = List[List[byte]]()
        pipe.send(mut to_h, pipe.k_stop(), none) else {}
    }
    log(lg, slog.format(line))
    var hc = process.Child { slot: hf.child.slot }
    let _ = process.wait_status(take hc) else 0
    var wc = process.Child { slot: wf.child.slot }
    let _ = process.wait_status(take wc) else 0
    process.exit(0)
}

// ---- R-bw04-2's (B), for the measurement only: one root process per
// connection, the host key in it, the command forked as the user.

fn oneproc_main(
    take sock: net.Socket,
    s: sconfig.Settings,
    lport: int,
    pre: Pre,
    status: fs.File,
    lg: Log,
) {
    var st = status
    let ends = peer.of_connection(lport)
    var line = slog.start(stamp(), env.pid(), ends.client.addr, ends.client.port)
    let euid = env.euid() else 0
    let hk = load_host_key(s.host_key, euid)
    var opts = transport.options("", 0)
    opts.timeout_ms = if s.grace > 0 then s.grace * 1000 else 3600000
    if s.rekey_bytes > 0 {
        opts.rekey_bytes = s.rekey_bytes
    }
    var c = transport.adopt(take sock, opts, transport.local_signer(hk.seed, hk.k_s)) else {
        process.exit(1)
        return
    }
    let passwd = read_or("/etc/passwd")
    let group = read_or("/etc/group")
    var why = ""
    transport.serve(mut c) else |e| {
        why = "{e}"
    }
    var stt = sauth.start(s.max_tries)
    var asker = worker.Asker {
        local: true,
        to: fs.File { fd: -1 },
        from: fs.File { fd: -1 },
        root: pre.root,
        passwd: passwd,
        group: group,
        files: s.authorized_files,
        strict_modes: s.strict_modes,
        command: "",
        forced: false,
    }
    var who = worker.Authed { user: "", blob: List[byte](), command: "", forced: false }
    if why == "" {
        who = worker.authenticate(mut c, mut stt, mut asker) else |e| {
            why = "{e}"
            worker.Authed { user: "", blob: List[byte](), command: "", forced: false }
        }
    }
    line.user = stt.user
    line.key = fingerprint(stt.last_blob)
    if why != "" {
        if why != "closed" && why != "timeout" && why != "io" && why != "disconnected" {
            transport.disconnect(
                mut c,
                refuse.reason_of(why),
                disconnect_text(why, transport.detail(c)),
            )
        }
        line.outcome = if why == "timeout" then "grace_expired" else why
        log(lg, slog.format(line))
        process.exit(0)
        return
    }
    var b = List[byte]()
    (mut b).push(65 as byte)
    fs.write_chunk(mut st, b) else {}
    c.authed = true
    let a = mon.account_for(pre.root, passwd, group, who.user)
    let plan = ssession.Plan {
        shell: a.shell,
        argv0: base_name(a.shell),
        home: a.home,
        command: who.command,
        forced: who.forced,
        env: session_env(a, ends),
        verbose: 0,
        pty: false,
        drop: pre.root,
        uid: a.uid,
        gid: a.gid,
        groups: copy a.groups,
    }
    var ch = schannel.new()
    let res = ssession.run(mut c, mut ch, plan)
    line.outcome = if res.failure == "" then "ok" else res.failure
    line.status = res.status
    log(lg, slog.format(line))
    transport.close(take c)
    process.exit(0)
}

// ---- the listener.

struct Live {
    child: process.Child,
    status: fs.File,
    authed: bool,
    // px112: password-check tokens this monitor took and has not put back.
    tokens: int,
}

fn drop_it(s: sconfig.Settings, unauth: int, mut pool: entropy.Source) -> bool {
    if unauth < s.startups_begin {
        return false
    }
    if unauth >= s.startups_full {
        return true
    }
    let span = s.startups_full - s.startups_begin
    let p = s.startups_rate +
        (100 - s.startups_rate) * (unauth - s.startups_begin) / (if span > 0 then span else 1)
    let r = entropy.draw(mut pool, 1) else List[byte]()
    if r.len == 0 {
        return true
    }
    r[0] as int * 100 / 256 < p
}

/// burrowd with its arguments (without the program name); its exit status.
/// `one_process` is the row program's (B), never burrowd's.
pub fn run(args: List[str], one_process: bool) -> int {
    var s = sconfig.parse_args(args)
    if s.refusal == "" && !s.version {
        if fs.exists(s.config_file) {
            let text = fs.read_text(s.config_file) else {
                return fail("config_unsupported", "{s.config_file} cannot be read")
            }
            sconfig.apply_file(mut s, text, s.config_file)
        }
    }
    if s.refusal != "" {
        if s.refusal == "usage" || s.refusal == "option_unknown" {
            eprint(sconfig.usage())
        }
        return fail(s.refusal, s.detail)
    }
    if s.version {
        eprint("burrowd_0.0.0, burrow (wolf)")
        return 0
    }
    let euid = env.euid() else -1
    let root = euid == 0
    if root && os.name() != "linux" && os.name() != "pax" {
        return fail(
            "privileges_unsupported",
            "burrowd cannot change a process's user on {os.name()}; run it as the user it serves",
        )
    }
    let checked = check_host_key(s.host_key, euid)
    if checked[0] != "" {
        return fail(checked[0], checked[1])
    }
    var pre = Pre { root: root, uid: 0, gid: 0 }
    if root {
        let u = mon.account(read_or("/etc/passwd"), "", preauth_user()) else |e| {
            return fail(
                "preauth_user_missing",
                "no account {preauth_user()} in /etc/passwd ({e}) for the unprivileged worker",
            )
        }
        pre.uid = u.uid
        pre.gid = u.gid
    }
    // px112: only root reads /etc/shadow, so a password needs burrowd run as
    // root (which burrowd never is on macOS).
    if s.password_auth && !root {
        return fail(
            "config_unsupported",
            "PasswordAuthentication yes: burrowd checks a password against /etc/shadow, which only root reads; run it as root, or say no",
        )
    }
    if s.print_config {
        for l in sconfig.effective(s) {
            print(l)
        }
        return 0
    }
    if s.test_only {
        return 0
    }
    leave_group()
    let lg = Log { file: s.log_file, quiet: s.quiet }
    var listeners = List[net.Listener]()
    var ports = List[int]()
    // Each ListenAddress must bind; the default pair needs one of its two
    // (a host without IPv6 loopback still serves 127.0.0.1, as sshd's own
    // default does).
    var bound = List[str]()
    var why = ""
    for e in sconfig.endpoints(s) {
        var ok = true
        let l = net.listen_with(e, net.listen_opts()) else |err| {
            ok = false
            if why == "" {
                why = "{e}: {err}"
            }
            net.Listener { fd: -1 }
        }
        if !ok {
            if s.listen.len > 0 {
                return fail("listen_failed", why)
            }
            continue
        }
        (mut ports).push(net.port(l) else 0)
        (mut listeners).push(l)
        (mut bound).push(e)
    }
    if listeners.len == 0 {
        return fail("listen_failed", why)
    }
    if s.pid_file != "" {
        fs.write_text(s.pid_file, "{env.pid()}\n") else {}
    }
    log(lg, "{stamp()} burrowd[{env.pid()}]: host key {checked[1]}")
    var i = 0
    while i < listeners.len {
        log(lg, "{stamp()} burrowd[{env.pid()}]: listening on {bound[i]}")
        i += 1
    }
    signal.listen(signal.child()) else {}
    signal.ignore(signal.broken_pipe()) else {}
    // px112: the password checks' one token.
    var tk = no_token()
    if s.password_auth {
        let tp = process.pipe() else {
            return fail("io", "a pipe for the password checks")
        }
        tk = Token { on: true, read: copy tp.read, write: copy tp.write }
        var tr = copy tk.read
        fs.set_nonblock(mut tr, true) else {
            return fail("io", "the password checks' pipe cannot be made non-blocking")
        }
        var tw = copy tk.write
        status_byte(mut tw, 1)
    }
    var pool = entropy.system()
    var conns = List[Live]()
    var unauth = 0
    loop {
        var fds = List[int]()
        for l in listeners {
            (mut fds).push(l.fd)
        }
        let ready = net.wait(fds, 50) else List[int]()
        var li = 0
        while li < listeners.len {
            var hit = false
            for r in ready {
                if r == listeners[li].fd {
                    hit = true
                }
            }
            if hit {
                var l = net.Listener { fd: listeners[li].fd }
                let sock = net.accept(mut l) else {
                    li += 1
                    continue
                }
                if drop_it(s, unauth, mut pool) {
                    let ends = peer.of_connection(ports[li])
                    var dl = slog.start(stamp(), env.pid(), ends.client.addr, ends.client.port)
                    dl.outcome = "startups_exceeded"
                    log(lg, slog.format(dl))
                    net.close(take sock) else {}
                } else {
                    let sp = process.pipe() else {
                        net.close(take sock) else {}
                        li += 1
                        continue
                    }
                    let f = process.fork() else {
                        net.close(take sock) else {}
                        li += 1
                        continue
                    }
                    if process.is_child(f) {
                        var k = 0
                        while k < listeners.len {
                            var cl = net.Listener { fd: listeners[k].fd }
                            net.close_listener(take cl) else {}
                            k += 1
                        }
                        var r = sp.read
                        fs.close(take r) else {}
                        if one_process {
                            oneproc_main(take sock, s, ports[li], pre, sp.write, lg)
                        } else {
                            monitor_main(take sock, s, ports[li], pre, sp.write, lg, tk)
                        }
                        process.exit(0)
                        return 0
                    }
                    var w = sp.write
                    fs.close(take w) else {}
                    net.close(take sock) else {}
                    (mut conns).push(Live {
                        child: copy f.child,
                        status: copy sp.read,
                        authed: false,
                        tokens: 0,
                    })
                    unauth += 1
                }
            }
            li += 1
        }
        // The monitors' news: one byte at authentication, the end at theirs.
        var ci = 0
        while ci < conns.len {
            var one = List[fs.File]()
            (mut one).push(copy conns[ci].status)
            let w = signal.wait_fds(one, signal.child(), 0) else signal.Wake {
                meaning: 0,
                ready: -1,
            }
            if w.ready == 0 {
                var sf = copy conns[ci].status
                var ended = false
                let got = fs.read_chunk(mut sf, 1) else {
                    ended = true
                    List[byte]()
                }
                if ended || got.len == 0 {
                    if !conns[ci].authed {
                        unauth -= 1
                    }
                    // A monitor that ended holding the password token: put it back.
                    var back = conns[ci].tokens
                    while back > 0 {
                        var tw = copy tk.write
                        status_byte(mut tw, 1)
                        back -= 1
                    }
                    fs.close(take sf) else {}
                    conns[ci].status = fs.File { fd: -1 }
                    var gone = process.Child { slot: conns[ci].child.slot }
                    let _ = process.wait_status(take gone) else 0
                    var kept = List[Live]()
                    var k = 0
                    while k < conns.len {
                        if k != ci {
                            (mut kept).push(copy conns[k])
                        }
                        k += 1
                    }
                    conns = kept
                    continue
                }
                let b = got[0] as int
                if b == 80 {
                    conns[ci].tokens += 1
                } else if b == 112 {
                    conns[ci].tokens -= 1
                } else if !conns[ci].authed {
                    conns[ci].authed = true
                    unauth -= 1
                }
            }
            ci += 1
        }
    }
    0
}
