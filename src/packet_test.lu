//! member: false

// RFC 4253 §6 framing and PROTOCOL.chacha20poly1305, held to vectorgen's
// independent vectors (src/kexvec, generated by tools/vectorgen.py).
use chachapoly
use kexvec
use packet
use wire

fn x(h: str) -> List[byte] {
    wire.unhex(h) else List[byte]()
}

fn zeros(n: int) -> List[byte] {
    var out = List[byte]()
    var i = 0
    while i < n {
        (mut out).push(0 as byte)
        i += 1
    }
    out
}

fn service_request() -> List[byte] {
    var p = List[byte]()
    wire.put_u8(mut p, 5)
    wire.put_text(mut p, "ssh-userauth")
    p
}

fn refusal_of(buf: List[byte]) -> str {
    var d = packet.plain()
    let o = packet.open(mut d, buf, 0) else |e| {
        return "{e}"
    }
    if o.complete then "ok" else "more"
}

fn main() {
    // Padding: at least 4, the whole frame a multiple of 8.
    // Padding: at least 4; plaintext frames a multiple of 8 as a whole,
    // sealed frames with packet_length a multiple of 8 (the measured rule).
    assert(
        packet.pad_len(17, false) == 10 &&
            packet.pad_len(1, false) == 10 &&
            packet.pad_len(37, false) == 6,
    )
    assert(
        packet.pad_len(179, false) == 8 &&
            packet.pad_len(3, false) == 8 &&
            packet.pad_len(2, false) == 9,
    )
    assert(
        packet.pad_len(17, true) == 6 &&
            packet.pad_len(1, true) == 6 &&
            packet.pad_len(3, true) == 4,
    )
    assert(packet.pad_len(2, true) == 5 && packet.pad_len(305, true) == 6)
    // Plaintext frames equal vectorgen's.
    let sr = service_request()
    assert(
        wire.hex(packet.frame(sr, zeros(packet.pad_len(sr.len, false)))) ==
            kexvec.frame_service_request(),
    )
    var nk = List[byte]()
    wire.put_u8(mut nk, 21)
    assert(wire.hex(packet.frame(nk, zeros(10))) == kexvec.frame_newkeys())
    var ei = List[byte]()
    wire.put_u8(mut ei, 30)
    wire.put_string(mut ei, x(kexvec.q_c()))
    assert(
        wire.hex(packet.frame(ei, zeros(packet.pad_len(ei.len, false)))) ==
            kexvec.frame_ecdh_init(),
    )
    // A plaintext direction: seal, then open what it sealed, seq advancing.
    var out = packet.plain()
    var inn = packet.plain()
    let wire1 = packet.seal(mut out, sr, zeros(10)) else List[byte]()
    assert(out.seq == 1 && wire.hex(wire1) == kexvec.frame_service_request())
    let o = packet.open(mut inn, wire1, 0) else {
        assert(false, "plaintext open refused its own frame")
        return
    }
    assert(o.complete && o.used == wire1.len && wire.hex(o.payload) == wire.hex(sr) && inn.seq == 1)
    // Partial input asks for more and advances nothing.
    var part = packet.plain()
    let p = packet.open(mut part, wire1[0..10], 0) else {
        assert(false, "a partial frame was refused")
        return
    }
    assert(!p.complete && part.seq == 0)
    // Refusals by name.
    assert(refusal_of(x("0000000801000000000000000000")) == "packet_too_short")
    assert(refusal_of(x("00040004")) == "packet_too_long")
    assert(refusal_of(x("0000000d0a00000000000000000000000000")) == "unaligned")
    assert(refusal_of(x("0000000c03050000000000000000000000")) == "padding_short")
    assert(refusal_of(x("0000000c0c050000000000000000000000")) == "padding_overrun")
    // chacha20-poly1305@openssh.com against the vectors.
    let kc = chachapoly.keys(x(kexvec.key_c2s_64()))
    let ks = chachapoly.keys(x(kexvec.key_s2c_64()))
    let f = packet.frame(sr, zeros(6))
    assert(wire.hex(f) == kexvec.sealed_frame_service_request())
    assert(wire.hex(chachapoly.seal(kc, 0, f)) == kexvec.sealed_service_request_seq0())
    assert(wire.hex(chachapoly.seal(kc, 3, f)) == kexvec.sealed_service_request_seq3())
    let big = x(kexvec.sealed_frame_ignore_300())
    assert(
        wire.hex(chachapoly.seal(kc, 4294967295, big)) == kexvec.sealed_ignore_300_seq4294967295(),
    )
    // A keyed direction opens the server's sealed SERVICE_ACCEPT at seq 1.
    var rx = packet.plain()
    packet.take_keys(mut rx, x(kexvec.key_s2c_64()), false)
    rx.seq = 1
    let sealed = x(kexvec.sealed_service_accept_seq1())
    let acc = packet.open(mut rx, sealed, 0) else |e| {
        assert(false, "keyed open refused the vector: {e}")
        return
    }
    assert(acc.complete && acc.payload[0] as int == 6 && rx.seq == 2)
    // A sealed frame aligned the plaintext way (packet_length 28) is unaligned.
    var rx3 = packet.plain()
    packet.take_keys(mut rx3, x(kexvec.key_s2c_64()), false)
    var why3 = "none"
    let _ = packet.open(mut rx3, chachapoly.seal(ks, 0, packet.frame(sr, zeros(10))), 0) else |e| {
        why3 = "{e}"
        packet.Opened { complete: false, payload: List[byte](), used: 0 }
    }
    assert(why3 == "unaligned")
    // One flipped tag byte is mac_mismatch, and so is one flipped body byte.
    var bad = copy sealed
    bad[bad.len - 1] = (bad[bad.len - 1] as int ^ 1) as byte
    var rx2 = packet.plain()
    packet.take_keys(mut rx2, x(kexvec.key_s2c_64()), false)
    rx2.seq = 1
    var why = "none"
    let _ = packet.open(mut rx2, bad, 0) else |e| {
        why = "{e}"
        packet.Opened { complete: false, payload: List[byte](), used: 0 }
    }
    assert(why == "mac_mismatch" && rx2.seq == 1)
    var bad2 = copy sealed
    bad2[9] = (bad2[9] as int ^ 128) as byte
    why = "none"
    let _ = packet.open(mut rx2, bad2, 0) else |e| {
        why = "{e}"
        packet.Opened { complete: false, payload: List[byte](), used: 0 }
    }
    assert(why == "mac_mismatch")
    // The wrong sequence number is the wrong nonce: mac_mismatch too.
    rx2.seq = 2
    why = "none"
    let _ = packet.open(mut rx2, sealed, 0) else |e| {
        why = "{e}"
        packet.Opened { complete: false, payload: List[byte](), used: 0 }
    }
    assert(
        why == "packet_too_long" ||
            why == "packet_too_short" ||
            why == "unaligned" ||
            why == "mac_mismatch",
    )
    // Strict kex: take_keys resets the sequence number only when strict.
    var tx = packet.plain()
    tx.seq = 3
    packet.take_keys(mut tx, x(kexvec.key_c2s_64()), false)
    assert(tx.seq == 3)
    packet.take_keys(mut tx, x(kexvec.key_c2s_64()), true)
    assert(tx.seq == 0)
    let s0 = packet.seal(mut tx, sr, zeros(6)) else List[byte]()
    assert(wire.hex(s0) == kexvec.sealed_service_request_seq0() && tx.seq == 1 && tx.packets == 1)
    // A keyed sequence number that wraps refuses the packet after it.
    tx.seq = 4294967295
    let last = packet.seal(mut tx, sr, zeros(6)) else List[byte]()
    assert(last.len > 0 && tx.seq == 0 && tx.wrapped)
    why = "none"
    let _ = packet.seal(mut tx, sr, zeros(6)) else |e| {
        why = "{e}"
        List[byte]()
    }
    assert(why == "sequence_wrapped")
    print("packet: 9 groups, 0 SKIP")
}
