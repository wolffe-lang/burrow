//! member: false

// B5: burrowd's command line and configuration: sshd_config(5)'s defaults,
// first value wins with the command line first, loopback by default
// (R-bw04-6), `-T`'s lines, and every refusal by name.
use sconfig

fn args(s: str) -> List[str] {
    var out = List[str]()
    for w in s.words() {
        (mut out).push(w)
    }
    out
}

fn refused(s: sconfig.Settings) -> str {
    if s.refusal == "" then "ok" else s.refusal
}

fn file(text: str) -> sconfig.Settings {
    var s = sconfig.parse_args(List[str]())
    sconfig.apply_file(mut s, text, "/etc/burrowd/burrowd_config")
    s
}

fn has(lines: List[str], want: str) -> bool {
    for l in lines {
        if l == want {
            return true
        }
    }
    false
}

fn prefixed(lines: List[str], p: str) -> int {
    var n = 0
    for l in lines {
        if l.starts_with(p) {
            n += 1
        }
    }
    n
}

fn main() {
    // sshd_config(5)'s defaults, and loopback alone.
    let d = sconfig.parse_args(List[str]())
    assert(d.port == 22 && d.grace == 120 && d.max_tries == 6)
    assert(d.startups_begin == 10 && d.startups_rate == 30 && d.startups_full == 100)
    assert(d.strict_modes && d.authorized_files == ".ssh/authorized_keys .ssh/authorized_keys2")
    let e = sconfig.endpoints(d)
    assert(e.len == 2 && e[0] == "127.0.0.1:22" && e[1] == "[::1]:22")
    let t = sconfig.effective(d)
    assert(
        has(t, "logingracetime 120") && has(t, "maxauthtries 6") && has(t, "maxstartups 10:30:100"),
    )
    assert(has(t, "permitrootlogin no") && has(t, "listenaddress 127.0.0.1:22"))
    // Flags, bundled and apart; -o both ways.
    let a = sconfig.parse_args(
        args("-De -f /x/cfg -h /x/key -p 2222 -g 2m -o MaxAuthTries=3 -oStrictModes=no -t"),
    )
    assert(
        refused(a) == "ok" && a.log_stderr && a.config_file == "/x/cfg" && a.host_key == "/x/key",
    )
    assert(a.port == 2222 && a.grace == 120 && a.max_tries == 3 && !a.strict_modes && a.test_only)
    let a2 = sconfig.parse_args(args("-g 1h30m -E /x/log -q -T"))
    assert(a2.grace == 5400 && a2.log_file == "/x/log" && a2.quiet && a2.print_config)
    // The command line wins over the file; in the file the first value wins.
    var w = sconfig.parse_args(args("-p 2222"))
    sconfig.apply_file(mut w, "Port 3333\nLoginGraceTime 5\nLoginGraceTime 9\n", "f")
    assert(w.port == 2222 && w.grace == 5)
    // ListenAddress forms; AcceptEnv accumulates.
    let l = file(
        "Port 2200\nListenAddress 127.0.0.1\nListenAddress [::1]:2201\nListenAddress 127.0.0.1:2202\nListenAddress ::1\nAcceptEnv GIT_PROTOCOL\n",
    )
    let le = sconfig.endpoints(l)
    assert(
        le.len == 4 &&
            le[0] == "127.0.0.1:2200" &&
            le[1] == "[::1]:2201" &&
            le[2] == "127.0.0.1:2202" &&
            le[3] == "[::1]:2200",
    )
    assert(l.accept_env.len == 1)
    // Keywords with burrowd's one value, the equivalents of an sshd row's.
    let fixed = file(
        "PasswordAuthentication no\nKbdInteractiveAuthentication no\nPubkeyAuthentication yes\nPermitRootLogin no\nX11Forwarding no\nAllowTcpForwarding no\nDisableForwarding yes\nPermitTTY no\nPerSourcePenalties no\nCiphers chacha20-poly1305@openssh.com\nKexAlgorithms curve25519-sha256\nHostKeyAlgorithms ssh-ed25519\nAuthenticationMethods publickey\nMaxStartups 3\nRekeyLimit 256K\nStrictModes yes\n# a comment\n\n",
    )
    assert(
        refused(fixed) == "ok" &&
            fixed.startups_full == 3 &&
            fixed.startups_begin == 3 &&
            fixed.rekey_bytes == 262144,
    )
    // Refusals by name.
    // px112: PasswordAuthentication takes yes or no, no by default, and
    // -T says which.
    assert(!d.password_auth && has(t, "passwordauthentication no"))
    let pw = file("PasswordAuthentication yes\n")
    assert(
        refused(pw) == "ok" &&
            pw.password_auth &&
            has(sconfig.effective(pw), "passwordauthentication yes"),
    )
    assert(refused(file("PasswordAuthentication maybe\n")) == "config_unsupported")
    assert(!file("PasswordAuthentication no\nPasswordAuthentication yes\n").password_auth)
    // bw06: PermitTTY takes yes or no, yes by default (as sshd), and -T says which.
    assert(d.permit_tty && has(t, "permittty yes"))
    let tty_no = file("PermitTTY no\n")
    assert(refused(tty_no) == "ok" && !tty_no.permit_tty && has(sconfig.effective(tty_no), "permittty no"))
    assert(file("PermitTTY yes\n").permit_tty && !file("PermitTTY no\nPermitTTY yes\n").permit_tty)
    assert(refused(file("PermitTTY maybe\n")) == "config_unsupported")
    assert(refused(file("PermitRootLogin prohibit-password\n")) == "config_unsupported")
    assert(refused(file("AcceptEnv LANG LC_*\n")) == "config_unsupported")
    assert(refused(file("Subsystem sftp /usr/lib/sftp-server\n")) == "config_unsupported")
    assert(refused(file("Match User x\n")) == "config_unsupported")
    assert(refused(file("Ciphers aes128-ctr\n")) == "config_unsupported")
    assert(refused(file("AuthorizedKeysFile %h/.ssh/keys %d\n")) == "config_unsupported")
    assert(refused(file("Frobnicate yes\n")) == "config_unknown")
    assert(
        file("Frobnicate yes\n").detail ==
            "/etc/burrowd/burrowd_config line 1: Frobnicate, which sshd_config(5) does not list",
    )
    assert(refused(file("LoginGraceTime soon\n")) == "config_unsupported")
    assert(refused(file("MaxStartups 10:30\n")) == "config_unsupported")
    assert(refused(sconfig.parse_args(args("-d"))) == "option_unsupported")
    assert(refused(sconfig.parse_args(args("-C user=x"))) == "option_unsupported")
    assert(refused(sconfig.parse_args(args("-Z"))) == "option_unknown")
    assert(refused(sconfig.parse_args(args("-p"))) == "usage")
    assert(refused(sconfig.parse_args(args("extra"))) == "usage")
    // px116: SetEnv (sshd_config(5)), held to the pinned sshd's -T and -t:
    // the first line wins, and in it the first value of a name; quotes
    // around a whole argument or part of one; `#` ends the list.
    let se = file("SetEnv A=1 \"B=x y\" C=\"p q\" A=2 E= # c\nSetEnv D=3\n")
    assert(refused(se) == "ok")
    let st = sconfig.effective(se)
    assert(
        has(st, "setenv A=1") &&
            has(st, "setenv B=x y") &&
            has(st, "setenv C=p q") &&
            has(st, "setenv E="),
    )
    assert(prefixed(st, "setenv ") == 4)
    assert(has(sconfig.effective(file("SetEnv \"A=x y\"\n")), "setenv A=x y"))
    assert(has(sconfig.effective(file("setenv=A=b=c\n")), "setenv A=b=c"))
    assert(prefixed(t, "setenv") == 0)
    assert(refused(file("SetEnv FOO\n")) == "config_unsupported")
    assert(
        file("SetEnv A=1 FOO\n").detail ==
            "/etc/burrowd/burrowd_config line 1: SetEnv FOO: not NAME=VALUE",
    )
    // `SetEnv =x` is the keyword, its `=` separator and the argument `x`
    // (sshd_config's `keyword=value` form): `x` is refused. An argument
    // with nothing before its `=` is refused as itself.
    assert(
        file("SetEnv =x\n").detail ==
            "/etc/burrowd/burrowd_config line 1: SetEnv x: not NAME=VALUE",
    )
    assert(
        file("SetEnv A=1 =x\n").detail ==
            "/etc/burrowd/burrowd_config line 1: SetEnv =x: not NAME=VALUE",
    )
    assert(
        file("SetEnv A=\"x\n").detail ==
            "/etc/burrowd/burrowd_config line 1: SetEnv: invalid quotes",
    )
    // A later line counts for nothing, but a malformed one is refused.
    assert(
        file("SetEnv A=1\nSetEnv FOO\n").detail ==
            "/etc/burrowd/burrowd_config line 2: SetEnv FOO: not NAME=VALUE",
    )
    // -o, the command line's, wins over the file's line.
    var so = sconfig.parse_args(args("-oSetEnv=A=cli"))
    sconfig.apply_file(mut so, "SetEnv A=file B=file\n", "f")
    assert(refused(so) == "ok" && so.set_env.len == 1 && so.set_env[0] == "A=cli")
    // The arguments' split.
    let q = sconfig.words("a \"b c\" d=\"e f\"g  # h")
    assert(
        q.ok &&
            q.words.len == 3 &&
            q.words[0] == "a" &&
            q.words[1] == "b c" &&
            q.words[2] == "d=e fg",
    )
    assert(!sconfig.words("a=\"b").ok && sconfig.words("").words.len == 0)
    // A session's environment: the defaults, the accepted names, SetEnv's,
    // then SSH_CONNECTION and SSH_ORIGINAL_COMMAND, one entry per name.
    var base = List[str]()
    (mut base).push("USER=u")
    (mut base).push("HOME=/home/u")
    (mut base).push("PATH=/usr/bin:/bin")
    var acc = List[str]()
    (mut acc).push("GIT_PROTOCOL=version=2")
    var late = List[str]()
    (mut late).push("SSH_CONNECTION=1 2 3 4")
    (mut late).push("SSH_ORIGINAL_COMMAND=asked")
    let sv = file(
        "SetEnv WOLF_STD=/w PATH=/x:/usr/bin GIT_PROTOCOL=s SSH_CONNECTION=no SSH_ORIGINAL_COMMAND=no\n",
    )
    let merged = sconfig.environment(base, acc, sv.set_env, late)
    assert(merged.len == 7)
    assert(merged[0] == "USER=u" && merged[1] == "HOME=/home/u" && merged[2] == "PATH=/x:/usr/bin")
    assert(merged[3] == "GIT_PROTOCOL=s" && merged[4] == "WOLF_STD=/w")
    assert(merged[5] == "SSH_CONNECTION=1 2 3 4" && merged[6] == "SSH_ORIGINAL_COMMAND=asked")
    let plain = sconfig.environment(base, acc, List[str](), late)
    assert(
        plain.len == 6 && plain[2] == "PATH=/usr/bin:/bin" && plain[3] == "GIT_PROTOCOL=version=2",
    )
    // TIME FORMATS.
    assert(
        sconfig.seconds("600") == 600 &&
            sconfig.seconds("10m") == 600 &&
            sconfig.seconds("1h30m") == 5400,
    )
    assert(sconfig.seconds("2") == 2 && sconfig.seconds("m") == -1 && sconfig.seconds("") == -1)
}
