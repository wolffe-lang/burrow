//! member: true
//!
//! burrow.ptyhost — the one place burrowd reaches the host's pseudo-terminals
//! and new sessions (bw06), over wolf-std's (sc81: `term.open_pty`,
//! `term.pty_name`, `term.set_size`, `term.set_attr`, `term.open_controlling`,
//! `process.lead_session`). A session's holder opens the pty, sizes it and
//! sets the client's modes on the master; the program's child leads a session
//! of its own and takes the slave, by name, as its controlling terminal.
//!
//! **The modes** are RFC 4254 §8's opcodes, which are wolf-std's vocabulary
//! too: each pair the client sent is set on its own, and one the host lacks,
//! one outside the vocabulary, or a value outside its op's range is passed
//! over (as `sshd` does), and counted. A special character's 255 ("none") is
//! std's -1; a flag's non-zero is 1.

use std.fs
use std.process
use std.term
use ttymodes

/// A pty: its master and slave, both close-on-exec, and the slave's name,
/// which the program's child opens as its controlling terminal.
pub struct Pty {
    master: fs.File,
    slave: fs.File,
    name: str,
}

/// What a pty call answers when the host gives none.
pub error Unready = {io, unsupported}

/// What the move into a session of its own answers.
pub error Unled = {denied, io, unsupported}

/// Whether this build can open a pty and start a session.
pub fn available() -> bool {
    true
}

/// A new pty, its slave granted and unlocked, and the slave's name.
pub fn open() -> Pty ! Unready {
    let p = term.open_pty()?
    var failed = false
    let name = term.pty_name(p.master) else {
        failed = true
        ""
    }
    if failed {
        var m = copy p.master
        fs.close(take m) else {}
        var s = copy p.slave
        fs.close(take s) else {}
        return io
    }
    Pty { master: copy p.master, slave: copy p.slave, name: name }
}

/// The pty's size: `rows` lines of `cols` cells, and the pixel sizes (0 for
/// none), on the master; the host sends SIGWINCH to the foreground group
/// when it changes.
pub fn set_size(tty: fs.File, rows: int, cols: int, xpixels: int, ypixels: int) -> () ! Unready {
    term.set_size(tty, term.Size { rows: rows, columns: cols }, xpixels, ypixels) else |e| match e {
        unsupported => { return unsupported },
        _ => { return io },
    }
}

// A §8 value as std's: 255 for a special character is -1, a flag is 0 or 1.
fn value_of(op: int, v: int) -> int {
    if ttymodes.is_char(op) {
        return if v == ttymodes.none_char() then -1 else v
    }
    if op >= 30 && op <= 93 {
        return if v == 0 then 0 else 1
    }
    v
}

/// The client's modes (RFC 4254 §8, as `pty-req` carried them) on `tty`,
/// each on its own; the answer is how many were passed over.
pub fn set_modes(tty: fs.File, modes: List[byte]) -> int {
    let m = ttymodes.decode(modes)
    var skipped = 0
    var i = 0
    while i + 1 < m.pairs.len {
        let op = m.pairs[i]
        term.set_attr(tty, op, value_of(op, m.pairs[i + 1])) else {
            skipped += 1
        }
        i += 2
    }
    skipped
}

/// In the program's child, after `lead_session`: the slave `name` opened as
/// this process's controlling terminal, its group the foreground.
pub fn take_terminal(name: str) -> fs.File ! Unready {
    term.open_controlling(name) else |e| match e {
        unsupported => { return unsupported },
        _ => { return io },
    }
}

/// This process (a fork that leads no group) into a session of its own,
/// with no controlling terminal.
pub fn lead_session() -> () ! Unled {
    process.lead_session()?
}
