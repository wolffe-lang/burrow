//! member: false

// burrow — an ssh client: the transport (B1), publickey authentication
// with Ed25519 keys (B2), and one command on a session channel (B3).
//
//   ssh [-Tv] [-F configfile] [-i identity_file] [-l login_name]
//       [-o option] [-p port] [--] destination [command [argument ...]]
//
// It is the command line den's ssh transport passes (src/config). The exit
// status is the remote command's, or 255 for every refusal, as ssh(1)
// says; a refusal prints the pinned ssh's line for it where it has one,
// then `burrow: <name>: <detail>`.
//
// Options for the rows, each load or size only and held inert for security
// by a transport row (`test-*-inert`): --test-traffic=BYTES sends that many
// bytes of IGNORE messages after authentication, then a PING, and stops (the
// rekey rows' load); --test-preauth sends that traffic once more before
// authentication; and --test-window=BYTES makes the session channel's own
// window that small (the hostile rows' window refusal). There is no
// strict-kex waiver on any tier: `--no-strict-kex` is an unknown option.
//
// Clean room: RFCs 4250-4254, 4344, 8308, 8709, 8731, FIPS 180-4, RFC 2104
// and OpenSSH's PROTOCOL notes and man pages (docs/SOURCES.md); no ssh
// implementation's source.
use std.env
use std.fs
use auth
use channel
use config
use keyfile
use refuse
use session
use transport
use wire

fn program() -> str {
    let a = env.arg0()
    let slash = a.rfind("/") else -1
    let base = a[slash + 1..a.len]
    if base.len == 0 then "burrow" else base
}

// Sends IGNORE messages carrying `total` bytes, then a PING, and waits for
// the PONG: the traffic rows' load, under which re-exchanges happen.
fn traffic(mut c: transport.Conn, total: int) -> () ! refuse.Refusal {
    var data = List[byte]()
    var i = 0
    while i < 1000 {
        (mut data).push((i % 251) as byte)
        i += 1
    }
    var sent = 0
    while sent < total {
        region turn {
            var p = List[byte]()
            wire.put_u8(mut p, refuse.msg_ignore())
            wire.put_string(mut p, data)
            transport.send(mut c, p)?
        }
        sent += data.len
    }
    var ping = List[byte]()
    wire.put_u8(mut ping, refuse.msg_ping())
    wire.put_text(mut ping, "burrow traffic {total}")
    transport.send(mut c, ping)?
    var back = transport.next(mut c)?
    while transport.kind(back) == refuse.msg_global_request() {
        // The pinned sshd announces its host keys after a login
        // (`hostkeys-00@openssh.com`, `PROTOCOL` §2.5); declined.
        var r = wire.reader(back[1..back.len])
        let name = wire.read_utf8(mut r) else ""
        let want = wire.read_bool(mut r) else false
        if c.opts.verbose > 0 {
            eprint("debug1: global request {name} (want reply {want}): declined")
        }
        if want {
            var no = List[byte]()
            wire.put_u8(mut no, refuse.msg_request_failure())
            transport.send(mut c, no)?
        }
        back = transport.next(mut c)?
    }
    if transport.kind(back) != refuse.msg_pong() ||
        wire.hex(back[1..back.len]) != wire.hex(ping[1..ping.len]) {
        transport.note(mut c, "message {transport.kind(back)} in answer to PING")
        return message_unexpected
    }
    eprint(
        "burrow: traffic: {total} bytes sent; rekeys: {c.by_us} by burrow, {c.by_server} by the server; PONG received",
    )
}

fn refusal(name: str, detail: str) -> int {
    eprint("burrow: {name}: {detail}")
    255
}

// The identities to offer: each file that exists, loaded and checked. A
// file named on the command line or in the config that cannot be used is
// refused before any connection (its refusal's name in `refused`); the
// default ~/.ssh/id_ed25519 is skipped when absent.
struct Ids {
    keys: List[keyfile.Key],
    refused: str,
}

fn identities(s: config.Settings, explicit: bool) -> Ids {
    var ids = Ids { keys: List[keyfile.Key](), refused: "" }
    for path in s.identities {
        if !fs.exists(path) {
            if explicit {
                eprint("Warning: Identity file {path} not accessible: No such file or directory.")
            }
            continue
        }
        var name = ""
        let k = keyfile.load(path) else |e| {
            name = "{e}"
            keyfile.Key { seed: List[byte](), public: List[byte](), comment: "" }
        }
        if name != "" {
            if name == "key_permissions" {
                eprint("@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@")
                eprint("@         WARNING: UNPROTECTED PRIVATE KEY FILE!          @")
                eprint("@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@")
                eprint("It is required that your private key files are NOT accessible by others.")
            }
            eprint("burrow: {name}: {path} (no key bytes are printed)")
            ids.refused = name
            return ids
        }
        (mut ids.keys).push(k)
    }
    ids
}

fn local_user() -> str {
    let u = env.get("USER") else ""
    if u != "" {
        return u
    }
    env.get("LOGNAME") else ""
}

fn run(s: config.Settings) -> int {
    let ids = identities(s, s.ids_explicit)
    if ids.refused != "" {
        return 255
    }
    let keys = ids.keys
    var why = ""
    var opts = transport.options(s.hostname, s.port)
    opts.known_hosts = copy s.known_hosts
    opts.strict = s.strict
    opts.hash_known = s.hash_known
    opts.key_alias = s.key_alias
    opts.verbose = s.verbose
    if s.traffic > 0 || s.test_window > 0 {
        opts.allow_no_strict = true
    }
    if s.rekey_bytes > 0 {
        opts.rekey_bytes = s.rekey_bytes
    }
    if s.rekey_seconds > 0 {
        opts.rekey_seconds = s.rekey_seconds
    }
    if s.connect_timeout > 0 {
        opts.timeout_ms = s.connect_timeout * 1000
    }
    var c = transport.dial(opts) else |e| {
        let name = "{e}"
        if name == "connect_refused" {
            eprint("{program()}: connect to host {s.hostname} port {s.port}: Connection refused")
        } else if name == "timeout" {
            eprint("{program()}: connect to host {s.hostname} port {s.port}: Connection timed out")
        } else {
            eprint("{program()}: connect to host {s.hostname} port {s.port}: failed")
        }
        return refusal(name, "connect to host {s.hostname} port {s.port}")
    }
    var ok = true
    transport.start(mut c) else |e| {
        ok = false
        why = "{e}"
    }
    if ok {
        transport.service(mut c, "ssh-userauth") else |e| {
            ok = false
            why = "{e}"
        }
    }
    if ok && s.preauth && s.traffic > 0 {
        // The pre-authentication rekey row: traffic before the login, where
        // the pinned sshd refuses a re-exchange.
        traffic(mut c, s.traffic) else |e| {
            ok = false
            why = "{e}"
        }
    }
    if ok {
        auth.login(mut c, s.user, s.hostname, keys) else |e| {
            ok = false
            why = "{e}"
        }
    }
    var code = 0
    var ch = if s.test_window > 0 {
        channel.sized(s.test_window, channel.local_max())
    } else {
        channel.new()
    }
    if ok && s.traffic > 0 {
        traffic(mut c, s.traffic) else |e| {
            ok = false
            why = "{e}"
        }
        if ok {
            transport.disconnect(mut c, 11, "disconnected by user")
        }
    } else if ok {
        var command = wire.bytes_of(config.remote_command(s))
        var env_pairs = List[str]()
        for entry in env.vars() {
            let name = env.entry_key(entry)
            for pat in s.send_env {
                if config.env_match(pat, name) {
                    (mut env_pairs).push("{name}={env.entry_value(entry)}")
                    break
                }
            }
        }
        for kv in s.set_env {
            (mut env_pairs).push(kv)
        }
        let plan = session.Plan { command: command, env: env_pairs, verbose: s.verbose }
        code = session.run(mut c, mut ch, plan) else |e| {
            ok = false
            why = "{e}"
            255
        }
    }
    if !ok {
        if why != "closed" && why != "timeout" && why != "io" && why != "disconnected" {
            transport.disconnect(mut c, refuse.reason_of(why), why)
        }
        let d = if channel.detail(ch) != "" then channel.detail(ch) else transport.detail(c)
        transport.close(take c)
        return refusal(why, d)
    }
    transport.close(take c)
    code
}

fn main() -> int {
    var s = config.parse_args(env.args())
    let home = env.get("HOME") else ""
    if s.refusal == "" {
        let file = if s.config_file != "" then s.config_file else home + "/.ssh/config"
        if s.config_file.lower() != "none" && fs.exists(file) {
            let text = fs.read_text(file) else {
                eprint("burrow: config_unsupported: {file} cannot be read")
                return 255
            }
            let shown = if s.config_file != "" then file else "~/.ssh/config"
            config.apply_config(mut s, text, shown)
        }
    }
    if s.refusal == "" {
        config.finish(mut s, home, local_user())
        if s.command.len == 0 && s.traffic == 0 {
            s.refusal = "shell_unsupported"
            s.detail = "no command: burrow runs one command on a session channel; an interactive shell is not in B3"
        }
    }
    if s.refusal != "" {
        if s.line != "" {
            eprint(s.line)
        }
        if s.refusal == "usage" || s.line.starts_with("unknown option") {
            eprint(config.usage())
        }
        return refusal(s.refusal, s.detail)
    }
    run(s)
}
