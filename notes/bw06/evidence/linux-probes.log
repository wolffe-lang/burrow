# bw06 phase 1, linux: the pinned container (Ubuntu 24.04 by digest), two CPUs, linux 7.2.4 x86_64.
# Take 1 at 54bb2efb2f0145a0b08d490fec44b4456b279ecc: the probes built with the pinned wolf 0.2.37 and wolf-std 2411d868, run as root and as the rows' account.
START build-probes
END build-probes exit=0 secs=2
START ptyprobe-root
  S0 host linux x86_64
  S1 open /dev/ptmx (mode 3): ok
  S2 is_terminal(master): true
  S3 term.size(master): 0 0
  S4 term.mode(master): pack 287
  S5 fdinfo tty-index: none
  F1 posix_openpt, grantpt, unlockpt, ptsname: fd ok, slave /dev/pts/N
  F2 a read of the master before any slave open: deadline, 0 bytes
  F3 term.size(master), never set: 0 0
  F4 the child's line and the shell's ready: seen
  F4 bytes: child: setsid pid; /dev/tty ok; foreground its group; size N N; mode pack N\r\nready\r\n
  F5 0x03 written (1); the shell: seen; bytes ^C\r\ncaught INT\r\n
  F5 the shell's status: 7
  F6 the master after the slave's last close: io os_error 5, 0 more bytes
  F7 the slave's name after the master's close: gone
  END
END ptyprobe-root exit=0 secs=1
START ptyprobe-account
  S0 host linux x86_64
  S1 open /dev/ptmx (mode 3): ok
  S2 is_terminal(master): true
  S3 term.size(master): 0 0
  S4 term.mode(master): pack 287
  S5 fdinfo tty-index: none
  F1 posix_openpt, grantpt, unlockpt, ptsname: fd ok, slave /dev/pts/N
  F2 a read of the master before any slave open: deadline, 0 bytes
  F3 term.size(master), never set: 0 0
  F4 the child's line and the shell's ready: seen
  F4 bytes: child: setsid pid; /dev/tty ok; foreground its group; size N N; mode pack N\r\nready\r\n
  F5 0x03 written (1); the shell: seen; bytes ^C\r\ncaught INT\r\n
  F5 the shell's status: 7
  F6 the master after the slave's last close: io os_error 5, 0 more bytes
  F7 the slave's name after the master's close: gone
  END
END ptyprobe-account exit=0 secs=1
START ptyprobe-ioctl
  I1 TIOCSWINSZ 40x132 on the master: 0; term.size(master) 40 132
  I2 TIOCSWINSZ 50x100 on the master: 0
  I3 child: size 40 132
  I3 child: SIGWINCH; size 50 100
  I4 the child's status: 0; pid true
  END
END ptyprobe-ioctl exit=0 secs=1
# Take 2 at 94b9cb3564b0fbb7d992b8e5c9657c995ef46587: the pinned sshd, black box (sshd_pty.py), then the background child (sshd_pty_hold.py).
