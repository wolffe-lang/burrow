START sshd-pty-hold
  CASE control-T-nohup
    exit 0
    stdout b'started\n'
    stderr b''
    took 0.1 s; after 0.5 s: [['12', 'burrowt+', '11', '11', '?', 'S', 'sleep']]; sleep 12 SigIgn 0000000000000007
  CASE tt-hup-ignored-child
    exit 0
    stdout b'     17      15      15 ?        S    sshd-session\r\n     18      18      18 pts/0    Ss+  sh\r\n     19      18      18 pts/0    S+   sleep\r\n     21      18      18 pts/0    R+   ps\r\nSigIgn:\t0000000000000007\r\nstarted\r\n'
    stderr b'Connection to 127.0.0.1 closed.\r\n'
    took 0.5 s; after 0.5 s: [['19', 'burrowt+', '18', '18', '?', 'S', 'sleep']]; sleep 19 SigIgn 0000000000000007
  CASE tt-hup-ignored-child-detached-stdio
    exit 0
    stdout b'started\r\n'
    stderr b'Connection to 127.0.0.1 closed.\r\n'
    took 0.1 s; after 0.5 s: []
  CASE tt-plain-child
    exit 0
    stdout b'started\r\n'
    stderr b'Connection to 127.0.0.1 closed.\r\n'
    took 0.4 s; after 0.5 s: []
  CASE tt-setsid-child
    exit 0
    stdout b'started\r\n'
    stderr b'Connection to 127.0.0.1 closed.\r\n'
    took 0.4 s; after 0.5 s: [['44', 'burrowt+', '44', '44', '?', 'Ss', 'sleep']]; sleep 44 SigIgn 0000000000000006
  END
END sshd-pty-hold exit=0 secs=39
