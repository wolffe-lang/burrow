# ---- fetch ---------------------------------------------------------------------
@row
def den_fetch_incremental():
    with Row("den-fetch-incremental") as w:
        first, second = w.fx.seed()
        tpl = w.fx.path("plain.git")
        snapshot = w.d / "first.git"
        git(w.fx, "clone", "-q", "--bare", "--no-local", tpl, snapshot)
        git(w.fx, "update-ref", "refs/heads/main", second, cwd=tpl)
        r = w.pair(["fetch", "-q", "--upload-pack=" + w.fx.upload, lambda w: w.uri("plain.git"),
                    "refs/heads/main:refs/heads/main"],
                   prepare=lambda local: write_objects(w.fx, local, snapshot, first), repos=("plain.git",), cwd_local=True)
        quiet(r)
        v2(r, "upload")
        check(f"refs/heads/main {second}" in r["local"]["refs"], f"main after fetch: {r['local']['refs']}")
        check(r["local"]["objects"] == r["server"]["plain.git"]["objects"], "the fetched objects are not the server's")
        return f"main {first[:12]} -> {second[:12]}, {len(r['local']['objects'])} objects"


# ---- push ----------------------------------------------------------------------
def source_repo(w, head_at="second"):
    """The local repository a push starts from: both commits' objects, main
    at `head_at`."""
    first, second = w.fx.seed()
    tpl = w.fx.path("plain.git")
    full = w.d / "full.git"
    git(w.fx, "update-ref", "refs/heads/main", second, cwd=tpl)
    git(w.fx, "clone", "-q", "--bare", "--no-local", tpl, full)
    head = second if head_at == "second" else first
    return first, second, (lambda local: write_objects(w.fx, local, full, head))


def push_row(name, scp):
    with Row(name) as w:
        _, second, prep = source_repo(w)
        w.fx.empty("push.git")
        url = (lambda w: w.scp("push.git")) if scp else (lambda w: w.uri("push.git"))
        r = w.pair(["push", "-q", "--receive-pack=" + w.fx.receive, url, "HEAD:refs/heads/main"],
                   prepare=prep, repos=("push.git",), cwd_local=True)
        quiet(r)
        v2(r, "receive")
        st = r["server"]["push.git"]
        check(st["refs"] == [f"refs/heads/main {second}"], f"server refs {st['refs']}")
        check(st["objects"] == r["local"]["objects"] and st["fsck"][0] == 0, "the server's objects or fsck")
        return f"main {second[:12]}, {len(st['objects'])} objects, fsck clean"


@row
def den_push_uri():
    return push_row("den-push-uri", scp=False)


@row
def den_push_scp():
    return push_row("den-push-scp", scp=True)


def lease_row(name, matching):
    with Row(name) as w:
        first, second, prep = source_repo(w, head_at="first")
        expected = second if matching else first
        r = w.pair(["push", "-q", "--receive-pack=" + w.fx.receive, f"--force-with-lease=refs/heads/main:{expected}",
                    lambda w: w.uri("plain.git"), "HEAD:refs/heads/main"],
                   prepare=prep, repos=("plain.git",), cwd_local=True)
        st = r["server"]["plain.git"]
        if matching:
            quiet(r)
            check(f"refs/heads/main {first}" in st["refs"], f"server refs {st['refs']}")
            return f"exit 0, main rewound to {first[:12]}"
        check(r["exit"] != 0 and b"stale info" in r["stderr"], f"exit {r['exit']}, stderr {tail(r['stderr'])!r}")
        check(f"refs/heads/main {second}" in st["refs"], f"server refs changed: {st['refs']}")
        return f"exit {r['exit']}, stale info, main kept at {second[:12]}"


@row
def den_lease_stale():
    return lease_row("den-lease-stale", matching=False)


@row
def den_lease_matching():
    return lease_row("den-lease-matching", matching=True)


@row
def den_push_atomic():
    with Row("den-push-atomic") as w:
        first, second, prep = source_repo(w)
        tpl = w.fx.path("plain.git")
        git(w.fx, "update-ref", "refs/heads/main", first, cwd=tpl)
        r = w.pair(["push", "-q", "--atomic", "--receive-pack=" + w.fx.receive, lambda w: w.uri("plain.git"),
                    "HEAD:refs/heads/a", "HEAD:refs/heads/b"],
                   prepare=prep, repos=("plain.git",), cwd_local=True)
        quiet(r)
        st = r["server"]["plain.git"]
        check(f"refs/heads/a {second}" in st["refs"] and f"refs/heads/b {second}" in st["refs"], f"server refs {st['refs']}")
        return "a and b created together"


