def keep_evidence(tier):
    out = ROOT / "target" / "evidence" / f"den-{tier}"
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    kept = 0
    for d in sorted(p for p in WORK.iterdir() if p.is_dir()):
        for rel in ("sshd/sshd.log", "compare.txt", "fixture/protocol.log"):
            src = d / rel
            if src.is_file():
                dst = out / d.name / src.name
                dst.parent.mkdir(exist_ok=True)
                shutil.copyfile(src, dst)
                kept += 1
    bad = []
    for p in [out.parent, out] + sorted(out.rglob("*")):
        os.chmod(p, 0o755 if p.is_dir() else 0o644)
        if p.is_file():
            data = p.read_bytes()
            if p.name.startswith(("host_", "id_")) or p.suffix == ".pub":
                bad.append(f"{p.relative_to(ROOT)} is a key file")
            elif b"PRIVATE KEY" in data or b"b3BlbnNzaC1rZXktdjE" in data:
                bad.append(f"{p.relative_to(ROOT)} holds private key text")
    for why in bad:
        print(f"FAIL evidence {why}", flush=True)
    if not bad:
        print(f"check-den: {kept} evidence files in {out.relative_to(ROOT)}, readable, no key material")
    return len(bad)


def main():
    global BIN, KEYGEN_BIN, WORK
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", required=True)
    ap.add_argument("--only", nargs="*")
    a = ap.parse_args()
    BIN = pathlib.Path(a.bin).resolve()
    KEYGEN_BIN = BIN.parent / "burrow-keygen"
    for b in (BIN, KEYGEN_BIN):
        if not b.exists():
            print(f"FAIL setup no binary at {b}")
            sys.exit(1)
    oraclelib.require_oracle()
    require_den()
    os.umask(0o022)
    tier = BIN.parent.name
    WORK = ROOT / "target" / f"den-{tier}"
    WORK.mkdir(parents=True, exist_ok=True)
    os.chmod(WORK, 0o711)
    print(f"check-den: den {PIN['den']['rev'][:12]} sha256 {sha(DEN)[:16]}; git {sha(GIT)[:16]}; burrow {tier} sha256 {sha(BIN)[:16]}",
          flush=True)
    fails = ran = 0
    for fn in ROWS:
        name = fn.__name__.replace("_", "-")
        if a.only and name not in a.only:
            continue
        ran += 1
        try:
            note = fn()
            print(f"PASS {name}" + (f" ({note})" if note else ""), flush=True)
        except Fail as e:
            fails += 1
            print(f"FAIL {name} {e}", flush=True)
        except Exception as e:  # a harness fault is a red row too, by name
            fails += 1
            print(f"FAIL {name} harness: {type(e).__name__}: {e}", flush=True)
    print(f"check-den: {ran} rows, {fails} failed, 0 SKIP")
    fails += keep_evidence(tier)
    sys.exit(min(fails, 100))


if __name__ == "__main__":
    main()
