#!/usr/bin/env python3
r"""check-server-local — burrowd as the invoking user, burrow's own client, no oracle.

    python3 -I tools/check-server-local --bin target/native/burrowd

The macOS rows (and any host without the pinned container): burrowd runs
unprivileged, serving the user who runs it (on macOS it can do nothing
else: std cannot change a process's ids there), on 127.0.0.1, with a host
key and a user key made by burrow-keygen for the run under a scratch HOME.
burrow is the client. There is no pinned sshd on such a host, so these rows
hold burrowd to its own behaviour on Linux (tools/check-server holds that
to sshd): a command and its exit codes, both streams byte for byte, 64 MiB
through cat, an unlisted key, no command, root refused, git through it when
git is on PATH, and the log line; and burrow's own client at a terminal (B8):
the pty, its modes, the login shell, -t and -tt with stdin a pipe, the
terminal put back, a window change, ^C and ^\, the escape character, and
keystroke timing (counts of packets only).
"""
import argparse
import hashlib
import importlib.util
import json
import os
import pathlib
import re
import secrets
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
WORK = ROOT / "target" / "server-local"
ROWS = []
_spec = importlib.util.spec_from_file_location("localproc", ROOT / "tools" / "localproc.py")
localproc = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(localproc)


def row(fn):
    ROWS.append(fn)
    return fn


class Fail(Exception):
    pass


def check(cond, why):
    if not cond:
        raise Fail(why)


def run(argv, inp=None, env=None, timeout=300, cwd=None):
    p = subprocess.Popen(argv, stdin=subprocess.PIPE if inp is not None else subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, cwd=cwd)
    child = localproc.OwnedChild(p)
    try:
        out, err = p.communicate(input=inp, timeout=timeout)
    except subprocess.TimeoutExpired:
        child.stop()
        p.communicate()
        raise
    child.wait()
    return p.returncode, out, err


class Local:
    def __init__(self, bindir):
        self.bin = bindir
        self.lifecycle = []
        self.home = WORK / "home"
        (self.home / ".ssh").mkdir(parents=True)
        os.chmod(WORK, 0o755)
        os.chmod(self.home, 0o755)
        os.chmod(self.home / ".ssh", 0o700)
        self.user = os.environ.get("USER") or os.environ.get("LOGNAME") or ""
        self.probe = WORK / "local-signal-probe"
        cc = shutil.which("cc")
        check(cc is not None, "cc is required for the row-owned signal probe")
        r = run([cc, "-std=c11", "-D_POSIX_C_SOURCE=200809L", "-Wall", "-Wextra", "-Werror",
                 str(ROOT / "tools" / "local-signal-probe.c"), "-o", str(self.probe)], env=self.env())
        check(r[0] == 0, f"signal probe does not compile: {r[2][-500:]!r}")
        self.keygen(WORK / "host", "host")
        self.keygen(self.home / ".ssh" / "id_ed25519", "user")
        shutil.copyfile(self.home / ".ssh" / "id_ed25519.pub", self.home / ".ssh" / "authorized_keys")
        os.chmod(self.home / ".ssh" / "authorized_keys", 0o600)
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        self.port = s.getsockname()[1]
        s.close()
        (WORK / "burrowd_config").write_text(f"ListenAddress 127.0.0.1\nPort {self.port}\nHostKey {WORK / 'host'}\nAcceptEnv GIT_PROTOCOL\n")
        self.log = open(WORK / "burrowd.log", "wb")
        self.proc = subprocess.Popen([str(self.bin / "burrowd"), "-D", "-e", "-f", str(WORK / "burrowd_config")],
                                     stdin=subprocess.DEVNULL, stdout=self.log, stderr=subprocess.STDOUT,
                                     env=self.env())
        self.owned = localproc.OwnedChild(self.proc, self.lifecycle.append)
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            try:
                with socket.create_connection(("127.0.0.1", self.port), timeout=0.5) as c:
                    c.settimeout(2)
                    c.recv(64)
                break
            except OSError:
                time.sleep(0.05)
        pub = (WORK / "host.pub").read_text().split()
        (self.home / ".ssh" / "known_hosts").write_text(f"[127.0.0.1]:{self.port} {pub[0]} {pub[1]}\n")

    def env(self, extra=None):
        e = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": str(self.home), "USER": self.user,
             "LOGNAME": self.user, "SHELL": "/bin/sh", "LC_ALL": "C"}
        e.update(extra or {})
        return e

    def keygen(self, path, comment):
        r = run([str(self.bin / "burrow-keygen"), "-q", "-t", "ed25519", "-f", str(path), "-N", "", "-C", comment], env=self.env())
        check(r[0] == 0, f"burrow-keygen: {r[2][-200:]!r}")

    def ssh(self, args, user=None, inp=None, env=None):
        return run([str(self.bin / "burrow"), "-p", str(self.port), "-l", user or self.user, "127.0.0.1"] + list(args),
                   inp=inp, env=self.env(env))

    def lines(self):
        time.sleep(0.5)
        return [x for x in (WORK / "burrowd.log").read_text().splitlines() if " from " in x]

    def stop(self):
        self.owned.stop()
        self.log.close()
        # The one listener this test started must release its own port.
        with socket.socket() as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("127.0.0.1", self.port))


L = None


@row
def local_command():
    r = L.ssh(["printf 'out\\0\\377'; echo err >&2; exit 3"])
    check(r == (3, b"out\x00\xff", b"err\n"), f"{r}")
    return "exit 3, both streams byte for byte"


@row
def local_exit_codes():
    got = [L.ssh([c])[0] for c in ("exit 0", "exit 1", "nosuchcommand-bw04")]
    check(got == [0, 1, 127], f"{got}")
    return "0, 1, 127"


@row
def local_cat_64m():
    data = os.urandom(64 * 1024 * 1024)
    r = L.ssh(["cat"], inp=data)
    check(r[0] == 0 and hashlib.sha256(r[1]).digest() == hashlib.sha256(data).digest(), f"exit {r[0]}, {len(r[1])} bytes")
    return "64 MiB, digest equal"


@row
def local_signal():
    signal_terminal()
    return "terminal byte 0x03, default-disposition INT, exit 255; live no-pty TERM not witnessed"


@row
def local_env():
    r = run([str(L.bin / "burrow"), "-o", "SendEnv=GIT_PROTOCOL", "-p", str(L.port), "-l", L.user, "127.0.0.1",
             "echo $GIT_PROTOCOL:$HOME:$USER:$SHELL"], env=L.env({"GIT_PROTOCOL": "version=2"}))
    check(r[1] == f"version=2:{L.home}:{L.user}:/bin/sh\n".encode(), f"{r[1]!r}")
    # The session runs in the scratch HOME with /bin/sh, never the invoking
    # user's own HOME or login shell.
    check(str(L.home) != os.environ.get("HOME"), f"the scratch HOME {L.home} is the invoking user's")
    return "GIT_PROTOCOL, HOME, USER and SHELL=/bin/sh"


@row
def local_unlisted():
    k = WORK / "other"
    L.keygen(k, "other")
    r = run([str(L.bin / "burrow"), "-i", str(k), "-o", "IdentitiesOnly=yes", "-p", str(L.port), "-l", L.user,
             "127.0.0.1", "true"], env=L.env())
    check(r[0] == 255 and b"Permission denied (publickey)." in r[2], f"{r[0]} {r[2][-200:]!r}")
    return "Permission denied (publickey)."


@row
def local_other_user():
    r = L.ssh(["true"], user="root")
    check(r[0] == 255 and b"Permission denied (publickey)." in r[2], f"{r[0]} {r[2][-200:]!r}")
    check(any(" outcome auth_root_refused " in x + " " for x in L.lines()), "root's refusal not named")
    return "root refused; only the running user is served"


@row
def local_shell():
    """No command (px112): the account's login shell reads burrow's
    standard input; any shell takes `exit 3`."""
    r = L.ssh([], inp=b"exit 3\n")
    check(r[0] == 3, f"exit {r[0]}, stderr {r[2][-200:]!r}")
    got = L.lines()
    check(got and " status 3" in got[-1] and " refused " not in got[-1], f"burrowd's log: {got[-1:]}")
    return "burrow with no command: the login shell, exit 3"


# bw06: a terminal through burrowd, with the system's OpenSSH client; its version line is recorded in the row's
# note. The client is the session leader of a terminal of the row's own (`on_terminal`, below), so the window change
# is the row resizing that terminal and the kernel telling ssh, and the interrupt is 0x03 written into it.
SYSTEM_SSH = "/usr/bin/ssh"


@row
def local_tty():
    """`ssh -tt` at a terminal through burrowd: tty, size and resize,
    then byte 0x03 ends a default-disposition foreground probe."""
    if not os.path.exists(SYSTEM_SSH):
        check(False, f"no {SYSTEM_SSH} on this host")
    version = subprocess.run([SYSTEM_SSH, "-V"], capture_output=True, text=True).stderr.strip()
    argv = [SYSTEM_SSH, "-F", "none", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-i",
            str(L.home / ".ssh" / "id_ed25519"), "-o", f"UserKnownHostsFile={L.home / '.ssh' / 'known_hosts'}",
            "-o", "StrictHostKeyChecking=yes", "-p", str(L.port), "-l", L.user, "127.0.0.1"]

    def resize(master, slave):
        time.sleep(0.2)
        winsize(slave, 50, 100)
        time.sleep(0.3)
        os.write(master, b"go\r")

    r = on_terminal(["-tt", "tty; stty size; echo ready; read x; stty size; exit 3"], steps=[(b"ready", resize)],
                    rows=40, cols=132, argv=argv)
    check(r[0] == 3, f"exit {r[0]}, transcript {r[1][-300:]!r} ({version})")
    # stderr shares the terminal: the system ssh's own warnings may come first.
    m = re.search(rb"(/dev/(?:tty\S+|pts/[0-9]+))\r\n40 132\r\nready\r\n", r[1])
    check(m is not None and b"\r\n50 100\r\n" in r[1], f"transcript {r[1][:300]!r}")
    signal_terminal(argv=argv)
    got = L.lines()
    check(got and all(" refused " not in x for x in got[-2:]), f"burrowd's log: {got[-2:]}")
    return f"{m.group(1)[:12].decode()}…, 40 132 then 50 100, exit 3; byte 0x03 ends the default-INT probe ({version})"


@row
def local_git():
    git = shutil.which("git")
    if not git:
        return "SKIP-NOTE no git on PATH"
    srv = L.home / "repo.git"
    seed = WORK / "seed"
    env = L.env({"GIT_AUTHOR_NAME": "R", "GIT_AUTHOR_EMAIL": "r@example.invalid", "GIT_COMMITTER_NAME": "R",
                 "GIT_COMMITTER_EMAIL": "r@example.invalid", "GIT_CONFIG_NOSYSTEM": "1"})
    for argv in ([git, "init", "-q", "-b", "main", str(seed)],):
        check(run(argv, env=env)[0] == 0, "git init")
    (seed / "a").write_text("one\n")
    check(run([git, "-C", str(seed), "add", "."], env=env)[0] == 0, "add")
    check(run([git, "-C", str(seed), "commit", "-q", "-m", "one"], env=env)[0] == 0, "commit")
    check(run([git, "clone", "-q", "--bare", str(seed), str(srv)], env=env)[0] == 0, "bare")
    cmd = f"{L.bin / 'burrow'} -p {L.port}"
    url = f"{L.user}@127.0.0.1:repo.git"
    # The session's PATH is burrowd's fixed one: git's own programs by path.
    up = shutil.which("git-upload-pack") or "git-upload-pack"
    rp = shutil.which("git-receive-pack") or "git-receive-pack"
    r = run([git, "-c", f"core.sshCommand={cmd}", "clone", "-q", f"--upload-pack={up}", url, str(WORK / "clone")], env=env)
    check(r[0] == 0, f"clone: {r[2][-300:]!r}")
    (WORK / "clone" / "b").write_text("two\n")
    run([git, "-C", str(WORK / "clone"), "add", "."], env=env)
    run([git, "-C", str(WORK / "clone"), "commit", "-q", "-m", "two"], env=env)
    r = run([git, "-c", f"core.sshCommand={cmd}", "-C", str(WORK / "clone"), "push", "-q", f"--receive-pack={rp}", "origin", "main"], env=env)
    check(r[0] == 0, f"push: {r[2][-300:]!r}")
    a = run([git, "-C", str(srv), "rev-parse", "main"], env=env)[1]
    b = run([git, "-C", str(WORK / "clone"), "rev-parse", "main"], env=env)[1]
    check(a == b, "the pushed commit is not the server's main")
    return "clone and push through burrowd"


@row
def local_log():
    got = L.lines()
    check(got and all(" burrowd[" in x for x in got), f"{got[-2:]}")
    check(any(" outcome ok status 3" in x for x in got), "no line for the exit-3 command")
    log = (WORK / "burrowd.log").read_text()
    check("PRIVATE KEY" not in log, "private key text in the log")
    return got[0].split(": ", 1)[1]


# B8: burrow's own client at a terminal, through burrowd. As in tools/check-session, each client is started as a
# terminal emulator starts a program: the session leader of a fresh pty, that pty its controlling terminal and its
# stdin, stdout and stderr (stdin a pipe where a row says). The transcript is everything read from the master. Keys,
# interrupts and escapes are bytes written into the master; a window change is the row setting the pty's size, the
# kernel telling the foreground group. The pty's settings are read before the client starts and after it ends. There
# is no pinned ssh on a host without the container, so these rows hold burrow to fixed facts, not to ssh's bytes:
# the session's shell is /bin/sh with the scratch HOME (Local.env), and every command is given.
CLOSED_COOKED = b"Connection to 127.0.0.1 closed.\r\r\n"


def _ctty():
    import fcntl
    import termios
    fcntl.ioctl(1, termios.TIOCSCTTY, 0)


def winsize(fd, rows, cols):
    import fcntl
    import struct
    import termios
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def odd_modes(fd):
    """The terminal set as a client's might be: intr ^G, erase ^H, no IXON."""
    import termios
    a = termios.tcgetattr(fd)
    a[6][termios.VINTR] = b"\x07"
    a[6][termios.VERASE] = b"\x08"
    a[0] &= ~termios.IXON
    termios.tcsetattr(fd, termios.TCSANOW, a)


# A separate keeper owns and reaps its client, and accepts STOP while it
# runs. The outer row keeps the terminal alive until its settings are read.


def on_terminal(args, steps=(), rows=24, cols=80, modes=None, stdin_data=None, key=None, timeout=30, argv=None,
                lifecycle=None):
    """A row-owned pty; the keeper reaps its client before it is released."""
    import pty
    import select
    import termios
    events = lifecycle if lifecycle is not None else L.lifecycle
    master, slave = pty.openpty()
    fds = {master, slave}
    owned = leader = None
    go_w = out_r = None
    got, pending = b"", b""
    seen = i = 0
    rc = None
    launched = reaped = False
    client_pid = None
    problem = None
    before = after = None
    if argv is None:
        argv = [str(L.bin / "burrow"), "-F", "none", "-p", str(L.port), "-l", L.user]
        if key:
            argv += ["-i", str(key)]
    command = list(argv) + list(args)

    def close(fd):
        if fd in fds:
            fds.remove(fd)
            os.close(fd)

    def receipts():
        nonlocal pending, rc, launched, reaped, client_pid, problem
        data = os.read(out_r, 65536)
        pending += data
        check(len(pending) <= 65536, "oversize keeper receipt")
        while b"\n" in pending:
            line, pending = pending.split(b"\n", 1)
            event = json.loads(line)
            check(isinstance(event, dict), "invalid keeper receipt")
            kind = event.get("event")
            check(kind in ("launched", "identity", "signal", "reaped", "exit", "error"), "unknown keeper receipt")
            pid = event.get("pid")
            check(type(pid) is int and pid > 0, "keeper reported a nonpositive child PID")
            if kind == "launched":
                check(not launched and event.get("argv") == command, "keeper child differs from launch intent")
                launched, client_pid = True, pid
            else:
                check(launched and pid == client_pid, "receipt names an unrecorded child")
            events.append(dict(event, role="client"))
            if kind == "reaped":
                reaped = True
            elif kind == "exit":
                check(reaped and event.get("reaped") is True and type(event.get("rc")) is int,
                      "client exit without a wait/reap receipt")
                rc = event["rc"]
            elif kind == "error":
                problem = "keeper: " + str(event.get("reason"))
        return bool(data)

    def drain(wait):
        nonlocal got
        ready = select.select([master, out_r], [], [], wait)[0]
        if master in ready:
            try:
                got += os.read(master, 65536)
            except OSError:
                pass
        if out_r in ready:
            return receipts()
        return True

    try:
        winsize(slave, rows, cols)
        if modes:
            modes(slave)
        before = termios.tcgetattr(slave)
        out_r, out_w = os.pipe()
        go_r, go_w = os.pipe()
        fds.update((out_r, out_w, go_r, go_w))
        keeper_argv = [sys.executable, "-I", str(ROOT / "tools" / "localproc.py"), "keeper", str(out_w), str(go_r), "--"] + command
        leader = subprocess.Popen(keeper_argv, stdin=slave if stdin_data is None else subprocess.PIPE,
                                  stdout=slave, stderr=slave, env=L.env({"TERM": "xterm"}),
                                  start_new_session=True, preexec_fn=_ctty, pass_fds=(out_w, go_r))
        owned = localproc.OwnedChild(leader, lambda event: events.append(dict(event, role="keeper")))
        close(out_w)
        close(go_r)
        if stdin_data is not None:
            leader.stdin.write(stdin_data)
            leader.stdin.close()
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and rc is None and problem is None:
            if not drain(0.05) and rc is None:
                problem = "keeper pipe closed before client exit"
                break
            if i < len(steps):
                k = got.find(steps[i][0], seen)
                if k >= 0:
                    seen = k + len(steps[i][0])
                    steps[i][1](master, slave)
                    i += 1
        if rc is None:
            problem = problem or "terminal row timed out"
    except Exception as e:
        problem = f"{type(e).__name__}: {e}"
    finally:
        try:
            if owned is not None:
                if rc is None:
                    try:
                        os.write(go_w, b"STOP\n")
                    except BrokenPipeError:
                        pass
                    deadline = time.monotonic() + 7
                    while not reaped and time.monotonic() < deadline:
                        if not drain(0.05):
                            break
                if not reaped and leader.poll() is not None:
                    # Even an exec/protocol failure must explicitly reap the
                    # direct keeper child; it does not prove a client exit.
                    owned.wait()
                check(reaped, f"client not acknowledged reaped; keeper PID {leader.pid}, client PID {client_pid}")
                # Only after the client is reaped may the keeper be released
                # or individually stopped. Never orphan the client to fix a wait.
                after = termios.tcgetattr(slave)
                try:
                    os.write(go_w, b"RELEASE\n")
                except BrokenPipeError:
                    pass
                close(go_w)
                try:
                    keeper_rc = owned.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    keeper_rc = owned.stop()
                check(keeper_rc == 0, f"keeper exit {keeper_rc}")
                end = time.monotonic() + 0.2
                while time.monotonic() < end and select.select([master], [], [], 0.05)[0]:
                    try:
                        got += os.read(master, 65536)
                    except OSError:
                        break
        except Exception as e:
            problem = (problem + "; " if problem else "") + f"cleanup: {type(e).__name__}: {e}"
        finally:
            for fd in list(fds):
                close(fd)
            events.append({"event": "fds-closed", "count": len(fds)})
    if problem:
        raise Fail(problem)
    return rc, got, before, after


def typed(data, pause=0.2):
    def act(master, slave):
        time.sleep(pause)
        os.write(master, data)
    return act


def settings(a):
    """A terminal's settings as tcgetattr gives them, less PENDIN: on macOS that flag is the kernel's state, not a
    setting a program leaves; the kernel sets it when canonical input comes back on and clears it at the next input
    (wolf-std's term.set_attr notes that macOS keeps it set)."""
    import termios
    out = list(a)
    out[3] &= ~getattr(termios, "PENDIN", 0)
    return out


def restored(name, r):
    check(settings(r[3]) == settings(r[2]),
          f"{name}: the terminal was left changed: before {r[2]}, after {r[3]}; transcript {r[1][-200:]!r}")


def signal_probe_command(nonce):
    return "exec " + shlex.quote(str(L.probe)) + " " + shlex.quote(nonce)


def signal_terminal(argv=None):
    nonce = secrets.token_hex(12)
    marker = ("PROBE_READY " + nonce + " pid=").encode()
    before_logs = len(L.lines())
    args = ["-tt"] + (["127.0.0.1"] if argv is None else []) + [signal_probe_command(nonce)]
    r = on_terminal(args, steps=[(marker, typed(b"\x03", 0.1))], argv=argv)
    check(r[0] == 255 and b"PROBE_DEADLINE" not in r[1], f"interrupt: exit {r[0]}, transcript {r[1][-400:]!r}")
    match = re.search(re.escape(marker) + rb"([1-9][0-9]*) default=1 unblocked=1 foreground=1 intr=3\r\n", r[1])
    check(match is not None, "no post-exec default/unblocked/foreground probe readiness")
    restored("terminal interrupt", r)
    settled(L.proc.pid)
    logs = L.lines()[before_logs:]
    check(len(logs) == 1 and " signal INT" in logs[0], f"no matching server signal INT record: {logs}")
    pid = int(match.group(1))
    if sys.platform.startswith("linux"):
        check(not pathlib.Path(f"/proc/{pid}").exists(), f"probe PID {pid} was not reaped")
    else:
        p = subprocess.run(["/bin/ps", "-p", str(pid), "-o", "pid="], capture_output=True, text=True)
        check(not p.stdout.strip(), f"probe PID {pid} remains")
    return r


@row
def local_tty_command():
    """`burrow -t host CMD` at a terminal: a pty, TERM, the terminal's size, the exit, the closing line, the
    terminal left as found."""
    r = on_terminal(["-t", "127.0.0.1", 'tty; echo "TERM=$TERM"; stty size; exit 3'], rows=33, cols=97)
    check(r[0] == 3, f"exit {r[0]}, transcript {r[1][-300:]!r}")
    check(re.fullmatch(rb"/dev/tty\S+\r\nTERM=xterm\r\n33 97\r\n" + re.escape(CLOSED_COOKED), r[1]) is not None,
          f"transcript {r[1][-300:]!r}")
    restored("-t", r)
    name = r[1].split(b"\r\n")[0].decode()
    return f"{name}, TERM=xterm, 33 97, exit 3, closed CR CR LF"


@row
def local_tty_modes():
    """The terminal's modes reach the remote pty: `stty -a` there, from a terminal set unusually."""
    r = on_terminal(["-t", "127.0.0.1", "stty -a"], modes=odd_modes)
    check(r[0] == 0, f"exit {r[0]}, transcript {r[1][-300:]!r}")
    for want in (b"intr = ^G", b"erase = ^H", b"-ixon"):
        check(want in r[1], f"no {want!r} in the remote stty -a: {r[1][:600]!r}")
    restored("odd modes", r)
    return "intr ^G, erase ^H, -ixon"


@row
def local_tty_shell():
    """No command at a terminal: the login shell (/bin/sh) on a pty; a line typed, then `exit 4`."""
    r = on_terminal(["127.0.0.1"], steps=[(b"$ ", typed(b"echo hi-$((1+2))\r")), (b"hi-3", typed(b"exit 4\r"))])
    check(r[0] == 4 and b"hi-3\r\n" in r[1] and r[1].endswith(CLOSED_COOKED), f"exit {r[0]}, transcript {r[1][-300:]!r}")
    restored("the login shell", r)
    return "hi-3, exit 4"


@row
def local_tty_pipe():
    """`-t` with stdin a pipe: ssh's line, no pty; `-tt`: a pty all the same."""
    t = on_terminal(["-t", "127.0.0.1", "tty; exit 0"], stdin_data=b"")
    check(t[0] == 0 and b"Pseudo-terminal will not be allocated because stdin is not a terminal." in t[1]
          and b"not a tty" in t[1], f"-t: exit {t[0]}, transcript {t[1][-300:]!r}")
    tt = on_terminal(["-tt", "127.0.0.1", "tty; exit 0"], stdin_data=b"")
    check(tt[0] == 0 and re.search(rb"/dev/tty\S+", tt[1]) is not None and tt[1].endswith(CLOSED_COOKED),
          f"-tt: exit {tt[0]}, transcript {tt[1][-300:]!r}")
    return "-t: not a tty; -tt: a pty"


@row
def local_tty_restore():
    """The terminal left as found after `~.` and after a pty the server refuses (a no-pty key)."""
    e = on_terminal(["-t", "127.0.0.1", "echo ready; sleep 30"], steps=[(b"ready", typed(b"\r~.", 0.5))],
                    modes=odd_modes)
    check(e[0] == 255 and e[1].endswith(b"Connection to 127.0.0.1 closed.\r\n") and not e[1].endswith(CLOSED_COOKED),
          f"~.: exit {e[0]}, transcript {e[1][-300:]!r}")
    restored("~.", e)
    k = WORK / "nopty"
    if not k.exists():
        L.keygen(k, "nopty")
        pub = (WORK / "nopty.pub").read_text().strip()
        with open(L.home / ".ssh" / "authorized_keys", "a") as f:
            f.write(f"no-pty {pub}\n")
    # As the pinned ssh under -t (tools/check-session's tty-refused): its line, written raw, then 255 and the
    # command never asked for.
    n = on_terminal(["-t", "127.0.0.1", "echo done"], key=k, modes=odd_modes)
    check(n[0] == 255 and n[1] == b"PTY allocation request failed on channel 0\r\n",
          f"refused pty: exit {n[0]}, transcript {n[1][-300:]!r}")
    restored("a refused pty", n)
    return "after ~. (exit 255, closed CR LF) and a refused pty (255)"


@row
def local_tty_winch():
    """The terminal resized mid-session: the remote pty follows."""
    def resize(master, slave):
        time.sleep(0.2)
        winsize(slave, 41, 120)
        time.sleep(0.3)
        os.write(master, b"\r")
    r = on_terminal(["-t", "127.0.0.1", "stty size; read x; stty size; exit 0"], steps=[(b"24 80", resize)])
    check(r[0] == 0 and re.search(rb"24 80\r\n.*41 120\r\n", r[1], re.S) is not None,
          f"exit {r[0]}, transcript {r[1][-300:]!r}")
    return "24 80 then 41 120"


@row
def local_tty_keys():
    """0x03 and 0x1c typed at a remote `sleep 30`: the remote program is interrupted (quit), not burrow."""
    notes = []
    for key, name in ((b"\x03", "^C"), (b"\x1c", "^\\")):
        t0 = time.monotonic()
        r = on_terminal(["-t", "127.0.0.1", "echo ready; sleep 30; echo after"], steps=[(b"ready", typed(key, 0.5))])
        secs = time.monotonic() - t0
        # The session ran (`ready`), ended by the key (no `after`, well before the sleep's 30 s) and closed as a
        # session that held a pty closes.
        check(r[0] == 255 and b"ready\r\n" in r[1] and b"after" not in r[1] and r[1].endswith(CLOSED_COOKED) and secs < 20,
              f"{name}: exit {r[0]} after {secs:.0f} s, transcript {r[1][-300:]!r}")
        restored(name, r)
        notes.append(f"{name} exit 255 in {secs:.0f} s")
    return ", ".join(notes)


@row
def local_esc():
    """The escape character: `~~` sends one `~`; `a~.b` mid-line is data; `-e none` passes `~.`; `~?` lists ~., ~?
    and ~~."""
    def cat_with(args, keys):
        return on_terminal(args + ["127.0.0.1", "echo ready; cat; echo end"], steps=[(b"ready", typed(keys, 0.5))])
    t = cat_with(["-t"], b"\r~~x\r\x04")
    check(t[0] == 0 and b"\r\n~x\r\n" in t[1] and b"~~x" not in t[1], f"~~: exit {t[0]}, transcript {t[1][-300:]!r}")
    m = cat_with(["-t"], b"a~.b\r\x04")
    check(m[0] == 0 and b"a~.b\r\n" in m[1], f"a~.b: exit {m[0]}, transcript {m[1][-300:]!r}")
    n = cat_with(["-e", "none", "-t"], b"\r~.\r\x04")
    check(n[0] == 0 and b"~.\r\n" in n[1], f"-e none: exit {n[0]}, transcript {n[1][-300:]!r}")
    h = on_terminal(["-t", "127.0.0.1", "echo ready; sleep 30"],
                    steps=[(b"ready", typed(b"\r~?", 0.5)), (b"this message", typed(b"\r~.", 0.5))])
    listed = [x.strip() for x in h[1].decode("utf-8", "replace").split("\r\n") if x.strip().startswith("~")]
    for e in ("~.", "~?", "~~"):
        check(any(x.startswith(e + " ") for x in listed), f"~? does not list {e}: {listed}; transcript {h[1][-400:]!r}")
    check(h[0] == 255, f"~? then ~.: exit {h[0]}")
    return f"~~, a~.b, -e none; ~? lists {len(listed)} lines"


class Relay:
    """127.0.0.1 between burrow and burrowd: the time of every chunk burrow writes (monotonic)."""

    def __init__(self, up):
        import socket
        import threading
        self.up = up
        self.ls = socket.socket()
        self.ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.ls.bind(("127.0.0.1", 0))
        self.ls.listen(1)
        self.port = self.ls.getsockname()[1]
        self.c2s = []
        self.t = threading.Thread(target=self.run, daemon=True)
        self.t.start()

    def run(self):
        import select
        import socket
        c, _ = self.ls.accept()
        s = socket.create_connection(("127.0.0.1", self.up))
        for x in (c, s):
            x.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        live = True
        while live:
            for x in select.select([c, s], [], [], 1.0)[0]:
                d = x.recv(65536)
                if not d:
                    live = False
                    break
                if x is c:
                    self.c2s.append(time.monotonic())
                    s.sendall(d)
                else:
                    c.sendall(d)
        c.close()
        s.close()


@row
def local_keystroke():
    """Keystroke timing through burrowd (tools/check-session's keystroke rows hold it to the pinned ssh): ten keys
    typed; by default packets go on after the last key (ten or more from a tenth of a second after it), with
    `ObscureKeystrokeTiming no` none do. Counts only, two runs of each, never a gap's length."""
    notes = []
    for setting, opts in (("default", []), ("no", ["-o", "ObscureKeystrokeTiming=no"])):
        for run in range(2):
            relay = Relay(L.port)
            kh = WORK / f"known_hosts-ks-{setting}-{run}"
            line = (L.home / ".ssh" / "known_hosts").read_text()
            kh.write_text(line.replace(f"]:{L.port} ", f"]:{relay.port} ", 1))
            keys = []

            def typing(master, slave):
                for gap, k in zip([0, 37, 113, 61, 250, 89, 17, 340, 45, 160], b"abcdefghij"):
                    time.sleep(gap / 1000)
                    os.write(master, bytes([k]))
                    keys.append(time.monotonic())

            argv = [str(L.bin / "burrow"), "-F", "none", "-p", str(relay.port), "-l", L.user,
                    "-o", f"UserKnownHostsFile={kh}"] + opts
            r = on_terminal(["-t", "127.0.0.1", "echo ready; sleep 5"], steps=[(b"ready", typing)], argv=argv)
            relay.t.join(5)
            check(r[0] == 0 and keys and relay.c2s, f"{setting} run {run}: exit {r[0]}, transcript {r[1][-200:]!r}")
            last, end = keys[-1], relay.c2s[-1]
            after = [x for x in relay.c2s if last + 0.1 < x < end - 0.5]
            if setting == "default":
                check(len(after) >= 10, f"default run {run}: {len(after)} packets after the last key (10 or more wanted)")
            else:
                check(not after, f"no run {run}: {len(after)} packets after the last key (none wanted)")
            notes.append(f"{setting} {len(after)}")
    return "after the last key: " + ", ".join(notes)


# The listener's memory (#30, #28): tools/check-server's server-idle-rss and
# server-conn-rss, burrowd alone, with the same windows, bounds and measure: the
# growth of the listener's anonymous resident memory (RssAnon on linux,
# footprint(1)'s dirty "Footprint" on macOS), its resident size beside it.
IDLE_SECONDS = 60
IDLE_BOUND_KIB = 64
CONN_COUNT = 300
# Measured against, over 300 logins on macOS (footprint(1), which counts in 16 KiB pages). The fixed listener: +16
# KiB (Mac takes at 68b239a and 5ba2de2); ten takes in a row at b3cfd8b: +32 +32 +32 +32 +16 +16 +32 +32 +32 +32;
# the hosted macOS runners at e4f5e15 and its five plant runs, both tiers, twelve readings: +16 to +48, the +48 once.
# The listener rebuilding and copying out its connection table (the plant, on b3cfd8b as e3aea2f): +144 +128 +112
# +128 +128, and +128 twice before (68b239a, 5ba2de2); its passes outside a region +400 KiB (68b239a).
# How the bound is set: the fixed listener's largest reading so far plus two pages, recomputed when a larger reading
# comes in. Today +48 + 32 = 80 KiB, which leaves the table plant's least reading, +112, 32 KiB over it: the same
# margin on both sides.
CONN_BOUND_KIB = 80


def mem_kib(pid):
    """(held, resident) KiB of `pid`: RssAnon and VmRSS from /proc on linux,
    footprint's Footprint and ps's rss elsewhere (tools/serverlib.mem_kib)."""
    status = pathlib.Path(f"/proc/{pid}/status")
    if status.exists():
        got = {}
        for line in status.read_text().splitlines():
            k, _, v = line.partition(":")
            if k in ("VmRSS", "RssAnon"):
                got[k] = int(v.split()[0])
        check(len(got) == 2, f"pid {pid}'s status lacks VmRSS or RssAnon: {got}")
        return got["RssAnon"], got["VmRSS"]
    rss = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    check(rss != "", f"no process {pid}")
    fp = subprocess.run(["footprint", str(pid)], capture_output=True, text=True).stdout
    m = re.search(r"Footprint: (\d+(?:\.\d+)?) (KB|MB|GB)", fp)
    check(m is not None, f"footprint gave no Footprint line for pid {pid}: {fp[:200]!r}")
    return int(float(m.group(1)) * {"KB": 1, "MB": 1024, "GB": 1024 * 1024}[m.group(2)]), int(rss)


def settled(pid, seconds=10.0):
    """Waits until `pid` has no child processes (its connections reaped)."""
    deadline = time.monotonic() + seconds
    while True:
        ps = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True).stdout
        if not any(len(f) == 2 and f[1] == str(pid) for f in (l.split() for l in ps.splitlines())):
            return
        check(time.monotonic() < deadline, f"burrowd {pid} still has children after {seconds:.0f} s")
        time.sleep(0.05)


@row
def local_idle_rss():
    pid = L.proc.pid
    settled(pid)
    time.sleep(2)
    (h0, r0) = mem_kib(pid)
    t0 = time.monotonic()
    time.sleep(IDLE_SECONDS)
    (h1, r1) = mem_kib(pid)
    secs = time.monotonic() - t0
    check(h1 - h0 <= IDLE_BOUND_KIB,
          f"burrowd's listener's anonymous memory grew {h1 - h0} KiB in {secs:.0f} s idle ({h0} to {h1} KiB held; "
          f"resident {r0} to {r1} KiB), over the {IDLE_BOUND_KIB} KiB bound")
    return f"{h1 - h0:+d} KiB held, {r1 - r0:+d} KiB resident over {secs:.0f} s idle"


@row
def local_conn_rss():
    pid = L.proc.pid
    settled(pid)
    (h0, r0) = mem_kib(pid)
    t0 = time.monotonic()
    for i in range(CONN_COUNT):
        r = L.ssh(["true"])
        check(r[0] == 0, f"login {i + 1} of {CONN_COUNT}: exit {r[0]}, stderr {r[2][-200:]!r}")
    settled(pid)
    (h1, r1) = mem_kib(pid)
    secs = time.monotonic() - t0
    check(h1 - h0 <= CONN_BOUND_KIB,
          f"burrowd's listener's anonymous memory grew {h1 - h0} KiB over {CONN_COUNT} logins in {secs:.0f} s "
          f"({h0} to {h1} KiB held; resident {r0} to {r1} KiB), over the {CONN_BOUND_KIB} KiB bound")
    return f"{h1 - h0:+d} KiB held, {r1 - r0:+d} KiB resident over {CONN_COUNT} logins in {secs:.0f} s"


def main():
    global L, WORK
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin")
    ap.add_argument("--self-test", action="store_true")
    ap.add_argument("--rows", nargs="+")
    a = ap.parse_args()
    safety = subprocess.run([sys.executable, "-I", str(ROOT / "tools" / "check-local-safety.py")])
    if safety.returncode or a.self_test:
        return safety.returncode
    if not a.bin:
        ap.error("--bin is required unless --self-test is used")
    names = {fn.__name__.replace("_", "-") for fn in ROWS}
    if a.rows and not set(a.rows) <= names:
        ap.error("unknown row selection")
    bindir = pathlib.Path(a.bin).resolve().parent
    if os.geteuid() == 0:
        print("FAIL setup check-server-local runs as an ordinary user (root is tools/check-server's)")
        return 1
    os.umask(0o022)
    (ROOT / "target").mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="server-local-", dir=ROOT / "target") as directory:
        WORK = pathlib.Path(directory)
        L = Local(bindir)
        fails = ran = 0
        try:
            for fn in ROWS:
                name = fn.__name__.replace("_", "-")
                if a.rows and name not in a.rows:
                    print(f"NOT-RUN {name} reason=focused-selection", flush=True)
                    continue
                ran += 1
                try:
                    note = fn()
                    print(f"PASS {name}" + (f" ({note})" if note else ""), flush=True)
                except Exception as e:
                    fails += 1
                    print(f"FAIL {name} {type(e).__name__}: {e}", flush=True)
        finally:
            try:
                settled(L.proc.pid)
            finally:
                L.stop()
                evidence = ROOT / "target" / "evidence"
                evidence.mkdir(exist_ok=True)
                (evidence / "local-lifecycle.jsonl").write_text("".join(json.dumps(e) + "\n" for e in L.lifecycle))
        print(f"check-server-local: {ran} rows, {fails} failed, {len(ROWS)-ran} NOT RUN ({sys.platform})")
        return min(fails, 100)


if __name__ == "__main__":
    sys.exit(main())
