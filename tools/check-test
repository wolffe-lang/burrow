#!/bin/sh
# check-test — every src/*_test.lu on the checked machine, native and lupin.
# The complete pinned JSON report, its inventory and summary must agree.
# A native fallback is retried checked-only; exit zero without a passing
# executed observation is unsupported/unmeasured, never a checked pass.
# Streams and per-file retry observations are retained independently.
# Every backend still runs after a checked failure; any failure exits 1.
set -u
BURROW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export BURROW_ROOT
cd "$BURROW_ROOT" || exit 1
python3 -I tools/check-test-test.py || exit 1
. tools/lib-toolchain.sh
fail=0
mkdir -p target/tests
"$WOLF" test --deny-warnings --json src >target/tests/wolf-test.jsonl 2>target/tests/wolf-test.err
wrc=$?
cat target/tests/wolf-test.err
python3 -I tools/check-test-results.py suite target/tests/wolf-test.jsonl "$wrc" >target/tests/rows.tsv || fail=1
while IFS='	' read -r file status detail; do
    if [ "$file" = summary ]; then
        echo "check-test: wolf test: $status files, $detail checked retries (exit $wrc)"
        continue
    fi
    case "$status" in
    retry)
        echo "check-test: $file [checked] fell back to native ($detail): rerun checked-only"
        name=$(basename "$file" .lu)
        "$WOLF" conform-run "$file" --checked --json >"target/tests/$name.checked.json" 2>"target/tests/$name.checked.err"
        crc=$?
        cat "target/tests/$name.checked.err"
        python3 -I tools/check-test-results.py retry "target/tests/$name.checked.json" "$crc" "$file" \
            "$(toml_value wolf version)" "$(toml_value wolf rev)" || fail=1
        ;;
    pass) echo "PASS $file [checked] $detail" ;;
    *) echo "FAIL $file [checked] $status $detail"; fail=1 ;;
    esac
done <target/tests/rows.tsv
for f in src/*_test.lu; do
    [ -f "$f" ] || { echo "FAIL unit-inventory no test files"; fail=1; break; }
    name=$(basename "$f" .lu)
    if "$WOLF" build --deny-warnings "$f" -o "target/tests/$name"; then
        if "target/tests/$name" >"target/tests/$name.native.out" 2>"target/tests/$name.native.err"; then
            echo "PASS $f [native] exit(0)"
        else
            echo "FAIL $f [native] exit $?"
            fail=1
        fi
    else
        echo "FAIL $f [native] does not build"
        fail=1
    fi
    if LUPIN_STD="$WOLF_STD" "$LUPIN" run "$f" >"target/tests/$name.lupin.out" 2>"target/tests/$name.lupin.err"; then
        echo "PASS $f [lupin] exit(0)"
    else
        echo "FAIL $f [lupin] exit $?"
        fail=1
    fi
done
exit $fail
