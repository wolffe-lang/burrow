# ---- strict kex ---------------------------------------------------------------------
@row
def strict_kex_missing():
    """The server's kex-strict-s-v00 stripped in flight: refused at negotiation."""
    d = run_dir("strict-kex-missing")

    def strip(t, payload):
        if t == 20:
            return [mitm.frame(mitm.kexinit_without(payload, "kex-strict-s-v00@openssh.com"))]
        return None

    with oraclelib.Sshd(d / "sshd") as s, mitm.Relay(s.port, mitm.Hook(on_packet=strip)) as m:
        r = burrow(m.port, known_relay(d, s, m))
        refused(r, "strict_kex_missing")


@row
def downgrade_caught():
    """With strict kex waived, the same tampering breaks H: the server's
    signature covers the KEXINIT it sent, not the one burrow read. burrow
    has no waiver on any tier; rows/kexprobe, a row program beside the
    binary under test, sets the transport's library option and runs the
    exchange alone."""
    d = run_dir("downgrade-caught")

    def strip(t, payload):
        if t == 20:
            return [mitm.frame(mitm.kexinit_without(payload, "kex-strict-s-v00@openssh.com"))]
        return None

    probe = BIN.parent / "rows" / "kexprobe"
    check(probe.is_file(), f"no row probe at {probe}")
    with oraclelib.Sshd(d / "sshd") as s, mitm.Relay(s.port, mitm.Hook(on_packet=strip)) as m:
        r = subprocess.run([str(probe), "127.0.0.1", str(m.port), str(known_relay(d, s, m))],
                           capture_output=True, text=True, timeout=120, env={"PATH": "/usr/bin:/bin"})
        check(r.returncode == 255, f"kexprobe exit {r.returncode}, wanted 255; stderr: {tail(r.stderr)}")
        check(re.search(r"^kexprobe: host_key_bad_signature: ", r.stderr, re.M),
              f"no 'kexprobe: host_key_bad_signature:' line; stderr: {tail(r.stderr)}")


@row
def no_strict_kex_refused():
    """burrow's command line has no strict-kex waiver on any tier: the flag
    is an unknown option, refused before any connection."""
    d = run_dir("no-strict-kex-refused")
    with oraclelib.Sshd(d / "sshd") as s:
        before = s.log_text().count("Connection from")
        r = burrow(s.port, known(d, s), "--no-strict-kex")
        time.sleep(0.2)
        conns = s.log_text().count("Connection from") - before
    refused(r, "option_unknown")
    check("unknown option -- -" in r.stderr, f"no ssh-shaped 'unknown option' line; stderr: {tail(r.stderr)}")
    check(conns == 0, f"burrow connected ({conns}) before refusing the flag")


