@row
def rekey_refused_preauth():
    """Before user authentication the pinned sshd answers a client KEXINIT
    with UNIMPLEMENTED: burrow refuses by name instead of waiting."""
    d = run_dir("rekey-refused-preauth")
    with oraclelib.Sshd(d / "sshd") as s:
        r = burrow(s.port, known(d, s), "-o", "RekeyLimit=32K", "--test-traffic=256K", "--test-preauth")
        refused(r, "kex_failed")
        check("with SSH2_MSG_UNIMPLEMENTED" in r.stderr, "the refusal does not name the UNIMPLEMENTED")
        check("dispatch_protocol_error: type 20" in s.log_text(), "sshd did not log the KEXINIT as a protocol error")


@row
def auth_none():
