# ---- the test options: inert for security ---------------------------------------------
def key_lines(path):
    """The base64 lines of a private key file: none may appear in output."""
    return [ln for ln in pathlib.Path(path).read_text().splitlines() if ln and not ln.startswith("-----")]


def refused_at(cond, r, name):
    try:
        refused(r, name)
    except Fail as e:
        raise Fail(f"{cond}: {e}")


def unauthorized(s, r):
    refused_at("key not authorized", r, "auth_refused")


def no_login(cond):
    """The pinned sshd answers no PING between SERVICE_ACCEPT and the login,
    so burrow under --test-preauth refuses `timeout` there: it never logs
    in at all."""
    def holds(s, r):
        refused_at(cond, r, "timeout")
        check("debug1: SSH2_MSG_SERVICE_ACCEPT received" in r.stderr, f"{cond}: no SERVICE_ACCEPT before the timeout")
        check("Authentication succeeded" not in r.stderr, f"{cond}: burrow logged in")
        check(not re.search(r"Accepted \S+ for ", s.log_text()), f"{cond}: sshd logged a login")
    return holds


def inert(row_name, opt, honest, login=unauthorized):
    """Runs burrow with `opt` under each condition a security property
    decides, each refused by the name it has without the option (the login
    by `login(sshd, r)`); then `honest(sshd, r)` against an honest sshd, the
    option in effect; and no line of a private key file in any output."""
    outs = []
    secrets = key_lines(CLIENT_KEY)

    def strip(t, payload):
        if t == 20:
            return [mitm.frame(mitm.kexinit_without(payload, "kex-strict-s-v00@openssh.com"))]
        return None

    def flip(t, payload):
        if t == 31:
            return [mitm.frame(payload[:-1] + bytes([payload[-1] ^ 1]))]
        return None

    d = run_dir(f"{row_name}-strict")
    with oraclelib.Sshd(d / "sshd") as s, mitm.Relay(s.port, mitm.Hook(on_packet=strip)) as m:
        r = burrow(m.port, known_relay(d, s, m), *opt)
    outs.append(r)
    refused_at("strict kex stripped", r, "strict_kex_missing")

    d = run_dir(f"{row_name}-unknown")
    with oraclelib.Sshd(d / "sshd") as s:
        kh = known(d, s, text="")
        r = burrow(s.port, kh, *opt)
    outs.append(r)
    refused_at("unknown host key", r, "host_key_unknown")
    check(kh.read_text() == "", f"unknown host key: known_hosts was written: {kh.read_text()[:80]!r}")

    d = run_dir(f"{row_name}-changed")
    algo, blob = oraclelib.keygen(d / "other", "ed25519").read_text().split()[:2]
    with oraclelib.Sshd(d / "sshd") as s:
        line = f"[127.0.0.1]:{s.port} {algo} {blob}\n"
        kh = known(d, s, text=line)
        r = burrow(s.port, kh, *opt)
    outs.append(r)
    refused_at("changed host key", r, "host_key_changed")
    check(kh.read_text() == line, "changed host key: known_hosts was rewritten")

    d = run_dir(f"{row_name}-signature")
    with oraclelib.Sshd(d / "sshd") as s, mitm.Relay(s.port, mitm.Hook(on_packet=flip)) as m:
        r = burrow(m.port, known_relay(d, s, m), *opt)
    outs.append(r)
    refused_at("flipped signature", r, "host_key_bad_signature")

    d = run_dir(f"{row_name}-cipher")
    with oraclelib.Sshd(d / "sshd", ["Ciphers aes128-ctr,aes256-gcm@openssh.com"]) as s:
        r = burrow(s.port, known(d, s), *opt)
    outs.append(r)
    refused_at("no common cipher", r, "no_common_cipher")

    d = run_dir(f"{row_name}-auth")
    other = oraclelib.keygen(d / "id_other", "ed25519")
    with oraclelib.Sshd(d / "sshd", authorized=[str(other)]) as s:
        r = burrow(s.port, known(d, s), *opt)
        outs.append(r)
        login(s, r)

    d = run_dir(f"{row_name}-permissions")
    oraclelib.keygen(d / "id_open", "ed25519")
    os.chmod(d / "id_open", 0o644)
    secrets += key_lines(d / "id_open")
    with oraclelib.Sshd(d / "sshd") as s:
        before = s.log_text().count("Connection from")
        r = burrow(s.port, known(d, s), "-i", str(d / "id_open"), *opt)
        time.sleep(0.2)
        conns = s.log_text().count("Connection from") - before
    outs.append(r)
    refused_at("key file 0644", r, "key_permissions")
    check(conns == 0, f"key file 0644: burrow connected ({conns}) before refusing the key")

    d = run_dir(f"{row_name}-honest")
    with oraclelib.Sshd(d / "sshd") as s:
        r = burrow(s.port, known(d, s), *opt)
        outs.append(r)
        note = honest(s, r)

    for r in outs:
        for ln in secrets:
            check(ln not in r.stdout and ln not in r.stderr, "a private key line appeared in burrow's output")
    return f"7 conditions held under {' '.join(opt)}; {note}"


@row
def test_traffic_inert():
    """--test-traffic: load after the login, then a disconnect."""
    def honest(s, r):
        authed_up(r)
        check(re.search(r"^burrow: traffic: 64000 bytes sent; .*PONG received", r.stderr, re.M),
              f"no traffic line; stderr: {tail(r.stderr)}")
        return "traffic sent and answered"
    return inert("test-traffic-inert", ["--test-traffic=64000"], honest)


@row
def test_preauth_inert():
    """--test-preauth: that load once more before the login. The pinned sshd
    answers no PING there, so with it burrow never logs in: every check
    before the login holds, and the login is never reached."""
    def honest(s, r):
        no_login("honest server")(s, r)
        return "an honest server: SERVICE_ACCEPT, the PING unanswered, `timeout`, no login"
    return inert("test-preauth-inert", ["--test-traffic=64000", "--test-preauth", "-o", "ConnectTimeout=5"], honest,
                 login=no_login("key not authorized"))


@row
def test_window_inert():
    """--test-window: burrow's own channel window, smaller."""
    def honest(s, r):
        transport_up(r)
        check(wait_log(s, r"ctype session rchan 0 win 4096 "), "sshd did not log the session's window of 4096")
        return "the session opened with window 4096"
    return inert("test-window-inert", ["--test-window=4096"], honest)


# ---- the transcript against the pinned OpenSSH client ----------------------------------
@row
def transcript():
    d = run_dir("transcript")
    lists = ["-o", "KexAlgorithms=curve25519-sha256,curve25519-sha256@libssh.org",
             "-o", "HostKeyAlgorithms=ssh-ed25519", "-o", "Ciphers=chacha20-poly1305@openssh.com",
             "-o", "MACs=hmac-sha2-256", "-o", "Compression=no"]
    with oraclelib.Sshd(d / "sshd") as s:
        with mitm.Relay(s.port) as a:
            kh_a = d / "known_hosts_burrow"
            kh_a.write_text(f"[127.0.0.1]:{a.port} " + " ".join(s.host_pub().read_text().split()[:2]) + "\n")
            rb = burrow(a.port, kh_a)
        time.sleep(0.2)
        with mitm.Relay(s.port) as b:
            kh_b = d / "known_hosts_ssh"
            kh_b.write_text(f"[127.0.0.1]:{b.port} " + " ".join(s.host_pub().read_text().split()[:2]) + "\n")
            ro = subprocess.run([str(oraclelib.SSH), "-F", "none", "-p", str(b.port), "-o", "BatchMode=yes",
                                 "-o", f"UserKnownHostsFile={kh_b}", "-o", "PreferredAuthentications=none",
                                 "-l", "nobody"] + lists + ["127.0.0.1", "true"],
                                capture_output=True, text=True, timeout=60)
        time.sleep(0.2)
    transport_up(rb)
    bl, bp = mitm.plaintext_packets(a.c2s)
    ol, op = mitm.plaintext_packets(b.c2s)
    (d / "burrow-c2s.hex").write_text(bytes(a.c2s[:4096]).hex())
    (d / "ssh-c2s.hex").write_text(bytes(b.c2s[:4096]).hex())
    check(bl == b"SSH-2.0-burrow_0.0.0\r\n", f"burrow's version line {bl!r}")
    check(re.fullmatch(rb"SSH-2\.0-OpenSSH_[^ \r\n]+\r\n", ol), f"ssh's version line {ol!r}")
    check([p[2][0] for p in bp] == [20, 30, 21], f"burrow's plaintext packets {[p[2][0] for p in bp]}")
    check([p[2][0] for p in op] == [20, 30, 21], f"ssh's plaintext packets {[p[2][0] for p in op]}")
    bk, ok = bp[0][2], op[0][2]
    # The pinned ssh offers zlib@openssh.com after none even with
    # Compression=no; burrow offers none alone. Every other byte after the
    # cookie must match: the eight algorithm lists before compression, and
    # the languages, the guess flag and the reserved word after it.
    bs, os_ = mitm.read_namelists(bk), mitm.read_namelists(ok)
    check(bk[0] == ok[0] == 20, "a first packet that is not KEXINIT")
    check(bk[17:bs[6][0] - 4] == ok[17:os_[6][0] - 4],
          f"KEXINIT lists before compression differ: burrow {bk[17:bs[6][0] - 4].hex()} ssh {ok[17:os_[6][0] - 4].hex()}")
    check(bk[bs[8][0] - 4:] == ok[os_[8][0] - 4:], "KEXINIT tails (languages, guess, reserved) differ")
    bcomp = bk[bs[6][0]:bs[6][1]].decode() + " / " + bk[bs[7][0]:bs[7][1]].decode()
    ocomp = ok[os_[6][0]:os_[6][1]].decode() + " / " + ok[os_[7][0]:os_[7][1]].decode()
    check(bcomp == "none / none", f"burrow's compression lists {bcomp}")
    check(len(bp[1][2]) == len(op[1][2]) == 37 and bp[1][2][:5] == op[1][2][:5], "KEX_ECDH_INIT differs in shape")
    check(bp[2][2] == op[2][2] == b"\x15", "NEWKEYS payloads differ")
    pads = " ".join(f"{p[2][0]}:{p[0]}/{p[1]} vs {q[0]}/{q[1]}" for p, q in zip(bp, op))
    (d / "frames.txt").write_text(pads + "\n")
    return (f"KEXINIT equal after the cookie but compression (burrow {bcomp}, ssh {ocomp}); "
            f"packet_length/padding burrow vs ssh: {pads}")


def keep_evidence(tier):
    """Copies the rows' logs to a readable evidence directory; FAIL lines if
    a key file or private key text would land there."""
    out = ROOT / "target" / "evidence" / f"transport-{tier}"
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    kept = 0
    for d in sorted(p for p in WORK.iterdir() if p.is_dir() and p.name not in ("home", "client")):
        for rel in ("sshd/sshd.log", "frames.txt"):
            src = d / rel
            if src.is_file():
                dst = out / d.name / src.name
                dst.parent.mkdir(exist_ok=True)
                shutil.copyfile(src, dst)
                kept += 1
    bad = []
    for p in [out.parent, out] + sorted(out.rglob("*")):
        os.chmod(p, 0o755 if p.is_dir() else 0o644)
        if p.is_file():
            if p.name.startswith(("host_", "id_", "other")) or p.suffix == ".pub":
                bad.append(f"{p.relative_to(ROOT)} is a key file")
            elif b"PRIVATE KEY" in p.read_bytes():
                bad.append(f"{p.relative_to(ROOT)} holds private key text")
    for why in bad:
        print(f"FAIL evidence {why}", flush=True)
    if not bad:
        print(f"check-transport: {kept} evidence files in {out.relative_to(ROOT)}, readable, no key material")
    return len(bad)


def main():
    global BIN
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", required=True)
    ap.add_argument("--only", nargs="*")
    a = ap.parse_args()
    BIN = pathlib.Path(a.bin).resolve()
    if not BIN.exists():
        print(f"FAIL setup no burrow binary at {BIN}")
        sys.exit(1)
    oraclelib.require_oracle()
    WORK.mkdir(parents=True, exist_ok=True)
    os.chmod(WORK, 0o711)
    (WORK / "home").mkdir(exist_ok=True)
    # The run's client key (the pinned ssh-keygen's), authorized by every
    # row's sshd; it stays in the run directory and is never copied out.
    global CLIENT_KEY
    CLIENT_KEY = WORK / "client" / "id_client"
    if CLIENT_KEY.parent.exists():
        shutil.rmtree(CLIENT_KEY.parent)
    CLIENT_KEY.parent.mkdir()
    oraclelib.keygen(CLIENT_KEY, "ed25519", comment="burrow-row-client")
    oraclelib.DEFAULT_AUTHORIZED[:] = [str(CLIENT_KEY) + ".pub"]
    fails = 0
    for fn in ROWS:
        name = fn.__name__.replace("_", "-")
        if a.only and name not in a.only:
            continue
        try:
            note = fn()
            print(f"PASS {name}" + (f" ({note})" if note else ""), flush=True)
        except Fail as e:
            fails += 1
            print(f"FAIL {name} {e}", flush=True)
        except Exception as e:  # a harness fault is a red row too, by name
            fails += 1
            print(f"FAIL {name} harness: {type(e).__name__}: {e}", flush=True)
    print(f"check-transport: {len([f for f in ROWS if not a.only or f.__name__.replace('_', '-') in a.only])} rows, {fails} failed, 0 SKIP")
    fails += keep_evidence(BIN.parent.name)
    sys.exit(min(fails, 100))


if __name__ == "__main__":
    main()
