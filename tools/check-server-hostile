@row
def hostile_data_before_exec():
    with Server("hostile-data-before-exec") as s:
        c = logged_in(s)
        c.open_session()
        conf = c.recv()
        check(conf[0] == 91, f"message {conf[0]} instead of the confirmation")
        c.data(0, b"before the command runs")
        got = c.until_end()
        c.close()
        note = refused(got, 2, "window_exceeded")
        s.outcome("window_exceeded")
