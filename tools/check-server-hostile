#!/usr/bin/env python3
"""check-server-hostile — burrowd against clients that misbehave.

    tools/in-container python3 -I tools/check-server-hostile --bin target/native/burrowd [--only ROW...]

A scripted client (tools/fakeclient.py) reaches each stage and then does
what no honest client does; each row holds burrowd to a refusal by name (its
DISCONNECT's reason and its log line's outcome) or to surviving it. The last
row opens a thousand connections that never send a version line and holds
the unauthenticated-connection cap and the listener's life. Runs as root in
the pinned container, like tools/check-server; every server binds 127.0.0.1.
"""
import argparse
import os
import pathlib
import shutil
import socket
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import oraclelib  # noqa: E402
import serverlib  # noqa: E402
from fakeclient import FakeClient, disconnect_of, public_line  # noqa: E402
from fakeserver import u32, string  # noqa: E402

ROOT = oraclelib.ROOT
WORK = ROOT / "target" / "server-hostile"
ROWS = []
BIN = None
USER = serverlib.USER


def row(fn):
    ROWS.append(fn)
    return fn


class Fail(Exception):
    pass


def check(cond, why):
    if not cond:
        raise Fail(why)


class Server:
    """burrowd alone, with `seed`'s key authorized for the account."""

    def __init__(self, name, config=()):
        self.dir = WORK / name
        if self.dir.exists():
            shutil.rmtree(self.dir)
        self.dir.mkdir(parents=True)
        os.chmod(self.dir, 0o711)
        self.seed = os.urandom(32)
        self.other = os.urandom(32)
        serverlib.install_keys([public_line(self.seed)])
        key = self.dir / "host_ed25519"
        serverlib.keygen(key, "host")
        self.b = serverlib.Burrowd(BIN, self.dir / "burrowd", key, list(config))

    def __enter__(self):
        self.b.__enter__()
        self.port = self.b.port
        return self

    def __exit__(self, *e):
        self.b.__exit__()
        (self.dir / "compare.txt").write_text(self.b.log_text())

    def outcome(self, name):
        got = self.b.conn_lines(settle=5)
        check(any(f" outcome {name} " in x + " " for x in got), f"burrowd's log has no outcome {name}: {got[-3:]}")


def refused(got, code, name):
    d = disconnect_of(got)
    check(d is not None, f"no DISCONNECT; got {[t for t, _ in got]}")
    check(d[0] == code and name in d[1], f"DISCONNECT {d}, wanted reason {code} naming {name}")
    return f"DISCONNECT {d[0]}: {d[1][:90]}"


def logged_in(s):
    c = FakeClient(s.port)
    c.kex()
    c.service()
    p = c.signed(USER, s.seed)
    check(p[0] == 52, f"message {p[0]} instead of USERAUTH_SUCCESS")
    return c


@row
def hostile_never_kex():
    with Server("hostile-never-kex", ["LoginGraceTime 2"]) as s:
        c = socket.create_connection(("127.0.0.1", s.port))
        c.settimeout(10)
        c.sendall(b"SSH-2.0-stalls\r\n")
        t0 = time.monotonic()
        data = b""
        try:
            while True:
                d = c.recv(4096)
                if not d:
                    break
                data += d
        except OSError:
            pass
        took = time.monotonic() - t0
        c.close()
        check(1.5 < took < 8, f"the connection ended after {took:.1f} s, wanted about 2")
        s.outcome("grace_expired")
        return f"closed after {took:.1f} s"


@row
def hostile_no_strict_kex():
    with Server("hostile-no-strict-kex") as s:
        c = FakeClient(s.port)
        try:
            c.kex(strict=False)
            c.until_end()
        except (ValueError, EOFError, OSError):
            c.until_end()
        c.close()
        # The DISCONNECT arrives where kex() waits for the ECDH reply.
        note = refused(c.received, 3, "strict_kex_missing")
        s.outcome("strict_kex_missing")
        return note


@row
def hostile_oversize_packet():
    with Server("hostile-oversize-packet") as s:
        c = FakeClient(s.port)
        c.kex()
        # A sealed packet_length of 300000: past the 262144 burrowd reads.
        c.w.send(bytes([2]) + string(b"x" * 300000))
        got = c.until_end()
        c.close()
        note = refused(got, 2, "packet_too_long")
        s.outcome("packet_too_long")
        return note


@row
def hostile_wrong_session():
    with Server("hostile-wrong-session") as s:
        c = FakeClient(s.port)
        c.kex()
        c.service()
        p = c.signed(USER, s.seed, session_id=os.urandom(32))
