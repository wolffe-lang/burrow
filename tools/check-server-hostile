@row
def hostile_window_overrun():
    with Server("hostile-window-overrun") as s:
        c = logged_in(s)
        c.open_session()
        conf = c.recv()
        check(conf[0] == 91, f"message {conf[0]} instead of the confirmation")
        c.request(0, b"exec", True, string(b"sleep 5"))
        ok = c.recv()
        check(ok[0] == 99, f"message {ok[0]} instead of CHANNEL_SUCCESS")
        sent = 0
        chunk = b"z" * 32768
        while sent <= 2097152:
            c.data(0, chunk)
            sent += len(chunk)
        got = c.until_end()
        c.close()
        note = refused(got, 2, "window_exceeded")
        s.outcome("window_exceeded")
        return note + f" after {sent} bytes"


@row
def hostile_requests_refused():
    """Every request burrowd refuses, each wanting a reply: CHANNEL_FAILURE
    for each, the session still serves, and the log names them all."""
    with Server("hostile-requests-refused") as s:
        c = logged_in(s)
        c.open_session()
        conf = c.recv()
        check(conf[0] == 91, f"message {conf[0]} instead of the confirmation")
        peer = 0
        asks = [(b"pty-req", string(b"xterm") + u32(80) + u32(24) + u32(0) + u32(0) + string(b"")),
                (b"x11-req", b"\x00" + string(b"MIT-MAGIC-COOKIE-1") + string(b"00") + u32(0)),
                (b"auth-agent-req@openssh.com", b""), (b"subsystem", string(b"sftp")),
                (b"signal", string(b"TERM")), (b"shell", b"")]
        answers = []
        for kind, fields in asks:
            c.request(peer, kind, True, fields)
            answers.append(c.recv()[0])
        c.request(peer, b"env", True, string(b"LANG") + string(b"C.UTF-8"))
        answers.append(c.recv()[0])
        c.request(peer, b"exec", True, string(b"echo still"))
        ok = c.recv()
        check(answers == [100] * 7, f"answers {answers}, wanted seven CHANNEL_FAILUREs")
        check(ok[0] == 99, f"message {ok[0]} instead of CHANNEL_SUCCESS for exec after the refusals")
        got = c.until_end(seconds=10)
        c.close()
        data = b"".join(p[9:] for t, p in got if t == 94)
        check(b"still" in data, f"the command's output did not arrive: {[t for t, _ in got]}")
        lines = s.b.conn_lines(settle=5)
        names = ["pty_refused", "x11_refused", "agent_refused", "subsystem_refused", "signal_refused", "shell_refused",
                 "env_refused"]
        check(lines and all(n in lines[-1] for n in names), f"the log line does not name them all: {lines[-1:]}")
        return "seven CHANNEL_FAILUREs, the command still runs, the log names each"


# ---- passwords (px112) -----------------------------------------------------------------
def failure_of(p):
    """(methods, partial success) of a USERAUTH_FAILURE payload."""
    n = int.from_bytes(p[1:5], "big")
    return p[5:5 + n].decode(), p[5 + n] != 0


@row
def hostile_password_change():
    """RFC 4252 §8's change request (TRUE, old, new): burrowd changes no
    password: USERAUTH_FAILURE, no partial success, the pinned sshd's answer
    beside it."""
    old, new = serverlib.new_password(), serverlib.new_password()
    req = FakeClient.head(USER, b"password") + b"\x01" + string(old.encode()) + string(new.encode())
    answers = {}
    sd = WORK / "hostile-password-change-sshd"
    with serverlib.Shadow() as sh, Server("hostile-password-change", ["PasswordAuthentication yes"]) as s, \
            oraclelib.Sshd(sd, ["PasswordAuthentication yes", "LogLevel VERBOSE", "PermitRootLogin no"],
                           host_keys=("ed25519",)) as o:
        sh.set(USER, serverlib.make_hash(BIN.parent / "rows" / "mkpw", old))
        for who, port in (("burrowd", s.port), ("sshd", o.port)):
            c = FakeClient(port)
            c.kex()
            c.service()
            c.w.send(req)
            p = c.recv()
            c.close()
            check(p[0] == 51, f"{who}: message {p[0]} instead of USERAUTH_FAILURE")
            answers[who] = failure_of(p)
        hits = serverlib.leaks([old, new], [("burrowd's log", s.b.log_text()), ("sshd's log", o.log_text())])
        check(not hits, f"a password reached: {', '.join(hits)}")
    check(answers["burrowd"] == answers["sshd"], f"burrowd {answers['burrowd']}, sshd {answers['sshd']}")
    check(not answers["burrowd"][1], "partial success set")
    s.outcome("auth_password_change_refused")
    return f"USERAUTH_FAILURE {answers['burrowd'][0]!r}, no partial success, as sshd"


@row
def hostile_password_long():
    """A 2000-byte password: refused before any hash, by name."""
    with Server("hostile-password-long", ["PasswordAuthentication yes"]) as s:
        c = FakeClient(s.port)
        c.kex()
        c.service()
        t0 = time.monotonic()
        c.w.send(FakeClient.head(USER, b"password") + b"\x00" + string(b"x" * 2000))
        p = c.recv()
        dt = time.monotonic() - t0
        c.close()
        check(p[0] == 51, f"message {p[0]} instead of USERAUTH_FAILURE")
    s.outcome("auth_password_too_long")
    return f"USERAUTH_FAILURE after {dt * 1000:.0f} ms"


@row
def hostile_password_flood():
    """Twenty connections each sending a wrong password at once: every one
    answered USERAUTH_FAILURE within the grace, and never more than one
    password check (a monitor's second root child) alive at any moment."""
    import threading
    pw = serverlib.new_password()
    with serverlib.Shadow() as sh, Server("hostile-password-flood", ["PasswordAuthentication yes", "LoginGraceTime 600",
                                                                     "MaxStartups 30"]) as s:
        sh.set(USER, serverlib.make_hash(BIN.parent / "rows" / "mkpw", pw, (17, 8, 1)))
        master = s.b.proc.pid
        clients = []
        for _ in range(20):
            c = FakeClient(s.port, timeout=600)
            c.kex()
            c.service()
            clients.append(c)
        got, peak, stop = [], [0], threading.Event()

        def sample():
            while not stop.is_set():
                peak[0] = max(peak[0], checkers(master))
                time.sleep(0.02)

        t = threading.Thread(target=sample, daemon=True)
        t.start()
        t0 = time.monotonic()
        wrong = serverlib.new_password().encode()
        for c in clients:
            c.w.send(FakeClient.head(USER, b"password") + b"\x00" + string(wrong))
        for c in clients:
            try:
                got.append(c.recv()[0])
            except Exception as e:  # a connection the server ended
                got.append(type(e).__name__)
        dt = time.monotonic() - t0
        stop.set()
        t.join(timeout=5)
        for c in clients:
            c.close()
    check(got == [51] * 20, f"answers {got}")
    check(peak[0] <= 1, f"{peak[0]} password checks at once")
    return f"20 FAILUREs in {dt:.1f} s, at most {peak[0]} check at once"


@row
def hostile_thousand():
    with Server("hostile-thousand", ["LoginGraceTime 5"]) as s:
        master = s.b.proc.pid
        held = []
        peak = 0
        dropped = 0
        for i in range(1000):
            try:
                c = socket.create_connection(("127.0.0.1", s.port), timeout=5)
                held.append(c)
            except OSError:
                dropped += 1
            if i % 50 == 49:
                n = monitors(master)
                peak = max(peak, n)
        time.sleep(0.5)
        peak = max(peak, monitors(master))
        alive = s.b.proc.poll() is None
        for c in held:
            c.close()
        time.sleep(6)
        # A real login after the flood.
        key = s.dir / "id_user"
        serverlib.keygen(key)
        serverlib.install_keys([pathlib.Path(str(key) + ".pub").read_text()])
        kh = s.dir / "known_hosts"
        kh.write_text(f"[127.0.0.1]:{s.port} " + " ".join((s.dir / "host_ed25519.pub").read_text().split()[:2]) + "\n")
        r = serverlib.run([serverlib.SSH, "-F", "none", "-o", "BatchMode=yes", "-o", f"UserKnownHostsFile={kh}",
                           "-i", str(key), "-p", str(s.port), "-l", USER, "127.0.0.1", "echo", "after"], timeout=60)
        check(alive and s.b.proc.poll() is None, "the listener died")
        check(peak <= 100, f"{peak} monitors at once, past MaxStartups 100")
        check(r[0] == 0 and r[1] == b"after\n", f"no login after the flood: exit {r[0]}, {r[2][-200:]!r}")
        return f"peak {peak} monitors (cap 100), {dropped} refused at connect, login after it"


def monitors(master):
    out = subprocess.run(["ps", "-e", "-o", "ppid="], capture_output=True, text=True).stdout
    return sum(1 for l in out.split() if l == str(master))


def checkers(master):
    """Password checks alive: a monitor's root children beyond its holder
    (a monitor's children are the worker, the holder, and a checker while
    one runs)."""
    out = subprocess.run(["ps", "-e", "-o", "pid=,ppid=,user="], capture_output=True, text=True).stdout
    rows = [l.split() for l in out.splitlines() if len(l.split()) == 3]
    mons = {r[0] for r in rows if r[1] == str(master)}
    n = 0
    for m in mons:
        n += max(0, sum(1 for r in rows if r[1] == m and r[2] == "root") - 1)
    return n


def main():
    global BIN
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", required=True)
    ap.add_argument("--only", nargs="*")
    a = ap.parse_args()
    BIN = pathlib.Path(a.bin).resolve()
    if not BIN.exists():
        print(f"FAIL setup no binary at {BIN}")
        sys.exit(1)
    oraclelib.require_oracle()
    serverlib.ensure_accounts()
    os.umask(0o022)
    WORK.mkdir(parents=True, exist_ok=True)
    fails = ran = 0
    for fn in ROWS:
        name = fn.__name__.replace("_", "-")
        if a.only and name not in a.only:
            continue
        ran += 1
        try:
            note = fn()
            print(f"PASS {name}" + (f" ({note})" if note else ""), flush=True)
        except Fail as e:
            fails += 1
            print(f"FAIL {name} {e}", flush=True)
        except Exception as e:
            fails += 1
            print(f"FAIL {name} harness: {type(e).__name__}: {e}", flush=True)
    print(f"check-server-hostile: {ran} rows, {fails} failed, 0 SKIP")
    sys.exit(min(fails, 100))


if __name__ == "__main__":
    main()
