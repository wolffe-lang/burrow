        check(rb[0] == 255 and b"Permission denied (publickey)" in rb[2], show(rb))
        outcome(p, "auth_key_unlisted")
        return "a from= line burrowd cannot honour admits nothing, and the plain line after it is not consulted"


# ---- the session ----------------------------------------------------------------------
@row
def session_cat_64m():
    data = os.urandom(64 * 1024 * 1024)
    with Pair(BIN, rundir("session-cat-64m")) as p:
        rb, rs = p.both(["cat"], inp=data, timeout=600)
        want = hashlib.sha256(data).hexdigest()
        record(p, f"input {want}\nsshd {hashlib.sha256(rs[1]).hexdigest()} exit {rs[0]}\nburrowd {hashlib.sha256(rb[1]).hexdigest()} exit {rb[0]}\n")
        check(rb[0] == 0 and rs[0] == 0, f"exits {rb[0]}, {rs[0]}: {tail(rb[2])}")
        check(hashlib.sha256(rb[1]).hexdigest() == want, "burrowd's output is not the input")
        check(rb[1] == rs[1] and lines(rb[2]) == lines(rs[2]), "burrowd's streams differ from sshd's")
        return f"64 MiB, sha256 {want[:16]}…"


@row
def session_interleaved():
    script = "for i in 1 2 3 4 5 6 7 8; do echo out$i; echo err$i >&2; done; printf 'tail\\0\\377'"
    with Pair(BIN, rundir("session-interleaved")) as p:
        rb, rs = p.both([script])
        return same(p, rb, rs, "stdout and stderr interleaved")


@row
def session_exit_codes():
    notes = []
    with Pair(BIN, rundir("session-exit-codes")) as p:
        for cmd in ("exit 0", "exit 1", "nosuchcommand-bw04"):
            rb, rs = p.both([cmd])
            notes.append(same(p, rb, rs, cmd))
        return "; ".join(notes)


@row
def session_sigterm():
    with Pair(BIN, rundir("session-sigterm")) as p:
        rb, rs = p.both(["kill -TERM $$"])
        note = same(p, rb, rs, "the command killed by SIGTERM")
        got = p.burrowd.conn_lines()
        check(any(" signal TERM" in x for x in got), f"burrowd's log has no signal TERM: {got[-2:]}")
        return note


@row
def session_env():
    with Pair(BIN, rundir("session-env")) as p:
        env = {"GIT_PROTOCOL": "version=2", "LANG": "C.UTF-8"}
        rb, rs = p.both(["env | LC_ALL=C sort"], opts=["-o", "SendEnv=GIT_PROTOCOL", "-o", "SendEnv=LANG"], env=env)
        record(p, f"sshd:\n{rs[1].decode()}\nburrowd:\n{rb[1].decode()}\n")
        def names(out, port):
            got = {}
            for l in out.decode().splitlines():
                k, _, v = l.partition("=")
                got[k] = re.sub(r" \d+ ", " N ", v).replace(str(port), "PORT")
            return got
        b, s = names(rb[1], p.burrowd.port), names(rs[1], p.sshd.port)
        check(b.get("GIT_PROTOCOL") == "version=2", "GIT_PROTOCOL did not arrive through burrowd")
        check("LANG" not in b, "LANG arrived through burrowd")
        # Measured: the pinned sshd appends its own install's bin directory
        # to the default PATH, and sets SSH_CLIENT; burrowd does neither.
        own = ":" + str(oraclelib.PREFIX / "bin")
        if s.get("PATH", "").endswith(own):
            s["PATH"] = s["PATH"][: -len(own)]
        diff = sorted(k for k in set(b) | set(s) if b.get(k) != s.get(k))
        named = {"SSH_CLIENT"}
        check(set(diff) <= named, f"the environments differ beyond the named SSH_CLIENT: {[(k, b.get(k), s.get(k)) for k in diff]}")
        return f"equal but {sorted(diff)} and sshd's own bin directory on PATH" if diff else "equal"


@row
def session_id():
    with Pair(BIN, rundir("session-id")) as p:
        rb, rs = p.both(["id; grep -E '^(Uid|Gid|Groups|CapEff|CapPrm|NoNewPrivs):' /proc/self/status"])
        return same(p, rb, rs, "id and the credentials inside the session")


@row
def session_stdin_held():
    data = bytes(i % 251 for i in range(8 * 1024 * 1024))
    with Pair(BIN, rundir("session-stdin-held")) as p:
        rb, rs = p.both(["sleep 2; cat"], inp=data, timeout=300)
        check(rb[1] == data and rs[1] == data, "the bytes did not arrive whole")
        return same(p, rb, rs, "8 MiB to a command that sleeps before it reads", stdout=False)


