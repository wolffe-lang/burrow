    check(kb[0] == 0, f"the key through burrowd: {show(kb)}")
    logged(p, ["outcome auth_password_expired "])
    return f"burrowd refuses the password; sshd: exit {rs[0]}, stderr {tail(rs[2], 160)!r}"


