@row
def limits_defaults():
    d = rundir("limits-defaults")
    d.mkdir(parents=True)
    key = d / "host_ed25519"
    serverlib.keygen(key, "host")
    cfg = d / "burrowd_config"
    cfg.write_text(f"HostKey {key}\n")
    rb = serverlib.run([str(BIN), "-T", "-f", str(cfg)])
    scfg = d / "sshd_config"
    scfg.write_text(f"HostKey {key}\n")
    rs = serverlib.run([serverlib.SSHD, "-T", "-f", str(scfg)])
    keys = ("logingracetime", "maxauthtries", "maxstartups", "port")
    pick = lambda out: {l.split()[0]: l for l in out.decode().splitlines() if l.split() and l.split()[0] in keys}
    b, s = pick(rb[1]), pick(rs[1])
    (d / "compare.txt").write_text(f"sshd -T: {s}\nburrowd -T: {b}\n")
    check(rb[0] == 0 and rs[0] == 0, f"burrowd -T {show(rb)}; sshd -T {show(rs)}")
    check(b == s, f"burrowd -T {b} differs from sshd -T {s}")
    return ", ".join(s[k] for k in keys)


# What the client says of a connection the server ends before the
# identifications: its words depend on whether its own identification reached
# the server before the end (a reset) or after it (an end), a race of the two
# ends that both servers draw both ways on a loaded host.
ENDED_EARLY = {
    "kex_exchange_identification: read: Connection reset by peer",
    "kex_exchange_identification: Connection closed by remote host",
    "Connection reset by 127.0.0.1 port PORT",
    "Connection closed by 127.0.0.1 port PORT",
}


def ended_early(r):
    """`r` (port-normalized) with its stderr as one line when every line is
    the client's word for an end before the identifications."""
    got = lines(r[2])
    if got and all(x in ENDED_EARLY for x in got):
        return (r[0], r[1], b"(ended before the identifications)\n")
    return r


@row
def limits_startups():
    import socket as so
    with Pair(BIN, rundir("limits-startups"), sshd=["MaxStartups 3"], burrowd=["MaxStartups 3"]) as p:
        out = []
        for name, port, pid in (("burrowd", p.burrowd.port, p.burrowd.proc.pid),
                                ("sshd", p.sshd.port, p.sshd.proc.pid)):
            # The readiness probe is a started connection until its process
            # is gone, after the line the harness waits for: on a loaded
            # host the third held one was refused in its place.
            check(serverlib.childless(pid), f"{name}'s readiness probe still running after 5 s: {serverlib.children(pid)}")
            held = []
            for i in range(3):
                c = so.create_connection(("127.0.0.1", port))
                c.settimeout(5)
                ident = c.recv(64)
                # A held connection the server refused reads its end, not an
                # identification: the fourth would then be the third.
                check(ident.startswith(b"SSH-"), f"{name} ended held connection {i + 1} of 3: {ident!r}")
                held.append(c)
            time.sleep(0.5)
            r = serverlib.norm(p.ssh(port, ["true"], timeout=30), port)
            for c in held:
                c.close()
            check(serverlib.childless(pid, 10), f"{name}'s held connections still running 10 s after they closed")
            r2 = p.ssh(port, ["true"], timeout=30)
            out.append((r, r2))
        (rb, rb2), (rs, rs2) = out
        (p.dir / "fourth.txt").write_text(f"sshd:    {show(rs)}\nburrowd: {show(rb)}\n")
        note = same(p, ended_early(rb), ended_early(rs), "a fourth connection past MaxStartups 3")
        check(rb2[0] == 0 and rs2[0] == 0, f"after the held ones ended: burrowd {show(rb2)}, sshd {show(rs2)}")
        outcome(p, "startups_exceeded")
        return note


@row
def log_line():
    marker = b"bw04-marker-" + os.urandom(8).hex().encode()
    with Pair(BIN, rundir("log-line")) as p:
        rb = p.ssh(p.burrowd.port, ["cat"], inp=marker)
        check(rb[0] == 0 and rb[1] == marker, show(rb))
        # The harness's readiness probe is a connection too (outcome closed).
        got = [x for x in p.burrowd.conn_lines() if " user burrowtest " in x]
        fp = serverlib.run([serverlib.KEYGEN, "-l", "-f", str(p.key) + ".pub"])[1].decode().split()[1]
        log = p.burrowd.log_text()
        record(p, log)
        check(len(got) == 1, f"{len(got)} connection lines, wanted 1: {got}")
        l = got[0]
        check(re.match(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ burrowd\[\d+\]: from 127\.0\.0\.1 port \d+ user burrowtest key "
                       + re.escape(fp) + r" outcome ok status 0$", l), f"the line {l!r}")
        check(marker.decode() not in log, "the session's data reached the log")
        check("PRIVATE KEY" not in log and "b3BlbnNzaC1rZXktdjE" not in log, "private key text in the log")
        return l.split(": ", 1)[1]


