    is recorded beside it, a named difference where it differs."""
    p, (rb, rs), (kb, ks) = locked_pair("password-expired", lambda h: h, last=0)
    record(p, f"field 3 0, the right password\nsshd:    {show(rs)}\nburrowd: {show(rb)}\n"
