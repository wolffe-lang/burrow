#!/usr/bin/env python3
"""check-server — B5's rows: burrowd held to the pinned sshd, on loopback.

    tools/in-container python3 -I tools/check-server --bin target/native/burrowd [--only ROW...]

Every row starts the pinned sshd and burrowd side by side (tools/serverlib.py:
one per-run host key, one account, one client key, equivalent
configurations), runs the pinned ssh against both with the same arguments,
and holds burrowd's client-visible outcome to sshd's: stdout bytes, stderr
lines with each server's port written PORT, and the exit status. Where sshd
has no equivalent (strict kex required, a shell refused), the row says so
and holds burrowd to the prediction. A row prints `PASS <row>` or `FAIL <row>
<why>` at column 0; the exit status is the number of failures (capped at 100).

Runs as root in the pinned container: burrowd becomes the account (and its
worker the unprivileged `burrowd` account, made here if absent), as sshd
does. Private keys stay in the run directories; each row's two server logs
and its compare.txt are copied to target/evidence/server-<tier>/<row>/ and
the copy is checked to hold no key material.
"""
import argparse
import hashlib
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import oraclelib  # noqa: E402
import serverlib  # noqa: E402
from serverlib import Pair, USER  # noqa: E402

ROOT = oraclelib.ROOT
WORK = ROOT / "target" / "server"
ROWS = []
BIN = None


def row(fn):
    ROWS.append(fn)
    return fn


class Fail(Exception):
    pass


def check(cond, why):
    if not cond:
        raise Fail(why)


def tail(b, n=400):
    s = b.decode("utf-8", "replace") if isinstance(b, bytes) else b
    return s.strip()[-n:].replace("\n", " | ")


def lines(b):
    return [x for x in b.decode("utf-8", "replace").splitlines()]


def rundir(name):
    d = WORK / name
    if d.exists():
        shutil.rmtree(d)
    return d


def record(p, text):
    (p.dir / "compare.txt").write_text(text)


def show(r):
    return f"exit {r[0]}, stdout {r[1][:200]!r}, stderr {tail(r[2])!r}"


def same(p, rb, rs, what, stdout=True):
    """burrowd's outcome is sshd's: the exit status, stdout and stderr."""
    record(p, f"{what}\nsshd:    {show(rs)}\nburrowd: {show(rb)}\n")
    check(rb[0] == rs[0], f"exit {rb[0]} through burrowd, {rs[0]} through sshd; burrowd stderr {tail(rb[2])!r}, sshd's {tail(rs[2])!r}")
    if stdout:
        check(rb[1] == rs[1], f"stdout differs: burrowd {rb[1][:200]!r}, sshd {rs[1][:200]!r}")
    check(lines(rb[2]) == lines(rs[2]), f"stderr differs: burrowd {tail(rb[2])!r}, sshd {tail(rs[2])!r}")
    return f"exit {rs[0]}, stderr {tail(rs[2], 160)!r}" if rs[2] else f"exit {rs[0]}"


def outcome(p, name):
    """burrowd's log names the connection's outcome `name`."""
    got = p.burrowd.conn_lines()
    check(any(f" outcome {name} " in x + " " for x in got), f"burrowd's log has no outcome {name}: {got[-3:]}")


# ---- transport ----------------------------------------------------------------
@row
def server_true():
    with Pair(BIN, rundir("server-true")) as p:
        rb, rs = p.both(["true"])
        note = same(p, rb, rs, "ssh host true")
        outcome(p, "ok")
        return note


@row
def server_version():
    with Pair(BIN, rundir("server-version")) as p:
        rb = p.ssh(p.burrowd.port, ["-v", "true"])
        text = rb[2].decode("utf-8", "replace")
        record(p, text)
        check(rb[0] == 0, show(rb))
        for want in ("remote software version burrowd_0.0.0", "kex: algorithm: curve25519-sha256",
                     "kex: host key algorithm: ssh-ed25519", "chacha20-poly1305@openssh.com",
                     "Server host key: ssh-ed25519"):
            check(want in text, f"ssh -v does not show {want!r}")
        return "curve25519-sha256, ssh-ed25519, chacha20-poly1305@openssh.com"


@row
def server_ext_info():
    with Pair(BIN, rundir("server-ext-info")) as p:
        rb = p.ssh(p.burrowd.port, ["-vvv", "true"])
        text = rb[2].decode("utf-8", "replace")
        record(p, text)
        check(rb[0] == 0, show(rb))
        check("server-sig-algs=<ssh-ed25519>" in text, "no server-sig-algs=<ssh-ed25519> in ssh -vvv")
        check("strict KEX" in text or "kex-strict" in text, "no strict kex in ssh -vvv")
        return "server-sig-algs=<ssh-ed25519>"


def refused_alg(name, client_opt, sshd_line, log_name):
    with Pair(BIN, rundir(name), sshd=[sshd_line]) as p:
        rb, rs = p.both(["true"], opts=["-o", client_opt])
        note = same(p, rb, rs, f"ssh -o {client_opt}")
        return note


@row
def server_refused_cipher():
    return refused_alg("server-refused-cipher", "Ciphers=aes128-ctr", "Ciphers chacha20-poly1305@openssh.com",
                       "no_common_cipher")


@row
def server_refused_kex():
    return refused_alg("server-refused-kex", "KexAlgorithms=ecdh-sha2-nistp256",
                       "KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org", "no_common_kex")


@row
def server_refused_hostkey():
    return refused_alg("server-refused-hostkey", "HostKeyAlgorithms=rsa-sha2-256", "HostKeyAlgorithms ssh-ed25519",
                       "no_common_hostkey")


@row
def server_rekey():
    data = bytes((i * 131 + 7) % 256 for i in range(4 * 1024 * 1024))
    with Pair(BIN, rundir("server-rekey"), sshd=["RekeyLimit 256K"], burrowd=["RekeyLimit 256K"]) as p:
        rb, rs = p.both(["cat"], inp=data, opts=["-o", "RekeyLimit=256K"])
        note = same(p, rb, rs, "4 MiB through cat at RekeyLimit 256K both sides")
        check(hashlib.sha256(rb[1]).digest() == hashlib.sha256(data).digest(), "burrowd's cat is not the input")
        return note


# ---- the host key ----------------------------------------------------------------
def start_only(name, key_setup):
    """burrowd and sshd started on a host key `key_setup(path)` prepared;
    their exit statuses (both must refuse) and burrowd's line."""
    d = rundir(name)
    d.mkdir(parents=True)
    key = d / "host_ed25519"
    serverlib.keygen(key, "host")
    key_setup(key)
    cfg = d / "burrowd_config"
    cfg.write_text(f"ListenAddress 127.0.0.1\nPort {serverlib.free_port()}\nHostKey {key}\n")
    rb = serverlib.run([str(BIN), "-t", "-f", str(cfg)], timeout=30)
    scfg = d / "sshd_config"
    scfg.write_text(f"ListenAddress 127.0.0.1:{serverlib.free_port()}\nHostKey {key}\nPidFile {d / 'sshd.pid'}\n")
    rs = serverlib.run([serverlib.SSHD, "-t", "-f", str(scfg)], timeout=30)
    (d / "compare.txt").write_text(f"sshd -t: {show(rs)}\nburrowd -t: {show(rb)}\n")
    return rb, rs


@row
def hostkey_required():
    rb, rs = start_only("hostkey-required", lambda k: (k.unlink(), pathlib.Path(str(k) + ".pub").unlink()))
    check(rs[0] != 0 and rb[0] == 1, f"sshd -t exit {rs[0]}, burrowd -t exit {rb[0]}")
    check(b"burrowd: host_key_missing:" in rb[2], f"burrowd: {tail(rb[2])}")
    return f"both refuse to start; sshd: {tail(rs[2], 120)!r}"


@row
def hostkey_mode():
    rb, rs = start_only("hostkey-mode", lambda k: os.chmod(k, 0o644))
    check(rs[0] != 0 and rb[0] == 1, f"sshd -t exit {rs[0]}, burrowd -t exit {rb[0]}")
    check(b"burrowd: host_key_permissions:" in rb[2], f"burrowd: {tail(rb[2])}")
    return f"both refuse a 0644 key; sshd: {tail(rs[2], 120)!r}"


@row
def hostkey_owner():
    uid = serverlib.account().pw_uid
    rb, rs = start_only("hostkey-owner", lambda k: os.chown(k, uid, -1))
    check(rb[0] == 1 and b"burrowd: host_key_permissions:" in rb[2], f"burrowd -t exit {rb[0]}: {tail(rb[2])}")
    return f"burrowd refuses another user's key file; sshd -t exit {rs[0]}"


@row
def hostkey_fingerprint():
    with Pair(BIN, rundir("hostkey-fingerprint")) as p:
        key = p.sshd.dir / "host_ed25519"
        want = serverlib.run([serverlib.KEYGEN, "-l", "-f", str(key)])[1].decode().strip()
        bk = serverlib.run([str(BIN.parent / "burrow-keygen"), "-l", "-f", str(key)])[1].decode().strip()
        logged = [x for x in p.burrowd.log_text().splitlines() if "host key" in x]
        record(p, f"ssh-keygen -l: {want}\nburrow-keygen -l: {bk}\nburrowd: {logged}\n")
        check(logged and logged[0].endswith("host key " + want), f"burrowd's start line {logged} is not ssh-keygen -l's {want!r}")
        check(bk == want, f"burrow-keygen -l {bk!r}, ssh-keygen -l {want!r}")
        return want.split()[1]


@row
def hostkey_by_burrow_keygen():
    d = rundir("hostkey-by-burrow-keygen")
    d.mkdir(parents=True)
    key = d / "host"
    r = serverlib.run([str(BIN.parent / "burrow-keygen"), "-q", "-t", "ed25519", "-f", str(key), "-N", "", "-C", "h"])
    check(r[0] == 0, show(r))
    user = d / "id_user"
    serverlib.keygen(user)
    serverlib.install_keys([pathlib.Path(str(user) + ".pub").read_text()])
    with serverlib.Burrowd(BIN, d / "burrowd", key) as b:
        kh = d / "known_hosts"
        kh.write_text(f"[127.0.0.1]:{b.port} " + " ".join(pathlib.Path(str(key) + ".pub").read_text().split()[:2]) + "\n")
        r = serverlib.run([serverlib.SSH, "-F", "none", "-o", "BatchMode=yes", "-o", f"UserKnownHostsFile={kh}",
                           "-i", str(user), "-p", str(b.port), "-l", USER, "127.0.0.1", "echo", "made"])
        check(r[0] == 0 and r[1] == b"made\n", show(r))
    return "a host key made by burrow-keygen serves"


