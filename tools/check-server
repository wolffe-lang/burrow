def strict_row(name, **modes):
    with Pair(BIN, rundir(name), install=False) as p:
        serverlib.install_keys([pathlib.Path(str(p.key) + ".pub").read_text()], **modes)
        rb, rs = p.both(["true"])
        note = same(p, rb, rs, f"StrictModes: {modes}")
        outcome(p, "auth_strict_modes")
        return note


@row
def auth_ssh_dir_writable():
    return strict_row("auth-ssh-dir-writable", dir_mode=0o777)


@row
def auth_home_group_writable():
    return strict_row("auth-home-group-writable", home_mode=0o770)


@row
def auth_keys_file_writable():
    return strict_row("auth-keys-file-writable", file_mode=0o666)


@row
def auth_keys_owner():
    nobody = serverlib.account("nobody").pw_uid
    return strict_row("auth-keys-owner", file_owner=nobody)


@row
def auth_tries():
    with Pair(BIN, rundir("auth-tries"), keys=[]) as p:
        keys = []
        for i in range(7):
            k = p.dir / f"id_other{i}"
            serverlib.keygen(k)
            keys.append(k)
        rb, rs = p.both(["true"], keys=keys)
        note = same(p, rb, rs, "seven unlisted keys, MaxAuthTries 6 both")
        outcome(p, "auth_tries_exceeded")
        return note


@row
def auth_grace():
    with Pair(BIN, rundir("auth-grace"), sshd=["LoginGraceTime 2"], burrowd=["LoginGraceTime 2"]) as p:
        # Each client's bytes are held after its first 1500 (its version
        # line, KEXINIT and ECDH_INIT pass; the rest waits), so neither
        # server sees a login before its grace time ends.
        out = []
        for port in (p.burrowd.port, p.sshd.port):
            with serverlib.HoldRelay(port, 1500) as relay:
                r = p.ssh(relay.port, ["true"], timeout=60)
                out.append(serverlib.norm(r, relay.port))
        rb, rs = out
        check(rs[0] != -999 and rb[0] != -999, f"ssh did not end: burrowd {show(rb)}, sshd {show(rs)}")
        note = same(p, rb, rs, "LoginGraceTime 2, the client held mid-login")
        outcome(p, "grace_expired")
        return note


@row
def auth_root():
    with Pair(BIN, rundir("auth-root")) as p:
        root = pathlib.Path("/root/.ssh")
        root.mkdir(mode=0o700, exist_ok=True)
        ak = root / "authorized_keys"
        saved = ak.read_bytes() if ak.exists() else None
        ak.write_text(pathlib.Path(str(p.key) + ".pub").read_text())
        os.chmod(ak, 0o600)
        try:
            rb, rs = p.both(["true"], user="root")
        finally:
            if saved is None:
                ak.unlink()
            else:
                ak.write_bytes(saved)
        note = same(p, rb, rs, "root's own key listed; PermitRootLogin no")
        outcome(p, "auth_root_refused")
        return note


