# ---- limits and the log -----------------------------------------------------------------
@row
def limits_defaults():
    d = rundir("limits-defaults")
    d.mkdir(parents=True)
    key = d / "host_ed25519"
    serverlib.keygen(key, "host")
    cfg = d / "burrowd_config"
    cfg.write_text(f"HostKey {key}\n")
    rb = serverlib.run([str(BIN), "-T", "-f", str(cfg)])
    scfg = d / "sshd_config"
    scfg.write_text(f"HostKey {key}\n")
    rs = serverlib.run([serverlib.SSHD, "-T", "-f", str(scfg)])
    keys = ("logingracetime", "maxauthtries", "maxstartups", "port")
    pick = lambda out: {l.split()[0]: l for l in out.decode().splitlines() if l.split() and l.split()[0] in keys}
    b, s = pick(rb[1]), pick(rs[1])
    (d / "compare.txt").write_text(f"sshd -T: {s}\nburrowd -T: {b}\n")
    check(rb[0] == 0 and rs[0] == 0, f"burrowd -T {show(rb)}; sshd -T {show(rs)}")
    check(b == s, f"burrowd -T {b} differs from sshd -T {s}")
    return ", ".join(s[k] for k in keys)


@row
def limits_startups():
    import socket as so
    with Pair(BIN, rundir("limits-startups"), sshd=["MaxStartups 3"], burrowd=["MaxStartups 3"]) as p:
        out = []
        for port in (p.burrowd.port, p.sshd.port):
            held = []
            for _ in range(3):
                c = so.create_connection(("127.0.0.1", port))
                c.settimeout(5)
                c.recv(64)
                held.append(c)
            time.sleep(0.5)
            r = serverlib.norm(p.ssh(port, ["true"], timeout=30), port)
            for c in held:
                c.close()
            time.sleep(1.0)
            r2 = p.ssh(port, ["true"], timeout=30)
            out.append((r, r2))
        (rb, rb2), (rs, rs2) = out
        note = same(p, rb, rs, "a fourth connection past MaxStartups 3")
        check(rb2[0] == 0 and rs2[0] == 0, f"after the held ones ended: burrowd {show(rb2)}, sshd {show(rs2)}")
        outcome(p, "startups_exceeded")
        return note


@row
def log_line():
    marker = b"bw04-marker-" + os.urandom(8).hex().encode()
    with Pair(BIN, rundir("log-line")) as p:
        rb = p.ssh(p.burrowd.port, ["cat"], inp=marker)
        check(rb[0] == 0 and rb[1] == marker, show(rb))
        # The harness's readiness probe is a connection too (outcome closed).
        got = [x for x in p.burrowd.conn_lines() if " user burrowtest " in x]
        fp = serverlib.run([serverlib.KEYGEN, "-l", "-f", str(p.key) + ".pub"])[1].decode().split()[1]
        log = p.burrowd.log_text()
        record(p, log)
        check(len(got) == 1, f"{len(got)} connection lines, wanted 1: {got}")
        l = got[0]
        check(re.match(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ burrowd\[\d+\]: from 127\.0\.0\.1 port \d+ user burrowtest key "
                       + re.escape(fp) + r" outcome ok status 0$", l), f"the line {l!r}")
        check(marker.decode() not in log, "the session's data reached the log")
        check("PRIVATE KEY" not in log and "b3BlbnNzaC1rZXktdjE" not in log, "private key text in the log")
        return l.split(": ", 1)[1]


# ---- privileges -----------------------------------------------------------------
@row
def priv_worker():
    import socket as so
    with Pair(BIN, rundir("priv-worker"), burrowd=["LoginGraceTime 20"]) as p:
        c = so.create_connection(("127.0.0.1", p.burrowd.port))
        c.settimeout(5)
        c.recv(64)
        time.sleep(0.5)
        master = p.burrowd.proc.pid
        ps = subprocess.run(["ps", "-e", "-o", "pid=,ppid=,user=,comm="], capture_output=True, text=True).stdout
        procs = [l.split() for l in ps.splitlines() if l.split()]
        mons = [x for x in procs if x[1] == str(master)]
        kids = [x for x in procs if mons and x[1] == mons[0][0]]
        c.close()
        record(p, f"master {master}\nmonitors {mons}\nchildren {kids}\n")
        check(len(mons) == 1 and mons[0][2] == "root", f"the monitor: {mons}")
        users = sorted(x[2] for x in kids)
        check(users == ["burrowd", "root"], f"the monitor's two children run as {users}, wanted burrowd (the worker) and root (the holder)")
        return "monitor root; worker burrowd; holder root until it becomes the user"


def keep_evidence(tier):
    out = ROOT / "target" / "evidence" / f"server-{tier}"
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    kept = 0
    for d in sorted(WORK.iterdir()) if WORK.exists() else []:
        for src in list(d.rglob("*.log")) + list(d.rglob("compare.txt")):
            dst = out / d.name / src.relative_to(d)
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src, dst)
            kept += 1
    bad = []
    for p in [out.parent, out] + sorted(out.rglob("*")):
        os.chmod(p, 0o755 if p.is_dir() else 0o644)
        if p.is_file():
            b = p.read_bytes()
            if b"PRIVATE KEY" in b or b"b3BlbnNzaC1rZXktdjE" in b:
                bad.append(f"{p.relative_to(ROOT)} holds private key text")
    for why in bad:
        print(f"FAIL evidence {why}", flush=True)
    if not bad:
        print(f"check-server: {kept} evidence files in {out.relative_to(ROOT)}, readable, no key material")
    return len(bad)


def main():
    global BIN
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", required=True)
    ap.add_argument("--only", nargs="*")
    a = ap.parse_args()
    BIN = pathlib.Path(a.bin).resolve()
    for b in (BIN, BIN.parent / "burrow-keygen"):
        if not b.exists():
            print(f"FAIL setup no binary at {b}")
            sys.exit(1)
    oraclelib.require_oracle()
    serverlib.ensure_accounts()
    os.umask(0o022)
    WORK.mkdir(parents=True, exist_ok=True)
    os.chmod(WORK, 0o711)
    fails = ran = 0
    for fn in ROWS:
        name = fn.__name__.replace("_", "-")
        if a.only and name not in a.only:
            continue
        ran += 1
        try:
            note = fn()
            print(f"PASS {name}" + (f" ({note})" if note else ""), flush=True)
        except Fail as e:
            fails += 1
            print(f"FAIL {name} {e}", flush=True)
        except Exception as e:  # a harness fault is a red row too, by name
            fails += 1
            print(f"FAIL {name} harness: {type(e).__name__}: {e}", flush=True)
    print(f"check-server: {ran} rows, {fails} failed, 0 SKIP")
    fails += keep_evidence(BIN.parent.name)
    sys.exit(min(fails, 100))


if __name__ == "__main__":
    main()
