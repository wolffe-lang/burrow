def locked_pair(name, field_of, **shadow):
    """The account's password line made by `field_of(hash)`; the right
    password offered, then the account's listed key: (password results,
    key results) through burrowd and sshd."""
    pw = serverlib.new_password()
    with serverlib.Shadow() as sh, Pair(BIN, rundir(name), sshd=PW_SSHD, burrowd=PW_BURROWD) as p:
        sh.set(serverlib.USER, field_of(serverlib.make_hash(mkpw(), pw)), **shadow)
        pr = p.both_pw(["true"], [pw])
        kr = p.both(["true"])
        no_leak(p, [pw], *pr, *kr)
        return p, pr, kr


