@row
def auth_forced_shell():
    """A forced command runs for a shell request too, never the shell
    (sshd(8), command=: "applies to shell, command or subsystem execution"):
    the script the client sends is the forced command's standard input,
    read as data, never run (px112)."""
    with Pair(BIN, rundir("auth-forced-shell"), install=False) as p:
        line = 'command="echo forced: ${SSH_ORIGINAL_COMMAND-unset}; cat" ' + pathlib.Path(str(p.key) + ".pub").read_text()
        serverlib.install_keys([line])
        rb, rs = p.both(["-T"], inp=b"echo shell ran\n")
        note = same(p, rb, rs, "authorized_keys command=, ssh -T host with a script on stdin")
        check(rb[1].startswith(b"forced: ") and rb[1].endswith(b"echo shell ran\n"),
              f"stdout {rb[1]!r}: the script did not reach the forced command as its input")
        check(b"\nshell ran" not in b"\n" + rb[1], f"stdout {rb[1]!r}: the script ran as a shell's")
        return note + f", stdout {rb[1]!r}"


@row
def auth_option_unhonoured():
    with Pair(BIN, rundir("auth-option-unhonoured"), install=False) as p:
        pub = pathlib.Path(str(p.key) + ".pub").read_text()
        serverlib.install_keys(['from="10.9.9.9" ' + pub, pub])
        rb = serverlib.norm(p.ssh(p.burrowd.port, ["true"]), p.burrowd.port)
        record(p, f"burrowd: {show(rb)}\n")
        check(rb[0] == 255 and b"Permission denied (publickey)" in rb[2], show(rb))
        outcome(p, "auth_key_unlisted")
        return "a from= line burrowd cannot honour admits nothing, and the plain line after it is not consulted"


@row
def auth_nologin():
    """/etc/nologin (sshd(8)'s LOGIN PROCESS): its text shown, the session
    refused, alike through both servers. The rows' sshd logs to its stderr
    (-e), and its session's log line about the file reaches the client's
    stderr too; so the same sshd runs again logging to a file (-E), and
    burrowd is held to what a client sees then, the -e run's extra line
    named. The file is removed after."""
    nologin = pathlib.Path("/etc/nologin")
    check(not nologin.exists(), "/etc/nologin exists before the row")
    with Pair(BIN, rundir("auth-nologin")) as p:
        d = p.dir / "sshd-E"
        d.mkdir()
        port = serverlib.free_port()
        cfg = [x for x in (p.sshd.dir / "sshd_config").read_text().splitlines()
               if not x.startswith(("ListenAddress ", "PidFile "))]
        cfg += [f"ListenAddress 127.0.0.1:{port}", f"PidFile {d / 'sshd.pid'}"]
        (d / "sshd_config").write_text("\n".join(cfg) + "\n")
        with open(p.kh, "a") as kh:
            kh.write(p.sshd.known_hosts_line().replace(f"[127.0.0.1]:{p.sshd.port} ", f"[127.0.0.1]:{port} "))
        e = subprocess.Popen([serverlib.SSHD, "-D", "-E", str(d / "sshd.log"), "-f", str(d / "sshd_config")],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                try:
                    with socket.create_connection(("127.0.0.1", port), timeout=0.5) as c:
                        c.recv(64)
                    break
                except OSError:
                    time.sleep(0.05)
            try:
                nologin.write_text("bw04: logins are off for this row\n")
                rb, rs = p.both(["echo", "ran"])
                re_ = serverlib.norm(p.ssh(port, ["echo", "ran"]), port)
            finally:
                nologin.unlink()
        finally:
            e.terminate()
            e.wait(timeout=10)
        logged = "User burrowtest not allowed because /etc/nologin exists"
        record(p, f"sshd -e: {show(rs)}\nsshd -E: {show(re_)} raw stderr {re_[2]!r}\n")
        check([x for x in lines(rs[2]) if x != logged] == lines(re_[2]) and rs[0] == re_[0],
              f"sshd -e less its log line is not sshd -E: {show(rs)} / {show(re_)}")
        note = same(p, rb, re_, "ssh host echo ran, with /etc/nologin (sshd logging to a file)")
        check(rb[2] == re_[2], f"stderr bytes differ: burrowd {rb[2]!r}, sshd {re_[2]!r}")
        check(b"ran" not in rb[1], "the command ran through burrowd")
        got = p.burrowd.conn_lines()
        check(any("nologin" in x for x in got), f"burrowd's log does not name nologin: {got[-2:]}")
        return note + f"; sshd -e adds its log line {logged!r}"


# ---- passwords (px112) ------------------------------------------------------------------
# PasswordAuthentication yes on both servers, sshd at LogLevel VERBOSE (its
# first LogLevel wins over oraclelib's DEBUG3), the account's /etc/shadow line
# made for the row and the file put back after it. Every row holds its
# passwords to neither server's log, the client's output nor its compare.txt.
PW_SSHD = ["PasswordAuthentication yes", "LogLevel VERBOSE"]
PW_BURROWD = ["PasswordAuthentication yes"]
DENIED = "Permission denied, please try again."
FINAL = "burrowtest@127.0.0.1: Permission denied (publickey,password)."


def mkpw():
    return BIN.parent / "rows" / "mkpw"


def no_leak(p, passwords, *results):
    places = [("burrowd's log", p.burrowd.log_text()), ("sshd's log", p.sshd.log_text())]
    cmp = p.dir / "compare.txt"
    if cmp.exists():
        places.append(("compare.txt", cmp.read_bytes()))
    for i, r in enumerate(results):
        places += [(f"result {i} stdout", r[1]), (f"result {i} stderr", r[2])]
    hits = serverlib.leaks(passwords, places)
    check(not hits, f"a password reached: {', '.join(hits)}")


def logged(p, words):
    """burrowd's log has a line holding every one of `words`."""
    got = p.burrowd.conn_lines()
    check(any(all(w in x + " " for w in words) for x in got), f"burrowd's log has no line with {words}: {got[-3:]}")


def denied_lines(n, user="burrowtest"):
    return [DENIED] * (n - 1) + [f"{user}@127.0.0.1: Permission denied (publickey,password)."]


@row
def password_accepted():
    pw = serverlib.new_password()
    with serverlib.Shadow() as sh, Pair(BIN, rundir("password-accepted"), sshd=PW_SSHD, burrowd=PW_BURROWD) as p:
        sh.set(serverlib.USER, serverlib.make_hash(mkpw(), pw))
        rb, rs = p.both_pw(["echo", "in", ";", "id", "-un"], [pw])
        note = same(p, rb, rs, "the right password")
        check(rb[0] == 0 and rb[1] == b"in\nburrowtest\n", show(rb))
        logged(p, ["user burrowtest ", "key password ", "outcome ok "])
        no_leak(p, [pw], rb, rs)
        return note


@row
def password_wrong():
    pw, wrong = serverlib.new_password(), serverlib.new_password()
    with serverlib.Shadow() as sh, Pair(BIN, rundir("password-wrong"), sshd=PW_SSHD, burrowd=PW_BURROWD) as p:
        sh.set(serverlib.USER, serverlib.make_hash(mkpw(), pw))
        rb, rs = p.both_pw(["true"], [wrong])
        note = same(p, rb, rs, "a wrong password, three prompts")
        check(rb[0] == 255 and lines(rb[2]) == denied_lines(3), show(rb))
        outcome(p, "auth_password_bad")
