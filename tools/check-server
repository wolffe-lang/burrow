@row
def session_own_group():
    """Each session's program leads a process group of its own (px112): the
    shell is its group's leader (the group id its own pid), and `tty_nr` is
    0 in the rows' container. Held to sshd's shape (sshd starts a session,
    which leads a group too). A session of its own waits for a toolchain
    call burrow's pin does not have."""
    script = "set -- $(cat /proc/self/stat); echo \"pgrp_is_shell=$([ \"$5\" = \"$$\" ] && echo yes || echo no) tty_nr=$7\""
    with Pair(BIN, rundir("session-own-group")) as p:
        rb, rs = p.both([script])
        note = same(p, rb, rs, "the session's program: its process group and its terminal")
        check(rb[1] == b"pgrp_is_shell=yes tty_nr=0\n", f"burrowd's session: {rb[1]!r}")
        return note + f", {rb[1].decode().strip()}"


def stat_of(pid):
    """/proc/PID/stat's fields after the command name: state, ppid, pgrp, session, tty_nr, ..."""
    text = pathlib.Path(f"/proc/{pid}/stat").read_text()
    return text[text.rindex(")") + 2:].split()


@row
def server_own_group():
    """burrowd's listener leads a process group of its own (px112), away
    from the group that started it (the row's)."""
    with Pair(BIN, rundir("server-own-group")) as p:
        pid = p.burrowd.proc.pid
        f = stat_of(pid)
        mine = stat_of(os.getpid())
        record(p, f"burrowd {pid}: {' '.join(f[:5])}\nthe row {os.getpid()}: {' '.join(mine[:5])}\n")
        check(int(f[2]) == pid, f"burrowd {pid} is in group {f[2]} (the row's is {mine[2]})")
        return f"burrowd {pid} leads group {f[2]}; the row's is {mine[2]}"


# The console's shape (px112): a session whose controlling terminal one group
# holds in the foreground (pid 1's on PAX), burrowd started in a background
# group of it (the boot hook's). The leader takes a pseudo-terminal of the
# row's own as its controlling terminal and starts burrowd in a new group.
CONSOLE_LEADER = r"""
import fcntl, os, subprocess, sys, termios
slave, log, argv = sys.argv[1], sys.argv[2], sys.argv[3:]
os.setsid()
fd = os.open(slave, os.O_RDWR)
fcntl.ioctl(fd, termios.TIOCSCTTY, 0)
with open(log, "ab") as lf:
    p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=lf, stderr=subprocess.STDOUT, process_group=0)
    print(p.pid, flush=True)
    p.wait()
"""


@row
def session_terminal_stop():
    """burrowd started as on PAX, in a background group of a session whose
    controlling terminal another group holds in the foreground (px112). A
    program over ssh asks for that terminal (`stty -echo </dev/tty`, as sudo
    does before it reads a password). bw06: each program leads a session of
    its own with no controlling terminal, so `/dev/tty` does not open, the
    program is not stopped, and it ends with its status; before, px112's
    group of its own stopped the program alone (SIGTTOU). Either way a
    second connection is answered and the listener runs. Anything the row
    finds stopped is ended (SIGKILL to its group) before burrowd goes."""
    master, slave = pty.openpty()
    with Pair(BIN, rundir("session-terminal-stop")) as p:
        d = p.dir / "console"
        d.mkdir()
        port = serverlib.free_port()
        cfg = d / "burrowd_config"
        cfg.write_text("\n".join(serverlib.BURROWD_BASE + ["ListenAddress 127.0.0.1", f"Port {port}",
                                                         f"HostKey {p.sshd.dir / 'host_ed25519'}"]) + "\n")
        with open(p.kh, "a") as kh:
            kh.write(p.sshd.known_hosts_line().replace(f"[127.0.0.1]:{p.sshd.port} ", f"[127.0.0.1]:{port} "))
        leader = subprocess.Popen([sys.executable, "-I", "-c", CONSOLE_LEADER, os.ttyname(slave), str(d / "burrowd.log"),
                                   str(BIN), "-D", "-e", "-f", str(cfg)], stdout=subprocess.PIPE, stdin=subprocess.DEVNULL)
        bpid = int(leader.stdout.readline())

        def in_session(state=None):
            """(pid, comm, state, pgrp) of each process in the leader's session."""
            got = []
            for q in pathlib.Path("/proc").iterdir():
                if q.name.isdigit() and int(q.name) != leader.pid:
                    try:
                        f = stat_of(int(q.name))
                        if int(f[3]) == leader.pid and (state is None or f[0] == state):
                            got.append((int(q.name), (q / "comm").read_text().strip(), f[0], int(f[2])))
                    except (OSError, ValueError, IndexError):
                        pass
            return got

        def burrowtest_lines():
            return [x.split(": ", 1)[1] for x in (d / "burrowd.log").read_text(errors="replace").splitlines()
                    if " user burrowtest " in x]

        stopped, listener, r1, r2 = [], "?", None, None
        first = None
        try:
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                try:
                    with socket.create_connection(("127.0.0.1", port), timeout=0.5) as c:
                        c.settimeout(2)
                        c.recv(64)
                    break
                except OSError:
                    time.sleep(0.05)
            first = subprocess.Popen(p.argv(port, ["stty -echo </dev/tty; echo not-stopped"]), stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=p.env())
            # The stop, looked for while the first session is live.
            deadline = time.monotonic() + 10
            while not stopped and first.poll() is None and time.monotonic() < deadline:
                stopped = [x for x in in_session("T") if x[1] == "stty"]
                if not stopped:
                    time.sleep(0.05)
            listener = stat_of(bpid)[0]
            r2 = p.ssh(port, ["echo second"], timeout=15)
            # End the stopped program, its whole group, while its session is live.
            for g in sorted({x[3] for x in stopped}):
                try:
                    os.killpg(g, signal_mod.SIGKILL)
                except OSError:
                    pass
            try:
                out, err = first.communicate(timeout=10)
                r1 = (first.returncode, out, err)
            except subprocess.TimeoutExpired:
                first.kill()
                out, err = first.communicate()
                r1 = (-999, out, err + b"\n[row: timed out]")
            # Each session's line is its monitor's last act: wait for both before burrowd goes.
            deadline = time.monotonic() + 5
            while len(burrowtest_lines()) < 2 and time.monotonic() < deadline:
                time.sleep(0.05)
        finally:
            if first is not None and first.poll() is None:
                first.kill()
                first.wait()
            # Whatever the stop left in the leader's session (its id the leader's pid) goes.
            for x in in_session("T"):
                try:
                    os.kill(x[0], signal_mod.SIGKILL)
                except OSError:
                    pass
            for sig in (signal_mod.SIGCONT, signal_mod.SIGTERM):
                try:
                    os.killpg(bpid, sig)
                except OSError:
                    pass
            try:
                leader.wait(timeout=10)
            except subprocess.TimeoutExpired:
                leader.kill()
                os.killpg(bpid, signal_mod.SIGKILL)
            os.close(master)
            os.close(slave)
        lines = burrowtest_lines()
        record(p, f"stopped: {stopped}\nlistener {bpid} state {listener}\nsecond connection: {show(r2)}\n"
                  f"first connection, after its program was ended: {show(r1)}\nburrowd's lines: {lines}\n")
        check(not stopped, f"a program over ssh was stopped on burrowd's terminal: {stopped}; the first client: "
                           f"{'still running' if r1 is None else show(r1)}")
        check(r2[:2] == (0, b"second\n"), f"the second connection: {show(r2)} (the listener's state {listener})")
        check(r1 is not None and r1[0] == 0 and b"not-stopped" in r1[1] and b"/dev/tty" in r1[2],
              f"the program had a terminal, or did not end: {'still running' if r1 is None else show(r1)}")
        check(any(" outcome ok status 0" in x for x in lines), f"the first session's end: burrowd's lines {lines}")
        return f"no terminal for the program (/dev/tty refused), nothing stopped, the listener {listener}, the second connection answered"


