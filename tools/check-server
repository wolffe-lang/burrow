# ---- a shell with no pty (px112) ---------------------------------------------------------
# RFC 4254 §6.5's `shell`: the account's login shell, its standard input,
# output and error the channel's; a pty-req stays pty_refused. When a shell
# starts after a refused pty-req, burrowd's first bytes on the session's
# stderr are NO_PTY, and nowhere else.
NO_PTY = b"burrowd: no pty here: this shell runs without a terminal (no line editing, no job control)\n"


def at_terminal(p, port, typed, after, args=(), timeout=60):
    """The pinned ssh with its standard input a pseudo-terminal's (not its
    controlling terminal; stdout and stderr pipes), as a person at a
    terminal runs it, `typed` written to the terminal once `after` shows on
    its stderr: (exit, stdout, stderr)."""
    master, slave = pty.openpty()
    try:
        proc = subprocess.Popen(p.argv(port, list(args)), stdin=slave, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=p.env())
    finally:
        os.close(slave)
    out, err = proc.stdout.fileno(), proc.stderr.fileno()
    got = {out: b"", err: b""}
    live = {out, err}
    sent = False
    deadline = time.monotonic() + timeout
    try:
        while live and time.monotonic() < deadline:
            for fd in select.select(sorted(live), [], [], 0.2)[0]:
                d = os.read(fd, 65536)
                if d:
                    got[fd] += d
                else:
                    live.discard(fd)
            if not sent and after in got[err]:
                os.write(master, typed)
                sent = True
        if live:
            proc.kill()
            got[err] += b"\n[row: timed out]"
        rc = proc.wait(timeout=10)
    finally:
        os.close(master)
        proc.stdout.close()
        proc.stderr.close()
    return rc, got[out], got[err]


@row
def session_shell():
    """No command: the login shell reads the client's standard input, held
    to sshd byte for byte; burrowd's log names no refusal."""
    notes = []
    with Pair(BIN, rundir("session-shell")) as p:
        cases = ((["-T"], b"echo out; echo err >&2; exit 3\n", "ssh -T host, a script on stdin"),
                 (["-T"], b"echo $0\n", "ssh -T host, echo $0"),
                 (["-T"], b"echo ${SSH_ORIGINAL_COMMAND-unset}\n", "ssh -T host, SSH_ORIGINAL_COMMAND"),
                 ([], b"echo piped; exit 5\n", "ssh host, stdin not a terminal"))
        for args, script, what in cases:
            rb, rs = p.both(args, inp=script)
            same(p, rb, rs, what)
            notes.append(f"{what.split(', ', 1)[1]}: exit {rs[0]}, stdout {rs[1][:40]!r}")
            if script.startswith(b"echo out"):
                check(rb[:3] == (3, b"out\n", b"err\n"), show(rb))
        got = p.burrowd.conn_lines()
        deadline = time.monotonic() + 5
        while len(got) < len(cases) and time.monotonic() < deadline:
            time.sleep(0.1)
            got = p.burrowd.conn_lines()
        record(p, "\n".join(notes) + "\n" + "\n".join(got) + "\n")
        check(len(got) == len(cases) and all(" outcome ok " in x and " refused " not in x for x in got),
              f"burrowd's log: {got}")
        return "; ".join(notes)


@row
def session_shell_pty():
    """`ssh host` at a terminal, a line typed once the session has answered:
    both servers refuse the pty (sshd: PermitTTY no) and run the shell
    without one; burrowd says so on stderr in NO_PTY, its one named
    difference, after ssh's own line."""
    with Pair(BIN, rundir("session-shell-pty")) as p:
        typed = b"echo typed; exit 4\n"
        after = b"PTY allocation request failed"
        rb = serverlib.norm(at_terminal(p, p.burrowd.port, typed, after), p.burrowd.port)
        rs = serverlib.norm(at_terminal(p, p.sshd.port, typed, after), p.sshd.port)
        record(p, f"sshd:    {show(rs)}\nburrowd: {show(rb)}\n")
        check(rb[2].count(NO_PTY) == 1, f"burrowd's stderr does not hold its no-pty line once: exit {rb[0]}, {tail(rb[2])!r}")
        check(-1 < rb[2].find(after) < rb[2].find(NO_PTY), f"burrowd's no-pty line before ssh's own: {tail(rb[2])!r}")
        note = same(p, (rb[0], rb[1], rb[2].replace(NO_PTY, b"", 1)), rs, "ssh host at a terminal, less burrowd's no-pty line")
        check(rb[:2] == (4, b"typed\n"), show(rb))
        got = p.burrowd.conn_lines()
        check(any(" refused pty_refused" in x and " status 4" in x for x in got), f"burrowd's log: {got[-2:]}")
        return note + f"; burrowd adds {NO_PTY.decode().strip()!r}"


@row
def session_shell_pty_slow():
    """As session-shell-pty, the typed line making the shell wait a second
    before it answers (px112): the pinned ssh, having asked for a pty,
    obscures keystroke timing with a PING every 20 ms meanwhile
    (ssh_config(5), ObscureKeystrokeTiming), and the answer still comes."""
    with Pair(BIN, rundir("session-shell-pty-slow")) as p:
        typed = b"sleep 1; echo slow; exit 4\n"
        after = b"PTY allocation request failed"
        rb = serverlib.norm(at_terminal(p, p.burrowd.port, typed, after, timeout=30), p.burrowd.port)
        rs = serverlib.norm(at_terminal(p, p.sshd.port, typed, after, timeout=30), p.sshd.port)
        record(p, f"sshd:    {show(rs)}\nburrowd: {show(rb)}\n")
        check(rb[2].count(NO_PTY) == 1, f"burrowd's stderr does not hold its no-pty line once: exit {rb[0]}, {tail(rb[2])!r}")
        note = same(p, (rb[0], rb[1], rb[2].replace(NO_PTY, b"", 1)), rs, "ssh host at a terminal, a slow answer, less burrowd's no-pty line")
        check(rb[:2] == (4, b"slow\n"), show(rb))
        return note


# ---- a terminal (bw06) ------------------------------------------------------------------
# RFC 4254 §6.2's pty-req granted: both servers given PermitTTY yes, and
# sshd PrintMotd no and PrintLastLog no (burrowd's only values); the base
# keeps PermitTTY no on both for every other row. Each row holds burrowd's
# exit status, stdout and stderr to sshd's, the pty's number written N.
TTY_SSHD = ["PermitTTY yes", "PrintMotd no", "PrintLastLog no"]
TTY_BURROWD = ["PermitTTY yes"]


def pts(r):
    return (r[0], re.sub(rb"/dev/pts/\d+", b"/dev/pts/N", r[1]), r[2])


def tty_pair(name, **kw):
    return Pair(BIN, rundir(name), sshd=TTY_SSHD, burrowd=TTY_BURROWD, **kw)


def set_winsize(fd, rows, cols):
    import fcntl
    import struct
    import termios
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def odd_modes(fd):
    """The row's own terminal set as a client's might be: intr ^G, erase ^H, no IXON."""
    import termios
    a = termios.tcgetattr(fd)
    a[6][termios.VINTR] = b"\x07"
    a[6][termios.VERASE] = b"\x08"
    a[0] &= ~termios.IXON
    termios.tcsetattr(fd, termios.TCSANOW, a)


def on_tty(p, port, args, steps, rows=40, cols=132, modes=None, env=None, timeout=30):
    """The pinned ssh with its stdin a pseudo-terminal of the row's own,
    sized and set before ssh starts (stdout and stderr pipes); `steps` are
    (marker, action): once `marker` shows on stdout, `action(master,
    proc)` runs. (exit, stdout, stderr), the port written PORT."""
    master, slave = pty.openpty()
    set_winsize(slave, rows, cols)
    if modes:
        modes(slave)
    try:
        proc = subprocess.Popen(p.argv(port, list(args)), stdin=slave, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=p.env(env))
    finally:
        os.close(slave)
    out, err = proc.stdout.fileno(), proc.stderr.fileno()
    got = {out: b"", err: b""}
    live = {out, err}
    i = 0
    deadline = time.monotonic() + timeout
    try:
        while live and time.monotonic() < deadline:
            for fd in select.select(sorted(live), [], [], 0.1)[0]:
                d = os.read(fd, 65536)
                if d:
                    got[fd] += d
                else:
                    live.discard(fd)
            if i < len(steps) and steps[i][0] in got[out]:
                steps[i][1](master, proc)
                i += 1
        if live:
            proc.kill()
            got[err] += b"\n[row: timed out]"
        rc = proc.wait(timeout=10)
    finally:
        os.close(master)
        proc.stdout.close()
        proc.stderr.close()
    return serverlib.norm((rc, got[out], got[err]), port)


def typed(data, pause=0.0):
    def act(master, proc):
        if pause:
            time.sleep(pause)
        os.write(master, data)
    return act


def tty_both(p, args, steps, **kw):
    rb = pts(on_tty(p, p.burrowd.port, args, steps, **kw))
    rs = pts(on_tty(p, p.sshd.port, args, steps, **kw))
    return rb, rs


@row
def session_tty_command():
    """`ssh -tt host CMD`, stdin not a terminal: the pty's name, TERM,
    SSH_TTY, the size (0 0: the client sends none), stdout and stderr both
    on the pty, CR LF; with no TERM in the client's environment and with
    TERM=vt100."""
    script = 'tty; echo "TERM=${TERM-unset}"; echo "SSH_TTY=${SSH_TTY-unset}"; stty size; echo out; echo err >&2; exit 3'
    notes = []
    with tty_pair("session-tty-command") as p:
        for env in (None, {"TERM": "vt100"}):
            rb, rs = p.both(["-tt", script], env=env)
            notes.append(same(p, pts(rb), pts(rs), f"ssh -tt host, TERM {env}"))
        got = p.burrowd.conn_lines()
        check(all(" refused " not in x for x in got), f"burrowd's log names a refusal: {got[-2:]}")
        return "; ".join(notes)


@row
def session_tty_size():
    """At a terminal of the row's own (40x132, intr ^G, erase ^H, -ixon):
    `stty size` and the whole `stty -a` on the far side; then the row's
    terminal resized to 50x100 and ssh told (SIGWINCH): `stty size` again."""
    def resize(master, proc):
        set_winsize(master, 50, 100)
        proc.send_signal(signal_mod.SIGWINCH)
    with tty_pair("session-tty-size") as p:
        rb, rs = tty_both(p, ["-tt", "stty size; stty -a; echo ready; read x; stty size"],
                          [(b"ready", resize), (b"ready", typed(b"go\r", 0.5))], modes=odd_modes)
        note = same(p, rb, rs, "stty size, stty -a, a window change")
        check(rs[1].startswith(b"40 132\r\n") and rs[1].endswith(b"50 100\r\n"), f"sshd's: {rs[1][-80:]!r}")
        return note


@row
def session_tty_full_screen():
    """A full-screen program's shape: it reads its size, sets raw mode,
    reads one key and puts the mode back; the row types q."""
    script = "stty size; stty raw -echo; k=$(dd bs=1 count=1 2>/dev/null); stty sane; printf 'key=%s\\n' \"$k\""
    with tty_pair("session-tty-full-screen") as p:
        rb, rs = tty_both(p, ["-tt", script], [(b"132", typed(b"q", 0.3))])
        note = same(p, rb, rs, "size, raw mode, one key")
        check(rb[1] == b"40 132\r\nkey=q\r\n", show(rb))
        return note


@row
def session_tty_interrupt():
    """Ctrl-C reaches the foreground program: 0x03 typed reaches a trap
    (its status 7), and ends `exec sleep 30` (exit-signal INT: 255)."""
    notes = []
    with tty_pair("session-tty-interrupt") as p:
        for script, want in (("trap 'echo caught INT; exit 7' INT; echo ready; while :; do sleep 1; done", 7),
                             ("echo ready; exec sleep 30", 255)):
            rb, rs = tty_both(p, ["-tt", script], [(b"ready", typed(b"\x03", 0.3))])
            notes.append(same(p, rb, rs, f"Ctrl-C to {script[:30]}"))
            check(rb[0] == want, show(rb))
        got = p.burrowd.conn_lines()
        check(any(" signal INT" in x for x in got), f"burrowd's log has no signal INT: {got[-2:]}")
        return "; ".join(notes)


@row
def session_tty_shell():
    """`ssh host` at a terminal: the login shell on the pty, its prompt,
    the typed line echoed, `tty`, `$0`, `exit 4`."""
    with tty_pair("session-tty-shell") as p:
        rb, rs = tty_both(p, [], [(b"$ ", typed(b"tty; echo $0; exit 4\r", 0.3))])
        note = same(p, rb, rs, "ssh host at a terminal")
        check(rb[0] == 4 and b"/dev/pts/N\r\n-sh\r\n" in rb[1], show(rb))
        got = p.burrowd.conn_lines()
        check(any(" status 4" in x and " refused " not in x for x in got), f"burrowd's log: {got[-2:]}")
        return note


def account_sleeps():
    """{pid: (tty, stat)} of each live `sleep` the rows' account runs. A zombie
    (ended, not yet reaped: in a container whose process 1 is the row's own
    program and never waits for it) is not live and holds no terminal."""
    out = subprocess.run(["ps", "-u", USER, "-o", "pid=,tty=,stat=,comm="], capture_output=True, text=True).stdout
    got = {}
    for l in out.splitlines():
        f = l.split()
        if len(f) == 4 and f[3] == "sleep" and not f[2].startswith("Z"):
            got[int(f[0])] = (f[1], f[2])
    return got


def end_and_reap(pids):
    """SIGKILL to each of `pids`, then each reaped where the row is its parent
    (its process 1 in the container), waiting up to 5 s until each is gone
    or a zombie, so a later turn's sample never meets it."""
    for pid in pids:
        try:
            os.kill(pid, signal_mod.SIGKILL)
        except OSError:
            pass
    deadline = time.monotonic() + 5
    left = set(pids)
    while left and time.monotonic() < deadline:
        for pid in sorted(left):
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
            try:
                state = stat_of(pid)[0]
            except (OSError, IndexError):
                state = "gone"
            if state in ("gone", "Z", "X"):
                left.discard(pid)
        time.sleep(0.05)


@row
def session_tty_gone():
    """The session ends with its program, not with the last holder of the
    slave: a child that ignores SIGHUP and holds the slave lives on with no
    terminal; a child that does not is gone (the hangup); the slave's name
    is gone either way. Each turn counts only the live `sleep` processes
    that started during it, and waits up to 3 s for the state it expects,
    the same for both servers."""
    notes = []
    with tty_pair("session-tty-gone") as p:
        for script, lives in (("tty; (trap '' HUP; exec sleep 6) & sleep 0.3; echo started", True),
                              ("tty; sleep 6 & sleep 0.3; echo started", False)):
            results = {}
            for who, port in (("burrowd", p.burrowd.port), ("sshd", p.sshd.port)):
                before = set(account_sleeps())
                t0 = time.monotonic()
                r = p.ssh(port, ["-tt", script], timeout=20)
                took = time.monotonic() - t0

                def turn():
                    return {k: v for k, v in account_sleeps().items() if k not in before}

                deadline = time.monotonic() + 3
                left = turn()
                while time.monotonic() < deadline:
                    if (lives and len(left) == 1 and list(left.values())[0][0] == "?") or (not lives and not left):
                        break
                    time.sleep(0.1)
                    left = turn()
                name = re.search(rb"/dev/pts/\d+", r[1])
                gone = name is None or not os.path.exists(name.group().decode())
                end_and_reap(list(left))
                results[who] = (pts(serverlib.norm(r, port)), took, sorted(left.values()), gone)
            rb, rs = results["burrowd"][0], results["sshd"][0]
            notes.append(same(p, rb, rs, script))
            for who, (_, took, left, gone) in results.items():
                check(took < 3, f"{who}: the session took {took:.1f} s; the program ended at once")
                check(gone, f"{who}: the slave's name is still there after the session")
                if lives:
                    check(len(left) == 1 and left[0][0] == "?", f"{who}: the child holding the slave: {left}")
                else:
                    check(left == [], f"{who}: the child that did not ignore SIGHUP: {left}")
            check(results["burrowd"][2] == results["sshd"][2],
                  f"the children left differ: burrowd {results['burrowd'][2]}, sshd {results['sshd'][2]}")
        return "; ".join(notes)


# bw07 (burrow#25): both servers started as a shell without job control
# starts a background command, SIGINT and SIGQUIT ignored; the program a
# session runs gets the default dispositions all the same.
IGNORING = ["sh", "-c", "trap '' INT QUIT; exec \"$@\"", "sh"]


def ignored_mask(pid):
    for line in pathlib.Path(f"/proc/{pid}/status").read_text().splitlines():
        if line.startswith("SigIgn:"):
            return int(line.split()[1], 16)
    return 0


def killed_by_int(p, port):
    """`exec sleep 33` over ssh with no pty, its process found (live, started
    during this turn) and sent SIGINT from outside: (exit, stdout, stderr),
    the port written PORT; the client ended at 10 s if the sleep lives on."""
    before = set(account_sleeps())
    proc = subprocess.Popen(p.argv(port, ["exec sleep 33"]), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, env=p.env())
    found = []
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and len(found) != 1:
        found = [k for k in account_sleeps() if k not in before]
        time.sleep(0.05)
    for pid in found:
        try:
            os.kill(pid, signal_mod.SIGINT)
        except OSError:
            pass
    try:
        out, err = proc.communicate(timeout=10)
        r = (proc.returncode, out, err)
    except subprocess.TimeoutExpired:
        proc.kill()
        out, err = proc.communicate()
        r = (-999, out, err + b"\n[row: timed out]")
    end_and_reap([k for k in account_sleeps() if k not in before])
    return serverlib.norm(r, port), len(found)


@row
def session_signals_default():
    """A session's program starts with the default dispositions (bw07,
    burrow#25): with both servers started with SIGINT and SIGQUIT ignored,
    Ctrl-C ends a foreground `sleep` at a terminal ($? 130) and Ctrl-\\ ends
    the next (131); with no pty, SIGINT sent to a command ends it
    (exit-signal INT). Held byte for byte to the pinned sshd started the same
    way."""
    steps = [(b"$ ", typed(b"sleep 31\r", 0.3)),
             (b"sleep 31", typed(b"\x03", 0.5)),
             (b"^C", typed(b"echo i$((1+1))n $?\r", 0.3)),
             (b"i2n ", typed(b"sleep 32\r", 0.3)),
             (b"sleep 32", typed(b"\x1c", 0.5)),
             (b"^\\", typed(b"echo q$((1+1))n $?\r", 0.3)),
             (b"q2n ", typed(b"exit 0\r", 0.3))]
    with tty_pair("session-signals-default", prefix=IGNORING) as p:
        masks = {who: ignored_mask(pid) for who, pid in (("burrowd", p.burrowd.proc.pid), ("sshd", p.sshd.proc.pid))}
        check(all(m & 0x6 == 0x6 for m in masks.values()),
              f"the servers were not started with SIGINT and SIGQUIT ignored: {masks}")
        rb, rs = tty_both(p, [], steps, timeout=45)
        note = same(p, rb, rs, "Ctrl-C and Ctrl-\\ at a terminal, both servers started with INT and QUIT ignored")
        check(b"i2n 130" in rb[1] and b"q2n 131" in rb[1], f"burrowd's session: {show(rb)}")
        (kb, nb), (ks, ns) = killed_by_int(p, p.burrowd.port), killed_by_int(p, p.sshd.port)
        check(nb == 1 and ns == 1, f"the command's process found: burrowd {nb}, sshd {ns}")
        note2 = same(p, kb, ks, "kill -INT to a command over ssh with no pty")
        got = p.burrowd.conn_lines()
        check(any(" signal INT" in x for x in got), f"burrowd's log has no signal INT: {got[-2:]}")
        return f"masks {masks['burrowd']:#x} and {masks['sshd']:#x}; {note}, $? 130 then 131; kill -INT: {note2}"


@row
def session_tty_burst():
    """20000 lines printed just before the program ends all arrive."""
    with tty_pair("session-tty-burst") as p:
        rb, rs = p.both(["-tt", "seq 1 20000; exit 0"], timeout=120)
        note = same(p, rb, rs, "seq 1 20000 on the pty")
        check(rb[1] == b"".join(b"%d\r\n" % i for i in range(1, 20001)), f"burrowd's lines: {rb[1][-40:]!r}")
        return note


@row
def session_tty_eof():
    """The client's stdin a pipe that ends: nothing reaches the pty, so
    `cat` never ends (both clients killed at 10 s); a 0x04 byte before the
    end is the terminal's end of file."""
    notes = []
    with tty_pair("session-tty-eof") as p:
        for inp, timeout in ((b"one\n", 10), (b"one\n\x04", 20)):
            rb, rs = p.both(["-tt", "cat; echo cat-ended"], inp=inp, timeout=timeout)
            notes.append(same(p, rb, rs, f"cat on the pty, input {inp!r}"))
        return "; ".join(notes)


@row
def auth_no_pty():
    """Who may have a pty (sshd(8) AUTHORIZED_KEYS FILE FORMAT): no-pty and
    restrict refuse it (under -tt the client gives up: 255), restrict,pty
    grants it, and pty,restrict as sshd reads it."""
    notes, bad = [], []
    for opts in ("no-pty", "restrict", "restrict,pty", "pty,restrict"):
        with tty_pair(f"auth-no-pty-{opts.replace(',', '-')}", install=False) as p:
            serverlib.install_keys([f"{opts} " + pathlib.Path(str(p.key) + ".pub").read_text()])
            rb, rs = p.both(["-tt", "tty; exit 0"])
            # Every case is taken before the row fails, so each is named.
            try:
                notes.append(f"{opts}: " + same(p, pts(rb), pts(rs), f"a key with {opts}, ssh -tt host tty"))
            except Fail as e:
                bad.append(f"{opts}: {e}")
    check(not bad, "; ".join(bad))
    return "; ".join(notes)


@row
def session_own_session():
    """Each program leads a session of its own (px112's left half): the
    shell is its session's leader; with no pty it has no terminal and
    /dev/tty does not open; on a pty the pty is its terminal."""
    script = ('set -- $(cat /proc/self/stat); echo "sid_is_shell=$([ "$6" = "$$" ] && echo yes || echo no) '
              'tty=$([ "$7" = 0 ] && echo none || echo some)"; (exec 3</dev/tty) 2>/dev/null && echo tty-opens || echo no-tty')
    notes = []
    with tty_pair("session-own-session") as p:
        for args in (["-T"], ["-tt"]):
            rb, rs = p.both(args + [script])
            notes.append(same(p, rb, rs, f"ssh {args[0]} host: the program's session"))
        return "; ".join(notes)


