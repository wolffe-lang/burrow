        kh = known(d, s)
        p = subprocess.Popen([str(BIN), "-F", "none"] + common(s, kh, d / "id_user") + ["127.0.0.1", "head -c 5"],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=envfor(d))
        p.stdin.write(b"0123456789")
        p.stdin.flush()
        try:
            p.wait(timeout=30)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
            raise Fail("burrow did not exit after the command ended with its stdin still open")
        out, err = p.stdout.read(), p.stderr.read()
        p.stdin.close()
    check(p.returncode == 0 and out == b"01234", f"exit {p.returncode} stdout {out!r} {tail(err)}")


