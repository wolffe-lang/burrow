def session_server(d, extra=()):
    return Server(d, ["AcceptEnv GIT_PROTOCOL FOO"] + list(extra))


@row
def session_cat_64m():
    """64 MiB of random bytes through `cat`, against the input and ssh's output;
    burrow's memory stays flat (at most 128 MiB of RSS)."""
    d = run_dir("session-cat-64m")
    data = os.urandom(64 << 20)
    src = d / "in.bin"
    src.write_bytes(data)
    want = hashlib.sha256(data).hexdigest()
    del data
    with session_server(d) as s:
        kh = known(d, s)
        out = {}
        for who, argv in (("burrow", [str(BIN), "-F", "none"]), ("ssh", [SSH, "-F", "none", "-o", "BatchMode=yes"])):
            with open(src, "rb") as fi, open(d / f"out-{who}.bin", "wb") as fo:
                t0 = time.monotonic()
                p = subprocess.Popen(argv + common(s, kh, d / "id_user") + ["127.0.0.1", "cat"], stdin=fi, stdout=fo,
                                     stderr=subprocess.DEVNULL, env=envfor(d))
                # The process's own high-water mark, sampled: wait4's
                # ru_maxrss carries the forking parent's.
                hwm = 0
                while p.poll() is None:
                    try:
                        st = pathlib.Path(f"/proc/{p.pid}/status").read_text()
                        hwm = max(hwm, int(re.search(r"VmHWM:\s+(\d+)", st)[1]))
                    except (OSError, TypeError):
                        pass
                    time.sleep(0.02)
                out[who] = (p.returncode, time.monotonic() - t0, hwm, 0.0, b"")
    hb = hashlib.sha256((d / "out-burrow.bin").read_bytes()).hexdigest()
    hs = hashlib.sha256((d / "out-ssh.bin").read_bytes()).hexdigest()
    for f in ("in.bin", "out-burrow.bin", "out-ssh.bin"):
        (d / f).unlink()
    b, o = out["burrow"], out["ssh"]
    note = (f"burrow exit {b[0]} {b[1]:.2f}s peak RSS {b[2]} KiB; "
            f"ssh exit {o[0]} {o[1]:.2f}s peak RSS {o[2]} KiB")
    compare(d, note + f"\ninput sha256 {want}\nburrow {hb}\nssh {hs}\n")
    check(b[0] == 0, f"burrow exit {b[0]}: {tail(b[4])}")
    check(hb == want, f"burrow's output sha256 {hb}, the input's {want}")
    check(hs == want, f"ssh's output sha256 {hs}")
    check(b[2] <= 131072, f"burrow's max RSS {b[2]} KiB, over 128 MiB")
    return note


