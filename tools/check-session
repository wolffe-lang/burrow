# ---- keystroke timing (B8, U11): ssh_config(5) ObscureKeystrokeTiming --------------------------------------
# Measured black box first (the pinned ssh through a timestamping relay, ten keys at fixed irregular gaps, five runs
# of each setting): by default ssh sends one packet every 20 ms from the first key on, a key's or, with none to
# send, a PING of the same size on the wire (36 bytes), and goes on for 1.3 to 3.1 s after the last key; with
# `interval:80` the same every 80 ms; with `no` it sends each key at once and nothing after the last. These rows
# hold only what a host's speed cannot move: counts of packets in windows a tenth of a second and more wide, over a
# stated number of runs each, never a gap's length. They are timing rows all the same: the default suite leaves
# them out, and `--timing` runs them alone, on a host with quiet cores.
TIMING_ROWS = []
KS_RUNS = 3
KS_GAPS_MS = [0, 37, 113, 61, 250, 89, 17, 340, 45, 160]


def timing_row(fn):
    TIMING_ROWS.append(fn)
    return fn


class Relay:
    """127.0.0.1 between a client and the row's sshd: every chunk the client writes, timestamped (monotonic)."""

    def __init__(self, up):
        import socket
        import threading
        self.up = up
        self.ls = socket.socket()
        self.ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.ls.bind(("127.0.0.1", 0))
        self.ls.listen(1)
        self.port = self.ls.getsockname()[1]
        self.c2s = []
        self.t = threading.Thread(target=self.run, daemon=True)
        self.t.start()

    def run(self):
        import socket
        c, _ = self.ls.accept()
        s = socket.create_connection(("127.0.0.1", self.up))
        for x in (c, s):
            x.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        live = True
        while live:
            for x in select.select([c, s], [], [], 1.0)[0]:
                d = x.recv(65536)
                if not d:
                    live = False
                    break
                if x is c:
                    self.c2s.append(time.monotonic())
                    s.sendall(d)
                else:
                    c.sendall(d)
        c.close()
        s.close()


KS_CACHE = {}


def keystrokes(setting):
    """KS_RUNS runs of each client with `setting` ("default", "no"): for each run, (exit, packets while typing,
    packets from the last key + 0.1 s to the session's end - 0.5 s, the last of those after the last key)."""
    if setting in KS_CACHE:
        return KS_CACHE[setting]
    d = run_dir(f"keystroke-{setting}")
    got = {"ssh": [], "burrow": []}
    with Server(d) as s:
        for run in range(KS_RUNS):
            for who in ("ssh", "burrow"):
                relay = Relay(s.port)
                line = s.known_hosts_line()
                kh = d / f"known_hosts-{who}-{run}"
                kh.write_text(line.replace(f"]:{s.port} ", f"]:{relay.port} ", 1))
                opts = [] if setting == "default" else ["-o", f"ObscureKeystrokeTiming={setting}"]
                args = opts + ["-p", str(relay.port), "-o", f"UserKnownHostsFile={kh}", "-i", str(d / "id_user"),
                               "-l", USER, "-t", "127.0.0.1", "echo ready; sleep 5"]
                argv = ([str(BIN), "-F", "none"] if who == "burrow" else
                        [SSH, "-F", "none", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes"]) + args
                keys = []

                def typing(master, slave):
                    for gap, k in zip(KS_GAPS_MS, b"abcdefghij"):
                        time.sleep(gap / 1000)
                        os.write(master, bytes([k]))
                        keys.append(time.monotonic())

                rc, t, _, _ = term_client(argv, envfor(d, {"TERM": "xterm", "SHELL": "/bin/sh"}),
                                          steps=[(b"ready", typing)], timeout=30)
                relay.t.join(5)
                c2s = relay.c2s
                if not keys or not c2s:
                    got[who].append((rc, 0, 0, 0.0))
                    continue
                first, last, end = keys[0], keys[-1], c2s[-1]
                during = [x for x in c2s if first <= x <= last]
                after = [x for x in c2s if last + 0.1 < x < end - 0.5]
                got[who].append((rc, len(during), len(after), round(after[-1] - last, 3) if after else 0.0))
    compare(d, "".join(f"{who} run {i}: exit {r[0]}, {r[1]} packets while typing, {r[2]} after the last key, "
                       f"the last at +{r[3]} s\n" for who in got for i, r in enumerate(got[who])))
    KS_CACHE[setting] = got
    return got


@timing_row
def keystroke_grid():
    """By default a packet every 20 ms while typing: ten keys over 1.1 s go as far more than ten packets."""
    got = keystrokes("default")
    for who in ("ssh", "burrow"):
        for i, (rc, during, _, _) in enumerate(got[who]):
            h = "harness: " if who == "ssh" else ""
            check(rc == 0 and during >= 30, f"{h}{who} run {i}: exit {rc}, {during} packets while typing (30 or more wanted)")
    return f"{KS_RUNS} runs each; while typing ssh {[r[1] for r in got['ssh']]}, burrow {[r[1] for r in got['burrow']]}"


@timing_row
def keystroke_chaff():
    """By default packets go on after the last key: ten or more from a tenth of a second after it, the last half a
    second or more after it. The margins: burrow draws its span from 1 to 3 s and sends its last PING on the last
    tick before the span ends, so at the draw's lower edge the last packet is 0.98 s after the last key at the
    earliest (one 20 ms tick short of 1 s): 0.48 s over this bound, with about 44 packets from 0.1 s on against the
    10 wanted. The pinned ssh measured 1.3 to 3.1 s and 58 to 146 packets."""
    got = keystrokes("default")
    for who in ("ssh", "burrow"):
        for i, (rc, _, after, lastat) in enumerate(got[who]):
            h = "harness: " if who == "ssh" else ""
            check(rc == 0 and after >= 10 and lastat >= 0.5,
                  f"{h}{who} run {i}: exit {rc}, {after} packets after the last key, the last at +{lastat} s")
    return f"{KS_RUNS} runs each; after the last key ssh {[r[2] for r in got['ssh']]}, burrow {[r[2] for r in got['burrow']]}"


@timing_row
def keystroke_off():
    """`ObscureKeystrokeTiming no`: each key at once, nothing after the last."""
    got = keystrokes("no")
    for who in ("ssh", "burrow"):
        for i, (rc, during, after, _) in enumerate(got[who]):
            h = "harness: " if who == "ssh" else ""
            check(rc == 0 and during >= 1 and after == 0,
                  f"{h}{who} run {i}: exit {rc}, {during} packets while typing, {after} after the last key (none wanted)")
    return f"{KS_RUNS} runs each; none after the last key"


def keep_evidence(tier):
    out = ROOT / "target" / "evidence" / f"session-{tier}"
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    kept = 0
    for d in sorted(p for p in WORK.iterdir() if p.is_dir()):
        for rel in ("sshd/sshd.log", "compare.txt"):
            src = d / rel
            if src.is_file():
                dst = out / d.name / src.name
                dst.parent.mkdir(exist_ok=True)
                shutil.copyfile(src, dst)
                kept += 1
    bad = []
    for p in [out.parent, out] + sorted(out.rglob("*")):
        os.chmod(p, 0o755 if p.is_dir() else 0o644)
        if p.is_file():
            if p.name.startswith(("host_", "id_", "other", "enc", "rsa")) or p.suffix == ".pub":
                bad.append(f"{p.relative_to(ROOT)} is a key file")
            elif b"PRIVATE KEY" in p.read_bytes() or b"b3BlbnNzaC1rZXktdjE" in p.read_bytes():
                bad.append(f"{p.relative_to(ROOT)} holds private key text")
    for why in bad:
        print(f"FAIL evidence {why}", flush=True)
    if not bad:
        print(f"check-session: {kept} evidence files in {out.relative_to(ROOT)}, readable, no key material")
    return len(bad)


def main():
    global BIN, KEYGEN_BIN
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", required=True)
    ap.add_argument("--only", nargs="*")
    ap.add_argument("--timing", action="store_true", help="run the keystroke timing rows, and only those")
    a = ap.parse_args()
    BIN = pathlib.Path(a.bin).resolve()
    KEYGEN_BIN = BIN.parent / "burrow-keygen"
    for b in (BIN, KEYGEN_BIN):
        if not b.exists():
            print(f"FAIL setup no binary at {b}")
            sys.exit(1)
    oraclelib.require_oracle()
    os.umask(0o022)
    WORK.mkdir(parents=True, exist_ok=True)
    os.chmod(WORK, 0o711)
    fails = 0
    ran = 0
    for fn in (TIMING_ROWS if a.timing else ROWS):
        name = fn.__name__.replace("_", "-")
        if a.only and name not in a.only:
            continue
        ran += 1
        try:
            note = fn()
            print(f"PASS {name}" + (f" ({note})" if note else ""), flush=True)
        except Fail as e:
            fails += 1
            print(f"FAIL {name} {e}", flush=True)
        except Exception as e:  # a harness fault is a red row too, by name
            fails += 1
            print(f"FAIL {name} harness: {type(e).__name__}: {e}", flush=True)
    print(f"check-session: {ran} rows, {fails} failed, 0 SKIP")
    # The timing rows keep their evidence apart, so a run of them never replaces the suite's.
    fails += keep_evidence(("timing-" if a.timing else "") + BIN.parent.name)
    sys.exit(min(fails, 100))


if __name__ == "__main__":
    main()
