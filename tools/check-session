@row
def shell_greeting():
    """GitHub's shape: after the login the server writes a greeting to
    stderr and exits 1, while the client's stdin is still open."""
    d = run_dir("shell-greeting")
    greet = "Hi row! You have authenticated, but this server provides no shell."
    with Server(d, [f"ForceCommand echo '{greet}' >&2; exit 1"]) as s:
        kh = known(d, s)
        got = {}
        for who, argv in (("burrow", [str(BIN), "-F", "none"]), ("ssh", [SSH, "-F", "none", "-o", "BatchMode=yes"])):
            p = subprocess.Popen(argv + ["-T"] + common(s, kh, d / "id_user") + ["127.0.0.1"], stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=envfor(d))
            try:
                p.wait(timeout=60)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
                raise Fail(f"{who} did not exit after the server's greeting, its stdin still open")
            out, err = p.stdout.read(), p.stderr.read()
            p.stdin.close()
            got[who] = (p.returncode, out, err)
        log = s.log_text()
    held_alike(d, got["burrow"], got["ssh"], "a greeting on stderr, exit 1, stdin left open")
    check(got["ssh"] == (1, b"", (greet + "\n").encode()), f"the pinned ssh: {got['ssh']!r}")
    shell, ptyreq = shell_log(log)
    check(shell and not ptyreq, f"sshd's log: shell request {shell}, pty-req {ptyreq}")
    return f"exit 1, {greet!r} on stderr, both clients"


