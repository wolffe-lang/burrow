# ---- a terminal (B8): burrow and the pinned ssh at a terminal of the row's own -------------------
# Each client is started as a terminal emulator starts a program: the session leader of a fresh pty,
# the pty its controlling terminal and its stdin, stdout and stderr (stdin a pipe where a row says).
# Everything it writes, and everything the remote side's pty echoes, is one transcript read from the
# master. A row's interrupts and escapes are bytes written into that master, never a signal sent by
# the row; a window change is the row setting the pty's size, as a terminal does, and the kernel
# telling the foreground group. The pty's own settings are read before the client starts and after
# it ends, so a row can hold the client to leaving the terminal as it found it.
# ssh writes its closing line after the terminal is back in its own mode, where the line discipline
# writes the line's LF as CR LF: "closed.\r\r\n" (after `~.`, still raw: "closed.\r\n").
CLOSED = re.compile(rb"Connection to 127\.0\.0\.1 closed\.\r*\n")


def set_winsize(fd, rows, cols):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def odd_modes(fd):
    """The terminal set as a client's might be: intr ^G, erase ^H, no IXON."""
    a = termios.tcgetattr(fd)
    a[6][termios.VINTR] = b"\x07"
    a[6][termios.VERASE] = b"\x08"
    a[0] &= ~termios.IXON
    termios.tcsetattr(fd, termios.TCSANOW, a)


def _ctty():
    # In the child, after start_new_session's setsid: the pty (on fd 1) becomes the controlling terminal.
    fcntl.ioctl(1, termios.TIOCSCTTY, 0)


def term_client(argv, env, steps=(), rows=24, cols=80, modes=None, stdin_data=None, timeout=30):
    """(exit, transcript, settings before, settings after). `steps` are (marker, action): once
    `marker` shows in the transcript after the previous step's, action(master, slave) runs."""
    master, slave = pty.openpty()
    set_winsize(slave, rows, cols)
    if modes:
        modes(slave)
    before = termios.tcgetattr(slave)
    stdin = slave if stdin_data is None else subprocess.PIPE
    proc = subprocess.Popen(argv, stdin=stdin, stdout=slave, stderr=slave, env=env, start_new_session=True,
                            preexec_fn=_ctty)
    if stdin_data is not None:
        proc.stdin.write(stdin_data)
        proc.stdin.close()
    got, seen, i = b"", 0, 0
    deadline = time.monotonic() + timeout
    try:
        while time.monotonic() < deadline:
            if select.select([master], [], [], 0.05)[0]:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    data = b""
                got += data
            if i < len(steps):
                k = got.find(steps[i][0], seen)
                if k >= 0:
                    seen = k + len(steps[i][0])
                    steps[i][1](master, slave)
                    i += 1
            if proc.poll() is not None:
                end = time.monotonic() + 0.5
                while time.monotonic() < end and select.select([master], [], [], 0.1)[0]:
                    try:
                        got += os.read(master, 65536)
                    except OSError:
                        break
                break
        else:
            proc.kill()
            proc.wait()
            got += b"\n[row: timed out]"
        after = termios.tcgetattr(slave)
    finally:
        os.close(master)
        os.close(slave)
    return proc.returncode, got, before, after


def type_(data, pause=0.2):
    def act(master, slave):
        time.sleep(pause)
        os.write(master, data)
    return act


def resize(rows, cols, then=b""):
    def act(master, slave):
        time.sleep(0.2)
        set_winsize(slave, rows, cols)
        time.sleep(0.3)
        if then:
            os.write(master, then)
    return act


def term_argv(who, s, kh, d, args):
    if who == "burrow":
        return [str(BIN), "-F", "none"] + common(s, kh, d / "id_user") + args
    return [SSH, "-F", "none", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes"] + common(s, kh, d / "id_user") + args


def tnorm(b, keep_closed=False):
    b = re.sub(rb"/dev/pts/\d+", b"/dev/pts/N", b)
    # A login shell's banner names the previous login, which for burrow's run is ssh's.
    b = re.sub(rb"Last login: [^\r\n]*", b"Last login: (the previous one)", b)
    return b if keep_closed else CLOSED.sub(b"", b)


def term_both(d, s, args, **kw):
    """The same terminal session through the pinned ssh, then burrow: {who: (exit, transcript, before, after)}."""
    kh = known(d, s, kw.pop("known_text", None))
    env = envfor(d, {"TERM": kw.pop("term", "xterm"), "SHELL": "/bin/sh"})
    return {who: term_client(term_argv(who, s, kh, d, args), env, **kw) for who in ("ssh", "burrow")}


def term_same(d, got, what, keep_closed=False):
    """burrow's exit and transcript are ssh's (pts numbers written N; ssh's closing line left out unless kept)."""
    (rs, ts, _, _), (rb, tb, _, _) = got["ssh"], got["burrow"]
    ts, tb = tnorm(ts, keep_closed), tnorm(tb, keep_closed)
    compare(d, f"{what}\nssh    exit {rs}\n{ts!r}\nburrow exit {rb}\n{tb!r}\n")
    check(rb == rs and tb == ts, f"burrow exit {rb}, transcript {tb[-300:]!r}; ssh exit {rs}, transcript {ts[-300:]!r}")
    return ts


