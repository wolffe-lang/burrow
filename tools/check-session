        rs = ssh(d, args)
    compare(d, f"burrow {rb[0]} {rb[1]!r}\nssh {rs[0]} {rs[1]!r}\n")
    check(rb[0] == rs[0] and rb[1] == rs[1], f"burrow {rb[0]} {rb[1]!r} {tail(rb[2])}; ssh {rs[0]} {rs[1]!r}")
    return f"-l wins for both: exit {rs[0]}, {rs[1].decode().strip()}"


# ---- a shell with no pty (-T, no command) -------------------------------------------
# RFC 4254 §6.5's `shell` request, never `pty-req`; ssh(1): with no command
# the server starts the login shell, a pty only when the client has one.
def shell_log(log):
    """Whether sshd's log shows a shell request, and whether a pty-req."""
    return bool(re.search(r"req(uest)? shell", log)), "pty-req" in log


def held_alike(d, rb, rs, what):
    compare(d, f"{what}\nburrow exit {rb[0]} stdout {rb[1]!r} stderr {rb[2]!r}\nssh exit {rs[0]} stdout {rs[1]!r} stderr {rs[2]!r}\n")
    check(rb[:3] == rs[:3], f"burrow exit {rb[0]} {rb[1]!r} {rb[2]!r}; ssh exit {rs[0]} {rs[1]!r} {rs[2]!r}")


def on_pty(argv, typed, env, timeout=60):
    """argv with stdin a pty's slave (not its controlling terminal) and
    `typed` written into the master; returns (exit, stdout, stderr)."""
    master, slave = pty.openpty()
    try:
        p = subprocess.Popen(argv, stdin=slave, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    finally:
        os.close(slave)
    try:
        if typed:
            os.write(master, typed)
        try:
            out, err = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            out, err = p.communicate()
            raise Fail(f"{argv[0]} did not finish within {timeout}s on a terminal; stderr {tail(err)}")
    finally:
        os.close(master)
    return p.returncode, out, err


