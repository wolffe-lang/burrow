               f"\nssh exit {rs[0]} stdout {rs[1]!r}\nssh stderr:\n{rs[2].decode('utf-8', 'replace')}"
               f"\nuser file after: {kh.read_text()!r}\n")
    check(rs[0] == 0 and rs[1] == b"ran", f"the pinned ssh: exit {rs[0]} {rs[1]!r} {tail(rs[2])}")
