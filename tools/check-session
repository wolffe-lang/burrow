def as_ssh(d):
    """burrow under the name `ssh`, as den finds it on PATH."""
    b = d / "bin"
    b.mkdir(exist_ok=True)
    link = b / "ssh"
    if not link.exists():
        link.symlink_to(BIN)
    return link


def den_argv(s, dest, cmd):
    a = []
    for o in ("BatchMode=yes", "StrictHostKeyChecking=yes", "UpdateHostKeys=no", "ControlMaster=no",
              "ControlPath=none", "ClearAllForwardings=yes", "ConnectTimeout=30", "SendEnv=GIT_PROTOCOL"):
        a += ["-o", o]
    return a + ["-p", str(s.port), "--", dest] + cmd


