    r = subprocess.run([SSH, "-G", "-F", "none", "127.0.0.1"], capture_output=True, timeout=60)
    got = [x for x in lines(r.stdout) if x.startswith("globalknownhostsfile ")]
    return got[0] if got else f"ssh -G exit {r.returncode}"


