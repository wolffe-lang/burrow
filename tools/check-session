@row
def kh_changed_offending():
    """Which line the changed-key banner names (`Offending ED25519 key in FILE:LINE`), held to the pinned ssh: the
    last line read that holds another key for the host, the user's file read before the system's. Two other keys
    in the user's file (lines 2 and 4), then the same with another in the system file's line 2."""
    d = run_dir("kh-changed-offending")
    with Server(d) as s:
        def unrelated(n):
            keypair(d / f"unrelated{n}")
            algo, blob = (d / f"unrelated{n}.pub").read_text().split()[:2]
            return f"[127.0.0.9]:22 {algo} {blob}\n"
        a, b, c = other_line(d, s), other_line_named(d, s, "other2"), other_line_named(d, s, "other3")
        kh = known(d, s, unrelated(1) + a + unrelated(2) + b)
        args = common(s, kh, d / "id_user") + ["-o", PAGE_DEFAULT, "127.0.0.1", "true"]
        rb = burrow(d, args)
        rs = ssh(d, args)
        refused(rb, "host_key_changed")
        user = same_banner(rb, rs, d, "two other keys in the user's file, lines 2 and 4")
        with SystemFile(SYSTEM_KH[0], unrelated(3) + c):
            rb = burrow(d, args)
            rs = ssh(d, args)
        refused(rb, "host_key_changed")
        both = same_banner(rb, rs, d, "and another in the system file's line 2")
    check(user.endswith(f"{kh}:4") and both.endswith(f"{SYSTEM_KH[0]}:2"), f"ssh named {user!r}, then {both!r}")
    return f"{user.split(' in ')[-1].split('/')[-1]}, then {both.split(' in ')[-1]}"


