    check(b"intr = ^G" in ts and b"-ixon" in ts, f"harness: ssh's transcript {ts!r}")
    return "stty -a as through ssh"


def pty_req_of(f):
    got = [e for e in f.record["events"] if e[0] == "pty-req"]
    if not got:
        return None
    _, term, cols, rows, wpx, hpx, modes = got[0]
    pairs, i = [], 0
    while i < len(modes) and modes[i] != 0:
        op = modes[i]
        if op >= 160:
            break
        pairs.append((op, struct.unpack(">I", modes[i + 1:i + 5])[0]))
        i += 5
    return term, cols, rows, wpx, hpx, pairs


@row
def pty_req_bytes():
    """The pty-req a scripted server records, from the same terminal: TERM, the sizes, the modes."""
    import fakeserver
    d = run_dir("pty-req-bytes")
    out = {}
    for who in ("ssh", "burrow"):
        with fakeserver.FakeServer(lambda f, w: f.finish(w, 0)) as f:
            kh = d / f"known_hosts-{who}"
            kh.write_text(f.host_line())
            keypair(d / f"id_{who}")
            args = ["-p", str(f.port), "-o", f"UserKnownHostsFile={kh}", "-i", str(d / f"id_{who}"), "-l", USER,
                    "-t", "127.0.0.1", "true"]
            argv = ([str(BIN), "-F", "none"] if who == "burrow" else
                    [SSH, "-F", "none", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes"]) + args
            rc, t, _, _ = term_client(argv, envfor(d, {"TERM": "xterm-256color", "SHELL": "/bin/sh"}), rows=33, cols=97,
                                      modes=odd_modes)
        out[who] = (rc, t, pty_req_of(f), f.record["error"])
    compare(d, "".join(f"{who}: exit {r[0]} pty-req {r[2]} error {r[3]} transcript {r[1][-200:]!r}\n" for who, r in out.items()))
    check(out["ssh"][2] is not None, f"harness: the pinned ssh sent no pty-req to the scripted server: {out['ssh']}")
    check(out["burrow"][2] is not None, f"burrow sent no pty-req: exit {out['burrow'][0]}, {out['burrow'][1][-200:]!r}")
    s_, b_ = out["ssh"][2], out["burrow"][2]
    check(b_[:5] == s_[:5], f"TERM and sizes: burrow {b_[:5]}, ssh {s_[:5]}")
