#!/bin/sh
# Adapted from wolffe-lang/scent eb888dfc tools/build (aspen 476edee3's); own code.
# build — compile burrow and burrow-keygen on one tier or both (lope's tools/build shape).
#
# The program is `src/burrow.lu` (marked `//! member: false`) over the
# modules under `src/`, with the manifest `src/wolf.pkg` beside it.
#   tools/build [--native|--release|--all|--static]
#   --native   the fast default backend  -> target/native/burrow
#   --release  LLVM with the mid-end on  -> target/release/burrow
#   --all      both (the default)
#   --static   the release tier linked with `cc -static` (linux)
#                                        -> target/static/burrow
#              the shape PAX runs (pax's tools/mkpelt, lope's
#              tools/mkstatic): wolf has no `--static`, so a `cc` that
#              adds the flag is put first on PATH for the link. Build it
#              on a baseline x86-64 glibc (the CI runner's Ubuntu, an
#              the pinned Ubuntu container), never on a newer host glibc.
# Every build denies warnings.
set -eu
BURROW_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export BURROW_ROOT
cd "$BURROW_ROOT"
. tools/lib-toolchain.sh

tiers="native release"
case "${1:-}" in
--native) tiers=native ;;
--release) tiers=release ;;
--all | "") ;;
--static) tiers=static ;;
*)
    echo "build: unknown option $1" >&2
    exit 2
    ;;
esac

# Three programs: burrow (src/burrow.lu), burrow-keygen (src/keygen.lu) and
# burrowd (src/burrowd.lu, the server).
# On the native and release tiers, a row program as well, never installed,
# never built --static and never uploaded: target/<tier>/rows/kexprobe
# (src/kexprobe.lu), the transport with strict kex waived for the
# downgrade-caught row; burrow itself has no waiver on any tier. And
# target/<tier>/rows/burrowd-oneproc (src/oneproc.lu): burrowd in one root
# process per connection, R-bw04-2's (B), for tools/measure-server only.
# And target/<tier>/rows/mkpw (src/mkpw.lu): a password on standard input
# made into a `$7$` string, for the password rows' /etc/shadow lines (px112).
for tier in $tiers; do
    mkdir -p "target/$tier"
    if [ "$tier" != static ]; then
        mkdir -p "target/$tier/rows"
        if [ "$tier" = release ]; then
            "$WOLF" build --release --deny-warnings src/kexprobe.lu -o "target/$tier/rows/kexprobe"
            "$WOLF" build --release --deny-warnings src/oneproc.lu -o "target/$tier/rows/burrowd-oneproc"
            "$WOLF" build --release --deny-warnings src/mkpw.lu -o "target/$tier/rows/mkpw"
        else
            "$WOLF" build --deny-warnings src/kexprobe.lu -o "target/$tier/rows/kexprobe"
            "$WOLF" build --deny-warnings src/oneproc.lu -o "target/$tier/rows/burrowd-oneproc"
            "$WOLF" build --deny-warnings src/mkpw.lu -o "target/$tier/rows/mkpw"
        fi
    fi
    if [ "$tier" = static ]; then
        real=$(command -v cc)
        mkdir -p target/static/bin
        printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" >target/static/bin/cc
        chmod +x target/static/bin/cc
        PATH="$BURROW_ROOT/target/static/bin:$PATH" \
            "$WOLF" build --release --no-cache --deny-warnings src/burrow.lu -o target/static/burrow
        PATH="$BURROW_ROOT/target/static/bin:$PATH" \
            "$WOLF" build --release --no-cache --deny-warnings src/keygen.lu -o target/static/burrow-keygen
        PATH="$BURROW_ROOT/target/static/bin:$PATH" \
            "$WOLF" build --release --no-cache --deny-warnings src/burrowd.lu -o target/static/burrowd
    elif [ "$tier" = release ]; then
        "$WOLF" build --release --deny-warnings src/burrow.lu -o "target/$tier/burrow"
        "$WOLF" build --release --deny-warnings src/keygen.lu -o "target/$tier/burrow-keygen"
        "$WOLF" build --release --deny-warnings src/burrowd.lu -o "target/$tier/burrowd"
    else
        "$WOLF" build --deny-warnings src/burrow.lu -o "target/$tier/burrow"
        "$WOLF" build --deny-warnings src/keygen.lu -o "target/$tier/burrow-keygen"
        "$WOLF" build --deny-warnings src/burrowd.lu -o "target/$tier/burrowd"
    fi
    if [ "$tier" = static ]; then
        echo "build: target/$tier/burrow target/$tier/burrow-keygen target/$tier/burrowd"
    else
        echo "build: target/$tier/burrow target/$tier/burrow-keygen target/$tier/burrowd target/$tier/rows/kexprobe target/$tier/rows/burrowd-oneproc target/$tier/rows/mkpw"
    fi
done
